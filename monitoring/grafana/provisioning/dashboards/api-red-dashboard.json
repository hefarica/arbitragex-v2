{
  "uid": "arbx-api-red",
  "title": "ArbitrageX — API RED Metrics + Business Observability",
  "tags": ["arbitragex", "red", "api", "business", "observability"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "API Server — Request Rate",
      "type": "timeseries",
      "description": "HTTP requests per second to api-server (5m rate)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"api-server\"}[5m])",
          "legendFormat": "{{method}} {{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 3
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "title": "API Server — Error Rate (%)",
      "type": "timeseries",
      "description": "5xx errors as percentage of total requests",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"api-server\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"api-server\"}[5m]) * 100",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 3,
      "title": "API Server — Request Duration",
      "type": "timeseries",
      "description": "p50 / p95 / p99 request latency",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"api-server\"}[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"api-server\"}[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"api-server\"}[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "title": "Edge Proxy — Request Rate",
      "type": "timeseries",
      "description": "HTTP requests per second to edge proxy (5m rate)",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"edge\"}[5m])",
          "legendFormat": "{{method}} {{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 3
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "title": "Edge Proxy — Error Rate (%)",
      "type": "timeseries",
      "description": "5xx errors as percentage of total requests",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"edge\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"edge\"}[5m]) * 100",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 6,
      "title": "Edge Proxy — Request Duration",
      "type": "timeseries",
      "description": "p50 / p95 / p99 request latency",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"edge\"}[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"edge\"}[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"edge\"}[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "orange", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "description": "Active connections to PostgreSQL",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 8,
      "title": "Redis Operations/sec",
      "type": "timeseries",
      "description": "Redis commands processed per second",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[5m])",
          "legendFormat": "ops/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 3
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 9,
      "title": "Opportunities Detected",
      "type": "timeseries",
      "description": "Total arbitrage opportunities detected",
      "gridPos": { "x": 0, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "arbx_opportunities_detected_total",
          "legendFormat": "Opportunities",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "pointSize": 3,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 10,
      "title": "Executions Submitted",
      "type": "timeseries",
      "description": "Total executions submitted",
      "gridPos": { "x": 8, "y": 18, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "arbx_executions_submitted_total",
          "legendFormat": "Executions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "pointSize": 3,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 11,
      "title": "Kill-Switch State",
      "type": "stat",
      "description": "0 = disabled, 1 = armed",
      "gridPos": { "x": 16, "y": 18, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "arbx_killswitch_state",
          "legendFormat": "State",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 12,
      "title": "Paper Mode",
      "type": "stat",
      "description": "0 = off, 1 = on",
      "gridPos": { "x": 20, "y": 18, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        {
          "expr": "arbx_paper_mode",
          "legendFormat": "State",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
