{
  "uid": "arbx-rpc-failover",
  "title": "ArbitrageX — RPC failover pool",
  "tags": ["arbitragex", "rpc", "failover", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Healthy providers",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "count(arbx_rpc_provider_state == 0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Degraded providers",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "count(arbx_rpc_provider_state == 1) OR on() vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "Open (circuit tripped)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "count(arbx_rpc_provider_state == 2) OR on() vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "Failover events / 5m",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum(increase(arbx_rpc_pool_failovers_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "stat", "title": "Drift demotions / 5m",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum(increase(arbx_rpc_pool_drift_detected_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Provider state by provider (0=Healthy 1=Degraded 2=Open)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "arbx_rpc_provider_state", "legendFormat": "{{provider}} ({{kind}})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 2 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Provider latency p95 (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (provider, kind, le) (rate(arbx_rpc_provider_latency_ms_bucket[1m])))",
        "legendFormat": "{{provider}} ({{kind}})",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Errors / sec by cause",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{
        "expr": "sum by (provider, cause) (rate(arbx_rpc_provider_errors_total[1m]))",
        "legendFormat": "{{provider}}: {{cause}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Block height per provider (drift visualizer)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{
        "expr": "arbx_rpc_provider_block_height",
        "legendFormat": "{{provider}} ({{kind}})",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } }
    }
  ]
}
