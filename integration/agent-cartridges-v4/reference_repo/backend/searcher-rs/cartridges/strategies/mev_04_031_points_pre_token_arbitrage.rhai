fn init_strategy() {
    #{
        name: "Points/pre-token arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Observe-only until there is a deterministic redeemable claim or firm market.",
        category: "parity_redemption_engine",
        mev_id: "MEV-04-031",
        detector_id: "OBSERVE",
        execution_class: "OBSERVE_ONLY",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [10, 11],
        secondary_operators: [22],
        triggers: ["new_block"],
        required_bindings: [],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true }
        }
    }
}

fn evaluate_opportunity(pool_data) {
    // Manifest law (OBSERVE family): "No is_opportunity=true. Emit structured
    // evidence only until a lawful, deterministic, executable settlement path
    // and required public/authorized data are present."
    // points/pre-token value needs the issuer's future tokenomics — inherently non-deterministic; telemetry-only by manifest law.
    // This cartridge therefore NEVER fabricates a profit number; it reports
    // the real shape it was handed as structured evidence.
    let legs = 0;
    if pool_data.route != () { legs = pool_data.route.len(); }
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: "observe_only_structured_evidence",
        detector_id: "OBSERVE",
        mev_id: "MEV-04-031",
        evidence_route_legs: legs
    }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "OBSERVE",
        mev_id: "MEV-04-031"
    }
}

fn build_payload(opportunity) {
