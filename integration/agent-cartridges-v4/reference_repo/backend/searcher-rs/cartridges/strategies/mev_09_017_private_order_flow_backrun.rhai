// MEV-09-017 — Private-order-flow backrun
// Detector family: I_ORDERFLOW (AUTHORIZED_FLOW_ONLY)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave E (G09): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Only evaluate flows explicitly available to this searcher; price the authorized order/bundle against alternative settlement and costs. No inference of privileged/private data.
// Primary operators (evidence only, math-engine): [25, 27, 24]
// Secondary operators (evidence only): [11, 22, 23]
//
//   pool_data.intent — authorized intent/order feed (MEV-Share / MEV-Blocker
//   / OFA / private flow; no pipeline binding populates it today, so this
//   cartridge waits fail-honest with intent_feed_unavailable). Shape:
//   #{ intent_id, origin ("mev_share"|"mev_blocker"|"ofa"|"exclusive"|"private"),
//      authorized (bool — exclusive/private flows MUST be authorized),
//      sell_token, buy_token, amount_in (human, sell units),
//      min_out (human, buy units — the executable limit),
//      solver_out (incumbent solver fill, buy units), peer_solver_out,
//      bounty_bps (OFA bounty on surplus), share_bps (backrun user refund),
//      clob: #{ bid_px (buy per sell), bid_depth (sell units), fee_bps },
//      rfq: #{ out (firm buy units), fee_bps },
//      dutch: #{ start_px, end_px, start_ts, end_ts },
//      inventory: #{ cost_px, qty },
//      valid_to (unix sec), ts }
//   Batch variants read pool_data.intents (array of the same intent shape).
//   pool_data.route carries the executable AMM legs sell_token -> buy_token.
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Private-order-flow backrun",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Evaluate only explicitly authorized feed; never infer or scrape unavailable private flow.",
        category: "intents_solver_engine",
        mev_id: "MEV-09-017",
        detector_id: "I_ORDERFLOW",
        execution_class: "AUTHORIZED_FLOW_ONLY",
        min_legs: 2,
        max_legs: 12,
        primary_operators: [25, 27, 24],
        secondary_operators: [11, 22, 23],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// Gather exact per-leg state for the route (fail-honest R8). Reserves are
// oriented by token_in via the reserve's token0_addr; freshness is enforced
// against the head block by the caller-supplied max_lag (-1 disables).
fn route_state(route, max_lag) {
    if route == () { return #{ err: "missing_route" }; }
    let n = route.len();
    if n < 1 { return #{ err: "route_shape_out_of_bounds" }; }
    let rin = [];
    let rout = [];
    let fees = [];
    let head = get_block_number();
    for i in 0..n {
        let leg = route[i];
        let pool = leg.pool;
        if pool == () || pool == "" { return #{ err: "missing_pool_address" }; }
        let res = get_reserves(pool);
        if res == () { return #{ err: "missing_reserves" }; }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return #{ err: "missing_reserves" }; }
        let ri = r0;
        let ro = r1;
        if res.token0_addr != () && leg.token_in != () {
            if leg.token_in != res.token0_addr { ri = r1; ro = r0; }
        }
        rin.push(ri);
        rout.push(ro);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if max_lag >= 0 {
            if res.block == () { return #{ err: "dex_state_stale" }; }
            let lag = head - res.block;
            if lag < 0 || lag > max_lag { return #{ err: "dex_state_stale" }; }
        }
    }
    #{ err: "", n: n, rin: rin, rout: rout, fees: fees }
}

// Exact composition of x base units through the legs (out in base units).
fn route_out(x_base, rin, rout, fees) {
    let amt = x_base;
    for i in 0..rin.len() {
        amt = cpmm_out(amt, rin[i], rout[i], fees[i]);
    }
    amt
}

// Fee-adjusted marginal: out human per in human over the whole route.
fn route_marginal(rin, rout, fees, bu_in, bu_out) {
    let m = bu_in / bu_out;
    for i in 0..rin.len() {
        m = m * (rout[i] / rin[i]) * (1.0 - fees[i].to_float() / 10000.0);
    }
    m
}

// Post-intent state: apply the intent's own swap through the legs (exact
// CPMM transition — deterministic on documented inputs, never a guess).
fn post_state(amt, rin, rout, fees) {
    let rin2 = [];
    let rout2 = [];
    for i in 0..rin.len() {
        let out_i = cpmm_out(amt, rin[i], rout[i], fees[i]);
        rin2.push(rin[i] + amt);
        rout2.push(rout[i] - out_i);
        amt = out_i;
    }
    #{ rin: rin2, rout: rout2 }
}

// Reversed-route backrun Pi(b): spend b buy-token base units through the
// post-intent reversed legs (same per-leg fees), value the sell proceeds at
// the CURRENT marginal m (buy per sell human). Returns buy-token base units.
fn back_pi(b, m, bu_s, bu_b, rr_in, rr_out, fees) {
    let amt = b;
    for i in 0..rr_in.len() {
        amt = cpmm_out(amt, rr_in[i], rr_out[i], fees[fees.len() - 1 - i]);
    }
    (amt / bu_s) * m * bu_b - b
}

fn evaluate_opportunity(pool_data) {
    // -- Intent feed gate ------------------------------------------------------
    let it = pool_data.intent;
    if it == () { return no_opp("intent_feed_unavailable"); }
    if it.ts == () { return no_opp("intent_feed_invalid"); }
    if get_timestamp() - it.ts > 12 { return no_opp("intent_feed_stale"); }
    if it.sell_token == () || it.buy_token == () || it.sell_token == "" || it.buy_token == "" { return no_opp("intent_feed_invalid"); }
    if it.amount_in == () || it.amount_in <= 0.0 || it.min_out == () || it.min_out <= 0.0 { return no_opp("intent_feed_invalid"); }
    if it.valid_to != () && get_timestamp() > it.valid_to { return no_opp("intent_expired"); }

    // Authorized private flow only (I_ORDERFLOW law).
    if it.origin != "private" { return no_opp("flow_not_authorized"); }
    if it.authorized != true { return no_opp("flow_not_authorized"); }

    // -- Impacted route + exact post-intent transition -------------------------
    let st = route_state(pool_data.route, 2);
    if st.err != "" { return no_opp(st.err); }
    let n = st.n;
    let rin = st.rin;
    let rout = st.rout;
    let fees = st.fees;
    let tms = get_token_meta(it.sell_token);
    let tmb = get_token_meta(it.buy_token);
    if tms == () || tmb == () { return no_opp("missing_token_meta"); }
    let bu_s = math_pow(10.0, tms.decimals.to_float());
    let bu_b = math_pow(10.0, tmb.decimals.to_float());

    let ps = post_state(it.amount_in * bu_s, rin, rout, fees);
    // Reversed legs on the post-intent state: buy -> sell (reversion capture).
    let rr_in = [];
    let rr_out = [];
    for k in 0..n {
        let i = n - 1 - k;
        rr_in.push(ps.rout[i]);
        rr_out.push(ps.rin[i]);
    }
    let m = route_marginal(rin, rout, fees, bu_s, bu_b);

    // -- Size the backrun by golden section over the exact Pi(b) ---------------
    let gr = 0.6180339887498949;
    let a = bu_b * 0.01;
    let b_hi = math_max(bu_b * 1.0, rr_in[0] * 0.05);
    let c = b_hi - gr * (b_hi - a);
    let d = a + gr * (b_hi - a);
    let fc = back_pi(c, m, bu_s, bu_b, rr_in, rr_out, fees);
    let fd = back_pi(d, m, bu_s, bu_b, rr_in, rr_out, fees);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b_hi - a); fd = back_pi(d, m, bu_s, bu_b, rr_in, rr_out, fees); }
        else { b_hi = d; d = c; fd = fc; c = b_hi - gr * (b_hi - a); fc = back_pi(c, m, bu_s, bu_b, rr_in, rr_out, fees); }
    }
    let b_star = (a + b_hi) / 2.0;
    let profit_b = back_pi(b_star, m, bu_s, bu_b, rr_in, rr_out, fees) / bu_b;
    if profit_b <= 0.0 { return no_opp("backrun_no_edge"); }

    let px = get_token_price_usd(tmb.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 { profit_usd = profit_b * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_b, confidence: 0.65,
        urgency: "immediate", reason: "authorized_backrun_reversion_profit",
        detector_id: "I_ORDERFLOW", mev_id: "MEV-09-017",
        optimal_amount_in: b_star / bu_b, profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "I_ORDERFLOW",
        mev_id: "MEV-09-017"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-09-017",
        detector_id: "I_ORDERFLOW"
    }
}
