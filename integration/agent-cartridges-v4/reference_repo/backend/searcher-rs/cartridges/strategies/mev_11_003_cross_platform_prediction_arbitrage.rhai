// MEV-11-003 — Cross-platform prediction arbitrage
// Detector family: M_CROSS (EXTERNAL_DATA_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave E (G11): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Normalize markets only if they reference the same event, resolution source and payout semantics; then compute firm cross-venue spread after fees/capital lockup.
// Primary operators (evidence only, math-engine): [8, 11, 13]
// Secondary operators (evidence only): [14, 22, 23]
//
//   pool_data.prediction — prediction-market book feed (complete-set
//   mechanics, logical relations, prediction AMM; no pipeline binding
//   populates it today, so this cartridge waits fail-honest with
//   prediction_market_feed_unavailable). Shape when it lands:
//   #{ platform, event_ref, resolution_source, collateral_token,
//      fee_bps (taker), split_available, merge_available,
//      outcomes: [#{ id, bid_px, ask_px, depth }]   (collateral per share),
//      peer: #{ platform, event_ref, resolution_source, outcomes: [...] } (003),
//      mutually_exclusive, exhaustive (004),
//      conditions: [#{ id, outcomes: [#{id, bid_px, ask_px, depth}] }] (006),
//      parent: #{ id, bid_px, ask_px }, children: [#{id, bid_px, ask_px}] (007),
//      implies: [#{i, j}] (008),
//      amm: #{ pool, collateral_side (0|1), fee_bps, outcome_idx } (012),
//      ts (unix sec) }
//   All prices are in collateral-token human units per share (sum of a
//   complete set redeems for exactly 1 collateral unit).
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Cross-platform prediction arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "prediction_engine",
        mev_id: "MEV-11-003",
        detector_id: "M_CROSS",
        execution_class: "EXTERNAL_DATA_REQUIRED",
        min_legs: 2,
        max_legs: 12,
        primary_operators: [8, 11, 13],
        secondary_operators: [14, 22, 23],
        triggers: ["new_block"],
        required_bindings: ["get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}



fn evaluate_opportunity(pool_data) {
    // -- Prediction feed gate (RULE 00: no book, no trade) ----------------------
    let pm = pool_data.prediction;
    if pm == () { return no_opp("prediction_market_feed_unavailable"); }
    if pm.ts == () { return no_opp("prediction_feed_invalid"); }
    if get_timestamp() - pm.ts > 60 { return no_opp("prediction_feed_stale"); }
    let outs = pm.outcomes;
    if outs == () || outs.len() < 2 { return no_opp("no_outcome_book"); }
    let pe = pm.peer;
    if pe == () || pe.outcomes == () { return no_opp("peer_market_unavailable"); }

    // -- Canonical identity gates: only the SAME event (reference + resolution
    // source + payout semantics) may be normalized across venues.
    if pm.event_ref == () || pe.event_ref == () || pm.event_ref != pe.event_ref {
        return no_opp("event_identity_mismatch");
    }
    if pm.resolution_source == () || pe.resolution_source == () || pm.resolution_source != pe.resolution_source {
        return no_opp("resolution_source_mismatch");
    }
    let fee = if pm.fee_bps != () { pm.fee_bps.to_float() } else { 0.0 };
    let pe_fee = if pe.fee_bps != () { pe.fee_bps.to_float() } else { 0.0 };

    // Best firm spread per matched outcome, both directions.
    let best = 0.0;
    let best_id = "";
    for i in 0..outs.len() {
        let o = outs[i];
        if o.ask_px == () || o.ask_px <= 0.0 || o.bid_px == () || o.bid_px <= 0.0 { continue; }
        for j in 0..pe.outcomes.len() {
            let q = pe.outcomes[j];
            if q.ask_px == () || q.ask_px <= 0.0 || q.bid_px == () || q.bid_px <= 0.0 { continue; }
            if o.id != q.id { continue; }
            let depth = if o.depth != () && o.depth > 0.0 { o.depth } else { 1.0 };
            let d_ab = (q.bid_px * (1.0 - pe_fee / 10000.0) - o.ask_px * (1.0 + fee / 10000.0)) * depth;
            let d_ba = (o.bid_px * (1.0 - fee / 10000.0) - q.ask_px * (1.0 + pe_fee / 10000.0)) * depth;
            if d_ab > best { best = d_ab; best_id = o.id; }
            if d_ba > best { best = d_ba; best_id = o.id; }
        }
    }
    if best <= 0.0 { return no_opp("no_cross_platform_edge"); }
    let profit_c = best;
    // Collateral USD hint for the net gate precheck (fail-honest on miss).
    let tmc = get_token_meta(pm.collateral_token);
    if tmc == () { return no_opp("missing_collateral_meta"); }
    let px = get_token_price_usd(tmc.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 { profit_usd = profit_c * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_c, confidence: 0.6,
        urgency: "immediate", reason: "cross_platform_firm_spread_profit", detector_id: "M_CROSS",
        mev_id: "MEV-11-003", profit_usd_hint: profit_usd, matched_outcome: best_id }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "M_CROSS",
        mev_id: "MEV-11-003"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-11-003",
        detector_id: "M_CROSS"
    }
}
