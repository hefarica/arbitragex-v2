# ArbitrageX v2 — MCP server environment variables (TEMPLATE — placeholders only)
# ---------------------------------------------------------------------------
# Copy to `.env.mcp` and fill REAL values there. `.env.mcp` is gitignored and
# MUST NEVER be committed. This template carries variable NAMES only — no values.
#
# Doctrine: audit / scaffold / shadow / read-only.
#   - NO PRIVATE_KEY is ever populated (Foundry MCP runs sim/read-only).
#   - Postgres/Redis must point to READ-ONLY roles (SELECT-only / ACL +@read).
#   - GitHub token must be READ-ONLY (no write/admin scopes).
#   - RPC endpoints point to a local Anvil fork or a read-only node.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
# Filesystem MCP sandbox root. If unset, `.mcp.json` falls back to "." (repo root).
PROJECT_ROOT=

# Context7 docs MCP. NOTE: context7 is ALREADY available via the context7 plugin
# (Connected). This var is only needed if you run a standalone user-scope copy.
CONTEXT7_API_KEY=

# GitHub MCP — use a READ-ONLY fine-grained PAT (contents:read at most; NO write/admin).
GITHUB_TOKEN=

# --- Backend (READ-ONLY) -------------------------------------------------
# Postgres connection string for a SELECT-only role (e.g. arbx_ro).
DATABASE_URL_READONLY=

# Redis URL for an ACL user limited to +@read -@write.
REDIS_URL_READONLY=

# --- Frontend ------------------------------------------------------------
# 21st.dev Magic component-generator API key.
MAGIC_21ST_API_KEY=

# --- Blockchain (READ-ONLY / SIMULATION — NO signing) --------------------
# Foundry MCP RPC — point to a LOCAL Anvil fork. PRIVATE_KEY stays EMPTY in .mcp.json.
ANVIL_FORK_RPC_URL=

# EVM MCP RPC — a read-only node endpoint (viem multi-chain reads / eth_call only).
EVM_RPC_URL=
