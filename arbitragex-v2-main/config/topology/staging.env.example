# ArbitrageX V2 — staging.env.example
# Propósito: plantilla sin secretos para validar Topology Vault y hot-reload en staging.
# No pegar API keys reales en este archivo si se versiona.

ARBX_ENV=staging
ARBX_EXECUTION_ENABLED=false
ARBX_HOT_RELOAD_ENABLED=true
ARBX_TOPOLOGY_CHANNEL=arbx:topology:mutation
ARBX_TOPOLOGY_SNAPSHOT_URL=http://api-server:8080/admin/topology/snapshot
ARBX_TOPOLOGY_ACK_STREAM=arbx:topology:acks

# Mempool filtrado: requiere que el primer proveedor WS sea Alchemy.
ARBX_MEMPOOL_MODE=filtered
RPC_HTTP_1=alchemy=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME,drpc=https://ethereum.drpc.org,publicnode=https://ethereum-rpc.publicnode.com
RPC_WS_1=alchemy=wss://eth-mainnet.g.alchemy.com/v2/REPLACE_ME,publicnode=wss://ethereum-rpc.publicnode.com

# Redis interno de Docker Compose.
REDIS_URL=redis://redis:6379
REDIS_DB_DEFAULT=0
REDIS_DB_ADMIN=1

# Guardas de seguridad para E2E sin gasto real.
PAPER_MODE=true
WALLET_SIGNING_ENABLED=false
PRIVATE_KEY=
