{
  "uid": "arbx-detection",
  "title": "ArbitrageX — Detection pipeline",
  "tags": ["arbitragex", "detection", "searcher-rs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Pending txs seen / sec",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum(rate(arbx_searcher_pending_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "blue", "value": 0.1 }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Decoded / sec",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum(rate(arbx_searcher_decoded_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "Opportunities detected / sec",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum(rate(arbx_opportunity_total{status=\"detected\"}[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "green", "value": 0.01 }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "WS reconnects / hour",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum(rate(arbx_searcher_ws_reconnects_total[5m])) * 3600", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "/h", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 30 }] } } },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Mempool throughput — pending vs decoded vs opportunity",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [
        { "expr": "sum(rate(arbx_searcher_pending_total[1m]))",  "legendFormat": "pending",    "refId": "A" },
        { "expr": "sum(rate(arbx_searcher_decoded_total[1m]))",  "legendFormat": "decoded",    "refId": "B" },
        { "expr": "sum(rate(arbx_opportunity_total{status=\"detected\"}[1m]))", "legendFormat": "opportunities", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8 } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Decode failures by reason",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum by (reason) (rate(arbx_searcher_undecoded_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Dropped pending by reason",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum by (reason) (rate(arbx_searcher_dropped_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Opportunities by chain × strategy",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "arbx-prometheus" },
      "targets": [{ "expr": "sum by (chain_id, strategy_kind) (rate(arbx_opportunity_total{status=\"detected\"}[5m]))", "legendFormat": "chain {{chain_id}} · {{strategy_kind}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 } } }
    }
  ]
}
