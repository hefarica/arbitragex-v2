{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbitragex.v2/schemas/opportunity.schema.json",
  "title": "Opportunity",
  "description": "Canonical envelope for a detected arbitrage opportunity. Produced by searcher-rs; consumed by selector-api and sim-ctl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id","chain_id","strategy_kind","dex_a","pair_symbol",
    "token_in","token_out","amount_in_wei",
    "expected_profit_usd","detected_at","trace_id"
  ],
  "properties": {
    "id":                   { "type": "string", "format": "uuid" },
    "chain_id":             { "type": "integer", "minimum": 1 },
    "strategy_kind":        {
      "type": "string",
      "enum": ["dex_arb","triangular","backrun","liquidation","flashloan_arb"]
    },
    "dex_a":                { "type": "string", "minLength": 1 },
    "dex_b":                { "type": ["string","null"] },
    "pair_symbol":          { "type": "string", "minLength": 1 },
    "token_in":             { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "token_out":            { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "amount_in_wei":        { "type": "string", "pattern": "^[0-9]+$" },
    "expected_profit_usd":  { "type": "number" },
    "roi_pct":              { "type": ["number","null"] },
    "risk_score":           { "type": ["number","null"] },
    "block_number":         { "type": ["integer","null"], "minimum": 0 },
    "detected_at":          { "type": "string", "format": "date-time" },
    "trace_id":             { "type": "string", "format": "uuid" }
  }
}
