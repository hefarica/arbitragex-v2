# ─── ArbitrageX Frontend Environment ───
# Copy to `.env.local` for dev. NEXT_PUBLIC_* are baked at BUILD time (`next build`);
# changing them later requires a rebuild (see CLAUDE.md RULE 03). Never commit real
# secrets — the values below are placeholders only (RULE 00, Zero-Mocks/no-hardcode).

# ── Core (MANDATORY in production — next.config.js throws if these point at localhost) ──
# Edge server (REST). Browser → edge → api-server.
#   Dev:  http://localhost:8787      Prod: https://edge.your-domain.com
NEXT_PUBLIC_EDGE_URL=http://localhost:8787

# Edge URL used for server-side (SSR) fetches in the node/container runtime.
# Falls back to NEXT_PUBLIC_EDGE_URL when unset — usually an internal hostname.
#   Dev:  http://localhost:8787      Prod: http://edge:8787 (internal)
INTERNAL_EDGE_URL=http://localhost:8787

# ── WebSocket (live opportunity stream + runtime-ack) ──
# Socket.IO endpoint. Browser → api-server (direct) or edge WS proxy.
#   Dev:  http://localhost:3000      Prod: wss://ws.your-domain.com
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Optional explicit wss:// URL for the runtime-ack socket (useRuntimeAckSocket).
# Falls back to NEXT_PUBLIC_WS_URL when unset.
# NEXT_PUBLIC_WSS_URL=wss://ws.your-domain.com

# ── Admin auth ──
# Server-side admin token for SSR routes needing privileged reads (e.g. /audit-logs).
# Keep secret; inject via the environment, never commit a real value.
ARBX_ADMIN_TOKEN=

# Admin token exposed to the browser for the runtime-ack WS handshake. NEXT_PUBLIC_*
# is baked into the client bundle — only set this if your threat model allows it.
# NEXT_PUBLIC_ARBX_ADMIN_TOKEN=

# ── Wallet / web3 (read-only /wallet surface — no signer, no broadcast) ──
# WalletConnect (Reown) project id. Absent → WalletConnect degrades fail-honest
# ("walletconnect_project_id_missing"); injected/EIP-6963 wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Toggle the wallet-connect affordances. Default ON; "false"/"0"/"off" disables them.
# NEXT_PUBLIC_WALLET_CONNECT_ENABLED=true

# Supported EVM chains (comma-separated chain ids). Empty → full doctrinal set.
# NEXT_PUBLIC_SUPPORTED_CHAINS=1,42161,8453,10,137,56

# Default chain id selected on load. Empty → first supported chain.
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# ── Tests ──
# Base URL for Playwright e2e specs (e2e/*.spec.ts).
# E2E_BASE_URL=http://localhost:5173
