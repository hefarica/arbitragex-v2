+/* ── Enhanced nav item hover glow (sidebar navigation) ──────────────────── */
+.nav-glow {
+  transition: color 180ms, background-color 180ms, text-shadow 180ms;
+}
+.nav-glow:hover {
+  text-shadow: 0 0 14px color-mix(in oklab, var(--primary-2) 80%, transparent);
+}
+.nav-glow:hover .nav-icon {
+  text-shadow: 0 0 12px var(--primary);
+}
+
+/* ── Film grain overlay (premium texture, opt-in via class) ─────────────── */
+.grain,
+.grain-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 50;
+  pointer-events: none;
+  opacity: var(--grain-opacity, 0.26);
+  mix-blend-mode: overlay;
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.45'/></svg>");
+  transition: opacity 320ms var(--ease-expo);
+}
+.dark .grain,
+.dark .grain-overlay {
+  opacity: var(--grain-opacity, 0.5);
+}
+
+/* ── X-Ray card hover effect (opportunity cards) ────────────────────────── */
+.xray-panel {
+  position: absolute;
+  inset-inline: 0;
+  bottom: 0;
+  clip-path: inset(100% 0 0 0);
+  transition: clip-path 320ms var(--ease-sharp);
+}
+.group:hover .xray-panel,
+[data-hoverable]:hover .xray-panel {
+  clip-path: inset(0 0 0 0);
+}
+
+/* Fade content on hover to reveal x-ray */
+.xray-fade {
+  transition: opacity 320ms;
+}
+.group:hover .xray-fade,
+[data-hoverable]:hover .xray-fade {
+  opacity: 0.35;
+}
+
+/* ── Hairline shadow utility (mockup parity) ───────────────────────────── */
+.hairline-shadow {
+  box-shadow: var(--hairline, inset 0 1px 0 0 oklch(0.98 0.012 250 / 0.16)),
+    var(--shadow, 0 8px 30px -14px oklch(0.02 0.02 266 / 0.5));
+}
+
+/* ── Custom cursor (desktop only, accessibility guarded) ────────────────── */
+@media (pointer: fine) {
+  .custom-cursor {
+    cursor: none;
+  }
+}
+
+.cur-dot,
+.cur-ring {
+  position: fixed;
+  top: 0;
+  left: 0;
+  pointer-events: none;
+  z-index: 9999;
+  transform: translate(-50%, -50%);
+  border-radius: 50%;
+}
+
+.cur-dot {
+  width: 7px;
+  height: 7px;
+  background: var(--primary-2);
+  mix-blend-mode: screen;
+  transition: transform 140ms var(--ease-expo);
+}
+
+.cur-ring {
+  width: 38px;
+  height: 38px;
+  border: 1.5px solid var(--primary);
+  opacity: 0.7;
+  transition: width 220ms var(--ease-sharp), height 220ms var(--ease-sharp),
+    opacity 220ms;
+}
+
+body.is-interactive .cur-dot {
+  transform: translate(-50%, -50%) scale(2.5);
+  background: var(--primary);
+}
+
+body.is-interactive .cur-ring {
+  width: 56px;
+  height: 56px;
+  opacity: 0.35;
+}
+
+/* Disable custom cursor on touch devices and reduced motion */
+@media (pointer: coarse), (prefers-reduced-motion: reduce) {
+  .cur-dot,
+  .cur-ring {
+    display: none !important;
+  }
+}
+
+/* ── Live Ticker (mockup parity) ────────────────────────────────────────── */
+.arbx-ticker {
+  overflow: hidden;
+}
+.arbx-ticker:hover .arbx-ticker-track {
+  animation-play-state: paused;
+}
+
+@keyframes arbx-tick {
+  from { transform: translateX(0); }
+  to { transform: translateX(-50%); }
+}
+
+/* Ticker animation alias (mockup parity) */
+.ticker-track {
+  animation: tick 30s linear infinite;
+}
+
+/* ── Sphere Aura (mockup parity) ──────────────────────────────────────────
+   Radial glow behind the HeroSphere particle globe. */
+.sphere-aura {
+  position: absolute;
+  right: -120px;
+  top: -80px;
+  width: 540px;
+  height: 540px;
+  pointer-events: none;
+  z-index: 0;
+  background: radial-gradient(
+    circle at 60% 40%,
+    color-mix(in oklab, var(--primary) 22%, transparent),
+    transparent 65%
+  );
+  filter: blur(20px);
+}
+
+/* ── Character animation (hero text reveal) ─────────────────────────────── */
+.char {
+  display: inline-block;
+  opacity: 0;
+  transform: translateY(110%) rotateX(-90deg);
+  animation: charIn 520ms var(--ease-sharp) forwards;
+}
+
+.char-reveal {
+  display: inline-block;
+  opacity: 0;
+  transform: translateY(110%) rotateX(-90deg);
+  animation: charIn 520ms var(--ease-sharp) forwards;
+}
+
+@keyframes char-in {
+  to {
+    opacity: 1;
+    transform: translateY(0) rotateX(0);
+  }
+}
