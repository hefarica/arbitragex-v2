+function useCollapsedSections(): readonly [Set<NavItem["group"]>, (group: NavItem["group"]) => void] {
+  // SSR + first client paint default to ALL collapsed (operator requested the
+  // four titles render "contracted"). localStorage re-applies the saved set
+  // after mount — the initial server/first-paint state is identical on both
+  // sides, so there is no hydration mismatch (sidebar rule R1).
+  const [collapsed, setCollapsed] = useState<Set<NavItem["group"]>>(() => new Set(SECTION_GROUPS));
+
+  useEffect(() => {
+    try {
+      const stored = window.localStorage.getItem(SECTIONS_KEY);
+      if (!stored) return;
+      const parsed = JSON.parse(stored);
+      if (!Array.isArray(parsed)) return;
+      const valid = parsed.filter((g): g is NavItem["group"] =>
+        SECTION_GROUPS.includes(g as NavItem["group"]),
+      );
+      setCollapsed(new Set(valid));
+    } catch {
+      /* localStorage blocked / corrupt — keep default all-collapsed */
+    }
+  }, []);
+
+  const toggle = useCallback((group: NavItem["group"]) => {
+    setCollapsed((prev) => {
+      const next = new Set(prev);
+      if (next.has(group)) next.delete(group);
+      else next.add(group);
+      try {
+        window.localStorage.setItem(SECTIONS_KEY, JSON.stringify([...next]));
+      } catch {
+        /* non-fatal: preference lives in memory for the session */
+      }
+      return next;
+    });
+  }, []);
+
+  return [collapsed, toggle] as const;
+}
