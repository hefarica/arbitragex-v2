# ─── ArbitrageX Frontend Environment ───
# Both variables are MANDATORY in production builds (next.config.js will throw).
# In dev, they fall back to localhost defaults.

# Edge server (REST API). Browser → edge → api-server.
# Dev:  http://localhost:8787
# Prod: https://edge.your-domain.com
NEXT_PUBLIC_EDGE_URL=http://localhost:8787

# WebSocket server (Socket.IO). Browser → WS endpoint (api-server or edge WS proxy).
# Dev:  http://localhost:3000
# Prod: wss://ws.your-domain.com (must support ws/wss upgrade)
NEXT_PUBLIC_WS_URL=http://localhost:3000
