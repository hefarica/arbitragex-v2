{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM","DOM.Iterable","ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts","app/**/*.ts","app/**/*.tsx","lib/**/*.ts"],
  "exclude": ["node_modules",".next","dist"]
}
