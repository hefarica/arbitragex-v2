// MEV-04-015 — ETF-like token arbitrage
// Detector family: P_NAV (DETERMINISTIC_IF_REDEEMABLE)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave B: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   
//   NAV from exact redeemable components; Π=RedeemValue(token)-MarketCost(token)-unwind/fees, or inverse mint-and-sell path.
// Primary operators (evidence only, math-engine): [13, 19, 21]
// Secondary operators (evidence only): [8,11,22]
//
// Zero-Mocks / Fail-Honest: all state from CartridgeContextV3 route[] + host
// bindings. Missing reserves/decimals/prices => is_opportunity:false + reason.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below.

fn init_strategy() {
    #{
        name: "ETF-like token arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "parity_redemption_engine",
        mev_id: "MEV-04-015",
        detector_id: "P_NAV",
        execution_class: "DETERMINISTIC_IF_REDEEMABLE",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [13, 19, 21],
        secondary_operators: [8, 11, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_token_price_usd"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}
fn evaluate_opportunity(pool_data) {
    // -- Feed gate: the conversion/redemption source this detector needs. ------
    // Rides pool_data.issuer_nav; no pipeline binding populates it today, so the
    // cartridge waits fail-honest (RULE 00 / R8). Payload shape when it lands:
    //   #{ token, nav_rate (underlying per token, human), as_of_ts }
    let ev = pool_data.issuer_nav;
    if ev == () { return no_opp("issuer_nav_feed_unavailable"); }
    // -- Market leg + parity core (same engine as the live P_* family) -----
    let route = pool_data.route;
    if route == () { return no_opp("missing_route"); }
    let leg = route[0];
    let s_in = leg.token_in;
    let s_out = leg.token_out;
    let pool = leg.pool;
    if pool == () || pool == "" { return no_opp("missing_pool_address"); }
    if s_in == () || s_in == "" || s_out == () || s_out == "" { return no_opp("missing_market_pair"); }

    let tmi = get_token_meta(s_in);
    let tmo = get_token_meta(s_out);
    if tmi == () || tmo == () { return no_opp("missing_token_meta"); }

    // NAV rate straight from the protocol feed (base-unit scale applied below).
    let nav_rate = ev.nav_rate;
    if nav_rate == () || nav_rate <= 0.0 { return no_opp("issuer_nav_invalid"); }
    let o = nav_rate * math_pow(10.0, tmo.decimals.to_float() - tmi.decimals.to_float());
    if o <= 0.0 { return no_opp("issuer_nav_invalid"); }

    let res = get_reserves(pool);
    if res == () { return no_opp("missing_reserves"); }
    let r0 = res.r0.to_float();
    let r1 = res.r1.to_float();
    if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
    let ri = r0;
    let ro = r1;
    if res.token0_addr != () && s_in != res.token0_addr { ri = r1; ro = r0; }
    let fee = if leg.fee_bps != () { leg.fee_bps } else { 30 };
    let gamma = 1.0 - fee.to_float() / 10000.0;
    let m = gamma * (ro / ri);
    let edge = m / o - 1.0;
    if math_abs(edge) <= 0.003 { return no_opp("parity_within_band"); }

    let bu = math_pow(10.0, tmo.decimals.to_float());
    let dir = "pool_long_s_in";
    if edge < 0.0 { dir = "pool_short_s_in"; }
    let x_lo = bu * 0.01;
    let bound = 0.05 * ro;
    if edge > 0.0 { bound = 0.05 * ri * o; }
    let x_hi = math_max(bu * 1.0, bound);

    let gr = 0.6180339887498949;
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, o, ri, ro, fee, edge > 0.0);
    let fd = profit_at(d, o, ri, ro, fee, edge > 0.0);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = profit_at(d, o, ri, ro, fee, edge > 0.0); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = profit_at(c, o, ri, ro, fee, edge > 0.0); }
    }
    let x_star = (a + b) / 2.0;
    let profit_tok = profit_at(x_star, o, ri, ro, fee, edge > 0.0);

    if profit_tok <= 0.0 { return no_opp("parity_edge_below_fees"); }

    let profit_usd = 0.0;
    let px_out = get_token_price_usd(tmo.symbol);
    if px_out != () && px_out > 0.0 {
        profit_usd = (profit_tok / bu) * px_out;
    }
    if profit_usd > 0.0 && profit_usd < 10.0 { return no_opp("below_gas_threshold"); }

    #{
        is_opportunity: true,
        estimated_profit: profit_tok / bu,
        confidence: 0.65,
        urgency: "immediate",
        reason: "etf_nav_parity_profit",
        detector_id: "P_NAV",
        mev_id: "MEV-04-015",
        optimal_amount_in: x_star / bu,
        parity_edge: edge,
        parity_direction: dir,
        profit_usd_hint: profit_usd
    }
}

// Pi(x) in S_out units for the parity capture (direction per `long`).
fn profit_at(x, o, ri, ro, fee_bps, long) {
    if long {
        cpmm_out(x / o, ri, ro, fee_bps) - x
    } else {
        o * cpmm_out(x, ro, ri, fee_bps) - x
    }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "P_NAV",
        mev_id: "MEV-04-015"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-04-015",
        detector_id: "P_NAV"
    }
}
