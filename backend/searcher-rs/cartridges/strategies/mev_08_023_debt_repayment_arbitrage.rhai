// MEV-08-023 — Debt-repayment arbitrage
// Detector family: L_COLLATERAL (DETERMINISTIC_IF_REDEEMABLE)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave D (G08): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Value debt/collateral claims in common numeraire using protocol conversion/redemption, then compare executable acquisition/repayment paths net of costs.
// Primary operators (evidence only, math-engine): [13, 8, 21]
// Secondary operators (evidence only): [11, 22]
//
//   pool_data.claim — collateral/debt claim-token feed (no pipeline binding
//   populates it today => claim_feed_unavailable). Shape:
//   #{ claim_token, underlying_token, claim_amount (human),
//      claim_px_usd (firm market quote per claim), market_fee_bps,
//      underlying_price_usd, redemption_rate (underlying per claim),
//      face_rate (008 debt-token face), oracle_rate (022),
//      our_debt_amount (023), ts }
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Debt-repayment arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "credit_liquidation_engine",
        mev_id: "MEV-08-023",
        detector_id: "L_COLLATERAL",
        execution_class: "DETERMINISTIC_IF_REDEEMABLE",
        min_legs: 1,
        max_legs: 4,
        primary_operators: [13, 8, 21],
        secondary_operators: [11, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// exact-out inversion for one leg: the exact-in amount x required to receive
// y out: x = (r_in*y) / (gamma*(r_out - y))  (undefined if y >= r_out).
fn cpmm_in_for_out(y, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    if y >= r_out { return -1.0; }
    (r_in * y) / (gamma * (r_out - y))
}

// Gather exact per-leg state for the route (fail-honest R8). Reserves are
// oriented by token_in via the reserve's token0_addr; freshness is enforced
// against the head block by the caller-supplied max_lag (-1 disables).
fn route_state(route, max_lag) {
    if route == () { return #{ err: "missing_route" }; }
    let n = route.len();
    if n < 1 { return #{ err: "route_shape_out_of_bounds" }; }
    let rin = [];
    let rout = [];
    let fees = [];
    let head = get_block_number();
    for i in 0..n {
        let leg = route[i];
        let pool = leg.pool;
        if pool == () || pool == "" { return #{ err: "missing_pool_address" }; }
        let res = get_reserves(pool);
        if res == () { return #{ err: "missing_reserves" }; }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return #{ err: "missing_reserves" }; }
        let ri = r0;
        let ro = r1;
        if res.token0_addr != () && leg.token_in != () {
            if leg.token_in != res.token0_addr { ri = r1; ro = r0; }
        }
        rin.push(ri);
        rout.push(ro);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if max_lag >= 0 {
            if res.block == () { return #{ err: "dex_state_stale" }; }
            let lag = head - res.block;
            if lag < 0 || lag > max_lag { return #{ err: "dex_state_stale" }; }
        }
    }
    #{ err: "", n: n, rin: rin, rout: rout, fees: fees }
}

fn evaluate_opportunity(pool_data) {
    let cl = pool_data.claim;
    if cl == () { return no_opp("claim_feed_unavailable"); }
    if cl.ts == () { return no_opp("claim_feed_invalid"); }
    if get_timestamp() - cl.ts > 300 { return no_opp("claim_feed_stale"); }
    if cl.our_debt_amount == () || cl.our_debt_amount <= 0.0 { return no_opp("no_debt_position"); }
    if cl.face_rate == () || cl.face_rate <= 0.0 { return no_opp("face_rate_unavailable"); }
    if cl.underlying_token == () || cl.claim_token == () { return no_opp("claim_feed_invalid"); }

    // Exact-out acquisition: invert the route leg-by-leg to find the in-cost of
    // exactly our_debt_amount tokens, then extinguish at face.
    let st = route_state(pool_data.route, 2);
    if st.err != "" { return no_opp(st.err); }
    let n = st.n;
    let rin = st.rin;
    let rout = st.rout;
    let fees = st.fees;
    let tmu = get_token_meta(cl.underlying_token);
    let tmd = get_token_meta(cl.claim_token);
    if tmu == () || tmd == () { return no_opp("missing_token_meta"); }
    let bu_u = math_pow(10.0, tmu.decimals.to_float());
    let bu_d = math_pow(10.0, tmd.decimals.to_float());

    let target = cl.our_debt_amount * bu_d;
    if target >= rout[n - 1] * 0.5 { target = rout[n - 1] * 0.5; }
    let need = target;
    for k in 0..n {
        let i = n - 1 - k;
        need = cpmm_in_for_out(need, rin[i], rout[i], fees[i]);
        if need < 0.0 { return no_opp("dex_liquidity_insufficient"); }
    }
    let cost_u = need / bu_u;
    let face_value_u = (target / bu_d) * cl.face_rate;
    let profit_u = face_value_u - cost_u;
    if profit_u <= 0.0 { return no_opp("debt_not_below_face"); }

    let px = get_token_price_usd(tmu.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 { profit_usd = profit_u * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_u, confidence: 0.65,
        urgency: "immediate", reason: "discounted_debt_extinguish_profit",
        detector_id: "L_COLLATERAL", mev_id: "MEV-08-023",
        debt_qty: target / bu_d, profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "L_COLLATERAL",
        mev_id: "MEV-08-023"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-08-023",
        detector_id: "L_COLLATERAL"
    }
}
