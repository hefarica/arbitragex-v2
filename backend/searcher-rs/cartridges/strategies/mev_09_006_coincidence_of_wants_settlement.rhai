// MEV-09-006 — Coincidence-of-Wants settlement
// Detector family: I_BATCH (DETERMINISTIC_SETTLEMENT)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave E (G09): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Find feasible matching/clearing maximizing total surplus across orders plus external liquidity, subject to conservation and individual limit-price constraints.
// Primary operators (evidence only, math-engine): [19, 29, 24]
// Secondary operators (evidence only): [20, 27, 22]
//
//   pool_data.intent — authorized intent/order feed (MEV-Share / MEV-Blocker
//   / OFA / private flow; no pipeline binding populates it today, so this
//   cartridge waits fail-honest with intent_feed_unavailable). Shape:
//   #{ intent_id, origin ("mev_share"|"mev_blocker"|"ofa"|"exclusive"|"private"),
//      authorized (bool — exclusive/private flows MUST be authorized),
//      sell_token, buy_token, amount_in (human, sell units),
//      min_out (human, buy units — the executable limit),
//      solver_out (incumbent solver fill, buy units), peer_solver_out,
//      bounty_bps (OFA bounty on surplus), share_bps (backrun user refund),
//      clob: #{ bid_px (buy per sell), bid_depth (sell units), fee_bps },
//      rfq: #{ out (firm buy units), fee_bps },
//      dutch: #{ start_px, end_px, start_ts, end_ts },
//      inventory: #{ cost_px, qty },
//      valid_to (unix sec), ts }
//   Batch variants read pool_data.intents (array of the same intent shape).
//   pool_data.route carries the executable AMM legs sell_token -> buy_token.
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Coincidence-of-Wants settlement",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "intents_solver_engine",
        mev_id: "MEV-09-006",
        detector_id: "I_BATCH",
        execution_class: "DETERMINISTIC_SETTLEMENT",
        min_legs: 2,
        max_legs: 12,
        primary_operators: [19, 29, 24],
        secondary_operators: [20, 27, 22],
        triggers: ["new_block"],
        required_bindings: ["get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}



fn evaluate_opportunity(pool_data) {
    // -- Batch intent feed gate ------------------------------------------------
    let its = pool_data.intents;
    if its == () || its.len() < 2 { return no_opp("batch_feed_unavailable"); }
    let now = get_timestamp();
    for i in 0..its.len() {
        let x = its[i];
        if x.sell_token == () || x.buy_token == () || x.amount_in == () || x.min_out == () { return no_opp("intent_feed_invalid"); }
        if x.amount_in <= 0.0 || x.min_out <= 0.0 { return no_opp("intent_feed_invalid"); }
        if x.ts != () && now - x.ts > 12 { return no_opp("intent_feed_stale"); }
        if x.valid_to != () && now > x.valid_to { return no_opp("intent_expired"); }
    }

    if its.len() != 2 { return no_opp("no_coincidence"); }
    if its[0].sell_token != its[1].buy_token || its[0].buy_token != its[1].sell_token {
        return no_opp("no_coincidence");
    }

    // -- The single crossing pair -----------------------------------------------
    // The settlement fills each side AT its limit price; the crossing spread
    // accrues to the settlement. Tokens must be exact mirrors.
    let total_spread = 0.0;
    let val_token = its[0].buy_token;
    for i in 0..its.len() {
        for j in 0..its.len() {
            if i == j { continue; }
            let a = its[i];
            let b = its[j];
            if a.sell_token != b.buy_token || a.buy_token != b.sell_token { continue; }
            if a.buy_token != val_token { continue; }
            let p_a = a.min_out / a.amount_in;      // buy per sell (a)
            let p_b = b.min_out / b.amount_in;      // sell_token per buy (b)
            if p_a * p_b <= 1.0 { continue; }        // limits do not cross
            let q = math_min(a.amount_in, b.amount_in * p_b);
            total_spread = total_spread + (p_a - 1.0 / p_b) * q;
        }
    }
    if total_spread <= 0.0 { return no_opp("no_crossing_intents"); }

    let tmb = get_token_meta(val_token);
    if tmb == () { return no_opp("missing_token_meta"); }
    let profit_usd = 0.0;
    let px = get_token_price_usd(tmb.symbol);
    if px != () && px > 0.0 { profit_usd = total_spread * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: total_spread, confidence: 0.6,
        urgency: "immediate", reason: "coincidence_of_wants_spread",
        detector_id: "I_BATCH", mev_id: "MEV-09-006",
        profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "I_BATCH",
        mev_id: "MEV-09-006"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-09-006",
        detector_id: "I_BATCH"
    }
}
