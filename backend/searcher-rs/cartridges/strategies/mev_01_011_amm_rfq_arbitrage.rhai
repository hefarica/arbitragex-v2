// MEV-01-011 — AMM–RFQ arbitrage
// Detector family: R_ORDERBOOK (EXTERNAL_DATA_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave A: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Pi(q) = Proceeds_bid(q) - Cost_ask(q) - taker_fees(q) - settlement_cost(q)
//           - hedge_cost(q).  Prices must be VWAP/depth-aware, not top-of-book.
//   AMM–RFQ: the AMM legs are quoted exactly from live reserves (get_reserves)
//   -> Cost_ask side; the RFQ leg carries a FIRM quote as `leg.rfq` =
//   #{ price: <token_out per token_in>, max_in: <max token_in units the quote
//   fills> } -> Proceeds_bid(q), leg fee_bps as taker fee. The executable size
//   is capped where the AMM composition output reaches max_in (exact bisection
//   on the monotone quote curve), then golden-sectioned inside the cap.
//
// Zero-Mocks / Fail-Honest: no firm quote on the closing leg =>
// is_opportunity:false with reason "rfq_quote_unavailable" (the RFQ feed is
// not yet wired to the route pipeline — the math is live the moment it is).
// NEVER fabricated.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Fee default 0.30% = 30 bps -> gamma=0.997;
// coarse gas precheck GAS_HINT_USD=5.0; authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "AMM–RFQ arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "route_graph_engine",
        mev_id: "MEV-01-011",
        detector_id: "R_ORDERBOOK",
        execution_class: "EXTERNAL_DATA_REQUIRED",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [8, 10, 23, 11],
        secondary_operators: [13, 22, 16],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one AMM leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// Quote of the AMM sub-route (legs 0..n-2) at input size x, in RFQ-base units.
fn amm_legs_out(x, rin, rout, fees) {
    let amt = x;
    for i in 0..rin.len() {
        amt = cpmm_out(amt, rin[i], rout[i], fees[i]);
    }
    amt
}

fn evaluate_opportunity(pool_data) {
    let route = pool_data.route;
    if route == () { return no_opp("missing_route"); }
    let n = route.len();
    if n < 2 || n > 8 { return no_opp("route_shape_out_of_bounds"); }
    if pool_data.route_closed != true { return no_opp("route_not_closed"); }

    // -- Shape: legs 0..n-2 are AMM legs, the closing leg n-1 is the RFQ leg --
    let last = route[n - 1];
    let rfq = last.rfq;
    if rfq == () { return no_opp("rfq_quote_unavailable"); }
    let rfq_price = rfq.price;
    let rfq_max_in = rfq.max_in;
    if rfq_price == () || rfq_max_in == () || rfq_price <= 0.0 || rfq_max_in <= 0.0 {
        return no_opp("rfq_quote_invalid");
    }
    if last.token_out != route[0].token_in { return no_opp("route_not_closed"); }

    // -- Gather AMM leg state (fail-honest) --------------------------------------
    let m = n - 1;
    let rin = [];
    let rout = [];
    let fees = [];      // AMM leg fees
    let token_in0 = "";
    let dec0 = -1;
    for i in 0..m {
        let leg = route[i];
        let pool = leg.pool;
        if pool == () || pool == "" { return no_opp("missing_pool_address"); }
        let res = get_reserves(pool);
        if res == () { return no_opp("missing_reserves"); }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
        let ri = r0;
        let ro = r1;
        if res.token0_addr != () && leg.token_in != () {
            let t0 = res.token0_addr;
            if leg.token_in != t0 { ri = r1; ro = r0; }
        }
        rin.push(ri);
        rout.push(ro);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if i == 0 { token_in0 = leg.token_in; }
    }
    let rfq_fee = if last.fee_bps != () { last.fee_bps } else { 30 };

    // Decimals of the input token for a sane sizing bracket (fail-honest).
    let tm = get_token_meta(token_in0);
    if tm == () { return no_opp("missing_token_meta"); }
    dec0 = tm.decimals;
    let base_unit = math_pow(10.0, dec0.to_float());

    // -- Marginal prefilter: sum_e[-ln((1-fee_e)*rate_e)] + rfq leg < 0 ----------
    // AMM legs at spot + the firm RFQ price. If the fee-adjusted product <= 1
    // the cycle cannot pay at any size.
    let log_sum = 0.0;
    for i in 0..m {
        let rate = rout[i] / rin[i];
        let adj = (1.0 - fees[i].to_float() / 10000.0) * rate;
        if adj <= 0.0 { return no_opp("degenerate_rate"); }
        log_sum += -math_log(adj);
    }
    let rfq_adj = (1.0 - rfq_fee.to_float() / 10000.0) * rfq_price;
    if rfq_adj <= 0.0 { return no_opp("degenerate_rate"); }
    log_sum += -math_log(rfq_adj);
    if log_sum >= 0.0 { return no_opp("prefilter_non_positive"); }

    // -- Executable bracket: bisect where the AMM output reaches max_in --------
    // amm_legs_out is strictly increasing in x, so a bisection gives the exact
    // x_cap with amm_legs_out(x_cap) = max_in; larger sizes are NOT fillable by
    // the firm quote and are excluded from the search (RULE 00).
    let x_lo = base_unit * 0.01;
    let x_hi_raw = math_max(base_unit * 1.0, rin[0] * 0.05);
    let lo = x_lo;
    let hi = x_hi_raw;
    for _it in 0..48 {
        let mid = (lo + hi) / 2.0;
        if amm_legs_out(mid, rin, rout, fees) < rfq_max_in { lo = mid; } else { hi = mid; }
    }
    let x_cap = lo;
    if x_cap <= x_lo { return no_opp("rfq_size_exceeded"); }
    let x_hi = math_min(x_hi_raw, x_cap * 0.999999);

    // -- Compose Pi(q) and maximise via golden-section ---------------------------
    let gr = 0.6180339887498949;  // golden ratio conjugate (phi-1)
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, rin, rout, fees, rfq_price, rfq_max_in, rfq_fee);
    let fd = profit_at(d, rin, rout, fees, rfq_price, rfq_max_in, rfq_fee);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = profit_at(d, rin, rout, fees, rfq_price, rfq_max_in, rfq_fee); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = profit_at(c, rin, rout, fees, rfq_price, rfq_max_in, rfq_fee); }
    }
    let x_star = (a + b) / 2.0;
    let profit_tok = profit_at(x_star, rin, rout, fees, rfq_price, rfq_max_in, rfq_fee);

    if profit_tok <= -1.0e29 { return no_opp("rfq_size_exceeded"); }
    if profit_tok <= 0.0 { return no_opp("impact_zero"); }

    // Gross profit hint in USD for the net gate precheck (fail-honest on price).
    let px = get_token_price_usd(token_in0);
    let profit_usd = 0.0;
    if px != () && px > 0.0 {
        profit_usd = (profit_tok / base_unit) * px;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    // Optional operator evidence (confidence modulation only; never required,
    // never fabricated).
    let conf = 0.7;  // full on-chain data + firm quote present
    let ev = get_math_evidence("MEV-01-011");
    if ev != () && ev.confidence != () {
        conf = math_max(0.0, math_min(1.0, (conf + ev.confidence) / 2.0));
    }

    #{
        is_opportunity: true,
        estimated_profit: profit_tok / base_unit,   // gross, input token units
        confidence: conf,
        urgency: "immediate",
        reason: "amm_rfq_firm_quote_profit",
        detector_id: "R_ORDERBOOK",
        mev_id: "MEV-01-011",
        optimal_amount_in: x_star / base_unit,
        legs: n,
        profit_usd_hint: profit_usd
    }
}

// Pi(q) in input-token units: exact AMM composition to the RFQ base, then the
// firm quote Proceeds_bid (only fillable up to max_in; beyond => -1e30
// sentinel so the search stays inside the executable region).
fn profit_at(x, rin, rout, fees, rfq_price, rfq_max_in, rfq_fee) {
    let amt = amm_legs_out(x, rin, rout, fees);
    if amt > rfq_max_in { return -1.0e30; }
    let gamma = (10000.0 - rfq_fee.to_float()) / 10000.0;
    amt * rfq_price * gamma - x
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "R_ORDERBOOK",
        mev_id: "MEV-01-011"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-01-011",
        detector_id: "R_ORDERBOOK"
    }
}
