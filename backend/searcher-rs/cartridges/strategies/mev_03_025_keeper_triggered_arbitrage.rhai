// MEV-03-025 — Keeper-triggered arbitrage
// Detector family: E_AUCTION (DETERMINISTIC_AUCTION)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave B: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   
//   Π(q,t)=FairExecutableValue(q)-AuctionPurchaseCost(q,t)-UnwindCost(q)-Gas; solve feasible q and timing under auction rules.
// Primary operators (evidence only, math-engine): [19, 21, 23, 24]
// Secondary operators (evidence only): [8,22]
//
// Zero-Mocks / Fail-Honest: all state from CartridgeContextV3 route[] + host
// bindings. Missing reserves/decimals/prices => is_opportunity:false + reason.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below.

fn init_strategy() {
    #{
        name: "Keeper-triggered arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "state_event_engine",
        mev_id: "MEV-03-025",
        detector_id: "E_AUCTION",
        execution_class: "DETERMINISTIC_AUCTION",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [19, 21, 23, 24],
        secondary_operators: [8, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_token_price_usd", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}
fn evaluate_opportunity(pool_data) {
    // -- Auction state gate (manifest: "Auction price/curve; remaining lot; ---
    // deadline; collateral/external value; unwind liquidity"). Rides
    // pool_data.auction — no pipeline binding populates it today, so the
    // cartridge waits fail-honest (RULE 00 / R8). Payload shape when it lands:
    //   #{ venue, collateral_token, pay_token, lot_qty (human), price_now
    //       (pay per collateral, human), deadline_ts, unwinder_pool,
    //       unwind_fee_bps (optional) }
    let a = pool_data.auction;
    if a == () { return no_opp("auction_state_unavailable"); }
    let coll = a.collateral_token;
    let pay = a.pay_token;
    if coll == () || coll == "" || pay == () || pay == "" { return no_opp("auction_state_invalid"); }
    let lot = a.lot_qty;
    let price_now = a.price_now;
    if lot == () || lot <= 0.0 || price_now == () || price_now <= 0.0 {
        return no_opp("auction_state_invalid");
    }
    let deadline = a.deadline_ts;
    if deadline == () { return no_opp("auction_state_invalid"); }
    if get_timestamp() >= deadline { return no_opp("auction_deadline_passed"); }
    let upool = a.unwinder_pool;
    if upool == () || upool == "" { return no_opp("unwinder_pool_missing"); }

    // -- Fair executable value: collateral priced in pay-token units via the ---
    // searcher's live price oracle (symbol-keyed; fail-honest on miss).
    let tmc = get_token_meta(coll);
    let tmp = get_token_meta(pay);
    if tmc == () || tmp == () { return no_opp("missing_token_meta"); }
    let pxc = get_token_price_usd(tmc.symbol);
    let pxp = get_token_price_usd(tmp.symbol);
    if pxc == () || pxp == () || pxc <= 0.0 || pxp <= 0.0 { return no_opp("fair_value_source_unavailable"); }
    let fair = pxc / pxp;               // pay per collateral (human)
    if fair <= price_now { return no_opp("auction_above_fair_value"); }

    // -- Unwind liquidity: sell the purchased collateral into the unwinder -----
    // pool (exact CPMM quote; reserves oriented with collateral as token_in).
    let res = get_reserves(upool);
    if res == () { return no_opp("missing_reserves"); }
    let r0 = res.r0.to_float();
    let r1 = res.r1.to_float();
    if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
    let ri = r0;
    let ro = r1;
    if res.token0_addr != () && coll != res.token0_addr { ri = r1; ro = r0; }
    let fee = if a.unwind_fee_bps != () { a.unwind_fee_bps } else { 30 };

    let bu_c = math_pow(10.0, tmc.decimals.to_float());
    let bu_p = math_pow(10.0, tmp.decimals.to_float());

    // Pi(q) = unwinder proceeds(q, pay human) - auction cost price_now*q,
    // q in collateral human units, bounded by the remaining lot and depth.
    let q_lo = 0.01;
    let q_hi = math_min(lot, 0.5 * ro / bu_c);
    if q_hi <= q_lo { return no_opp("auction_liquidity_insufficient"); }

    let gr = 0.6180339887498949;
    let a2 = q_lo;
    let b2 = q_hi;
    let c2 = b2 - gr * (b2 - a2);
    let d2 = a2 + gr * (b2 - a2);
    let fc = profit_at(c2, ri, ro, fee, price_now, bu_c, bu_p);
    let fd = profit_at(d2, ri, ro, fee, price_now, bu_c, bu_p);
    for _it in 0..40 {
        if fc < fd { a2 = c2; c2 = d2; fc = fd; d2 = a2 + gr * (b2 - a2); fd = profit_at(d2, ri, ro, fee, price_now, bu_c, bu_p); }
        else        { b2 = d2; d2 = c2; fd = fc; c2 = b2 - gr * (b2 - a2); fc = profit_at(c2, ri, ro, fee, price_now, bu_c, bu_p); }
    }
    let q_star = (a2 + b2) / 2.0;
    let profit_pay = profit_at(q_star, ri, ro, fee, price_now, bu_c, bu_p);
    if profit_pay <= 0.0 { return no_opp("impact_zero"); }

    let profit_usd = profit_pay * pxp;
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{
        is_opportunity: true,
        estimated_profit: profit_pay,       // gross, pay-token human units
        confidence: 0.65,
        urgency: "immediate",
        reason: "auction_clearing_profit",
        detector_id: "E_AUCTION",
        mev_id: "MEV-03-025",
        optimal_amount_in: q_star,          // collateral human units
        auction_discount: fair - price_now,
        profit_usd_hint: profit_usd
    }
}

// Pi(q): unwinder proceeds (pay human) minus the auction purchase cost.
fn profit_at(q, ri, ro, fee_bps, price_now, bu_c, bu_p) {
    let proceeds = cpmm_out(q * bu_c, ri, ro, fee_bps) / bu_p;
    proceeds - price_now * q
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "E_AUCTION",
        mev_id: "MEV-03-025"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-03-025",
        detector_id: "E_AUCTION"
    }
}
