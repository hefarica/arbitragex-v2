// MEV-08-011 — Leverage-loop arbitrage
// Detector family: L_LOOP (DETERMINISTIC_POSITION_STRATEGY)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave D (G08): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Optimize leverage n / LTV to maximize net APY or finite-horizon P&L subject to health-factor/risk buffer and borrow/supply rate feedback.
// Primary operators (evidence only, math-engine): [17, 20, 21]
// Secondary operators (evidence only): [13, 16, 22]
//
//   pool_data.lending — money-market rate feed (no pipeline binding populates
//   it today => lending_feed_unavailable). Shape when it lands:
//   #{ protocol, borrow_rate_annual, supply_rate_annual, utilization,
//      collateral_factor, liquidation_threshold, reserve_factor_bps,
//      protocol_fee_bps, flash_fee_bps, principal_usd, horizon_sec,
//      cost_of_capital_annual (002), fixed_rate_annual (004),
//      delegation_rate_annual (010), settlement_window_sec (009),
//      accrual_period_sec, index_update_ts (025),
//      peer: #{ protocol, borrow_rate_annual, supply_rate_annual } (003/005),
//      loop_fee_bps (011), ts }
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Leverage-loop arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "credit_liquidation_engine",
        mev_id: "MEV-08-011",
        detector_id: "L_LOOP",
        execution_class: "DETERMINISTIC_POSITION_STRATEGY",
        min_legs: 1,
        max_legs: 4,
        primary_operators: [17, 20, 21],
        secondary_operators: [13, 16, 22],
        triggers: ["new_block"],
        required_bindings: ["get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}



fn evaluate_opportunity(pool_data) {
    let ld = pool_data.lending;
    if ld == () { return no_opp("lending_feed_unavailable"); }
    if ld.ts == () { return no_opp("lending_feed_invalid"); }
    if get_timestamp() - ld.ts > 300 { return no_opp("lending_feed_stale"); }
    if ld.borrow_rate_annual == () || ld.supply_rate_annual == () { return no_opp("lending_feed_invalid"); }
    if ld.collateral_factor == () || ld.collateral_factor <= 0.0 || ld.collateral_factor >= 1.0 { return no_opp("degenerate_collateral_factor"); }
    if ld.liquidation_threshold == () { return no_opp("lending_feed_invalid"); }
    if ld.horizon_sec == () || ld.horizon_sec <= 0.0 { return no_opp("horizon_unspecified"); }
    if ld.principal_usd == () || ld.principal_usd <= 0.0 { return no_opp("principal_unspecified"); }

    let c = ld.collateral_factor;
    let lt = ld.liquidation_threshold;
    let loop_fee = (if ld.loop_fee_bps != () { ld.loop_fee_bps.to_float() } else { 0.0 }) / 10000.0;
    let gas_per_loop_usd = 5.0;   // coarse precheck, authoritative gate downstream
    let max_loops = 5;
    let hf_buffer = 1.1;

    // After n loops: V_n = P*(1-c^(n+1))/(1-c); debt L_n = V_n - P.
    // Carry = V_n*r_s - L_n*r_b (annual); costs = n*(gas + P*c*loop_fee).
    let best_n = 0;
    let best_pi = -1.0e18;
    for n in 1..(max_loops + 1) {
        let v_n = ld.principal_usd * (1.0 - math_pow(c, n.to_float() + 1.0)) / (1.0 - c);
        let l_n = v_n - ld.principal_usd;
        let hf_n = (v_n * lt) / l_n;
        if hf_n < hf_buffer { break; }
        let carry = v_n * ld.supply_rate_annual - l_n * ld.borrow_rate_annual;
        let pi = carry * (ld.horizon_sec / 31536000.0) - n.to_float() * (gas_per_loop_usd + ld.principal_usd * c * loop_fee);
        if pi > best_pi { best_pi = pi; best_n = n; }
    }
    if best_n == 0 { return no_opp("loop_hf_buffer_binding"); }
    if best_pi <= 0.0 { return no_opp("loop_carry_negative"); }

    #{ is_opportunity: true, estimated_profit: best_pi, confidence: 0.6,
        urgency: "monitor", reason: "leverage_loop_carry_profit",
        detector_id: "L_LOOP", mev_id: "MEV-08-011",
        optimal_loops: best_n, profit_usd_hint: best_pi }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "L_LOOP",
        mev_id: "MEV-08-011"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-08-011",
        detector_id: "L_LOOP"
    }
}
