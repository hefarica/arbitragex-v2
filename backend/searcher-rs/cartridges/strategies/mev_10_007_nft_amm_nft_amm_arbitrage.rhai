    #{
        name: "NFT AMMâ€“NFT AMM arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "nft_engine",
        mev_id: "MEV-10-007",
        detector_id: "N_AMM",
        execution_class: "DETERMINISTIC_IF_FIRM_EXIT",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [21, 15, 8],
        secondary_operators: [10, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// exact-out inversion for one leg: the exact-in amount x required to receive
// y out: x = (r_in*y) / (gamma*(r_out - y))  (undefined if y >= r_out).
fn cpmm_in_for_out(y, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    if y >= r_out { return -1.0; }
    (r_in * y) / (gamma * (r_out - y))
}

fn evaluate_opportunity(pool_data) {
    // -- NFT feed gate (RULE 00: floor signals are never profit) ----------------
    let nft = pool_data.nft;
    if nft == () { return no_opp("nft_floor_feed_unavailable"); }
    if nft.ts == () { return no_opp("nft_feed_invalid"); }
    if get_timestamp() - nft.ts > 300 { return no_opp("nft_feed_stale"); }
    let am_a = nft.amm;
    let am_b = nft.amm_b;
    if am_a == () || am_a.pool == () || am_b == () || am_b.pool == () { return no_opp("nft_amm_unavailable"); }

    let ra = get_reserves(am_a.pool);
    let rb = get_reserves(am_b.pool);
    if ra == () || rb == () { return no_opp("nft_amm_unavailable"); }
    let fa = if am_a.fee_bps != () { am_a.fee_bps } else { 30 };
    let fb = if am_b.fee_bps != () { am_b.fee_bps } else { 30 };
    let a_nft = ra.r1.to_float(); let a_den = ra.r0.to_float();
    if am_a.nft_side == 0 { a_nft = ra.r0.to_float(); a_den = ra.r1.to_float(); }
    let b_nft = rb.r1.to_float(); let b_den = rb.r0.to_float();
    if am_b.nft_side == 0 { b_nft = rb.r0.to_float(); b_den = rb.r1.to_float(); }
    if a_nft <= 0.0 || a_den <= 0.0 || b_nft <= 0.0 || b_den <= 0.0 { return no_opp("nft_amm_unavailable"); }

    let tmd = get_token_meta(nft.denom_token);
    if tmd == () { return no_opp("missing_denom_meta"); }
    let bu = math_pow(10.0, tmd.decimals.to_float());
    let qty = 1.0;

    // Both directions: buy A sell B, buy B sell A — exact curve math only.
    let cost_ab = cpmm_in_for_out(qty, a_den, a_nft, fa);
    let out_ab = cpmm_out(qty, b_nft, b_den, fb);
    let cost_ba = cpmm_in_for_out(qty, b_den, b_nft, fb);
    let out_ba = cpmm_out(qty, a_nft, a_den, fa);
    let pi_ab = -2.0e18;
    let pi_ba = -2.0e18;
    if cost_ab >= 0.0 { pi_ab = out_ab / bu - cost_ab / bu; }
    if cost_ba >= 0.0 { pi_ba = out_ba / bu - cost_ba / bu; }
    let profit_d = math_max(pi_ab, pi_ba);
    if profit_d <= 0.0 { return no_opp("amm_curve_no_edge"); }
    // Denom USD hint for the net gate precheck (fail-honest on price miss).
    let tmd = get_token_meta(nft.denom_token);
    if tmd == () { return no_opp("missing_denom_meta"); }
    let px = get_token_price_usd(tmd.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 { profit_usd = profit_d * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_d, confidence: 0.6,
        urgency: "immediate", reason: "nft_amm_curve_pair_profit", detector_id: "N_AMM",
        mev_id: "MEV-10-007", profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "N_AMM",
        mev_id: "MEV-10-007"
    }
}

