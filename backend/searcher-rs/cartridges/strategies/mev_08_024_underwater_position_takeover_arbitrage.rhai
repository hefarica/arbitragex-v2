// MEV-08-024 — Underwater-position takeover arbitrage
// Detector family: L_LIQ (DETERMINISTIC_LIQUIDATION)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave D (G08): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Eligibility via protocol health metric (Aave: HF=(collateral value×weighted liquidation threshold)/borrow value; liquidation when HF<1). Π=seized collateral executable value-debt repaid-gas-flash/unwind costs.
// Primary operators (evidence only, math-engine): [21, 8, 26, 16]
// Secondary operators (evidence only): [11, 13, 22, 23]
//
//   pool_data.position — live lending-position snapshot (the health-factor
//   feed; no pipeline binding populates it today, so this cartridge waits
//   fail-honest with health_factor_unavailable). Shape when it lands:
//   #{ protocol, account, chain_id,
//      collateral_token, collateral_amount (human), collateral_price_usd,
//      debt_token, debt_amount (human), debt_price_usd,
//      liquidation_threshold (e.g. 0.85), liquidation_bonus (e.g. 0.05),
//      close_factor (fraction of debt closable per tx), flash_fee_bps,
//      borrow_rate_annual, supply_rate_annual, collateral_factor (loop),
//      prev_health_factor, oracle_ts (backrun), ts (unix sec) }
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Underwater-position takeover arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "credit_liquidation_engine",
        mev_id: "MEV-08-024",
        detector_id: "L_LIQ",
        execution_class: "DETERMINISTIC_LIQUIDATION",
        min_legs: 1,
        max_legs: 4,
        primary_operators: [21, 8, 26, 16],
        secondary_operators: [11, 13, 22, 23],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// Gather exact per-leg state for the route (fail-honest R8). Reserves are
// oriented by token_in via the reserve's token0_addr; freshness is enforced
// against the head block by the caller-supplied max_lag (-1 disables).
fn route_state(route, max_lag) {
    if route == () { return #{ err: "missing_route" }; }
    let n = route.len();
    if n < 1 { return #{ err: "route_shape_out_of_bounds" }; }
    let rin = [];
    let rout = [];
    let fees = [];
    let head = get_block_number();
    for i in 0..n {
        let leg = route[i];
        let pool = leg.pool;
        if pool == () || pool == "" { return #{ err: "missing_pool_address" }; }
        let res = get_reserves(pool);
        if res == () { return #{ err: "missing_reserves" }; }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return #{ err: "missing_reserves" }; }
        let ri = r0;
        let ro = r1;
        if res.token0_addr != () && leg.token_in != () {
            if leg.token_in != res.token0_addr { ri = r1; ro = r0; }
        }
        rin.push(ri);
        rout.push(ro);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if max_lag >= 0 {
            if res.block == () { return #{ err: "dex_state_stale" }; }
            let lag = head - res.block;
            if lag < 0 || lag > max_lag { return #{ err: "dex_state_stale" }; }
        }
    }
    #{ err: "", n: n, rin: rin, rout: rout, fees: fees }
}

fn evaluate_opportunity(pool_data) {
    let pos = pool_data.position;
    if pos == () { return no_opp("health_factor_unavailable"); }
    if pos.ts == () { return no_opp("position_feed_invalid"); }
    if pos.collateral_amount == () || pos.debt_amount == () { return no_opp("position_feed_invalid"); }
    if get_timestamp() - pos.ts > 60 { return no_opp("position_state_stale"); }

    let coll_usd = pos.collateral_amount * pos.collateral_price_usd;
    let debt_usd = pos.debt_amount * pos.debt_price_usd;
    if coll_usd <= 0.0 || debt_usd <= 0.0 { return no_opp("position_feed_invalid"); }
    let lt = if pos.liquidation_threshold != () { pos.liquidation_threshold } else { 0.8 };
    let hf = (coll_usd * lt) / debt_usd;
    // Takeover needs liquidation pressure (HF < 1, a motivated counterparty)
    // AND positive equity (collateral worth more than the debt repaid).
    if hf >= 1.0 { return no_opp("health_factor_healthy"); }
    let equity_usd = coll_usd - debt_usd;
    if equity_usd <= 0.0 { return no_opp("negative_equity_not_takeable"); }
    if pos.flash_fee_bps == () { return no_opp("flash_fee_unavailable"); }

    // -- Exit queue: sell ALL collateral through the exact CPMM route into
    // debt tokens and repay the flash-funded debt with the proceeds.
    let st = route_state(pool_data.route, 2);
    if st.err != "" { return no_opp(st.err); }
    let rin = st.rin;
    let rout = st.rout;
    let fees = st.fees;
    let tmc = get_token_meta(pos.collateral_token);
    let tmd = get_token_meta(pos.debt_token);
    if tmc == () || tmd == () { return no_opp("missing_token_meta"); }
    let bu_c = math_pow(10.0, tmc.decimals.to_float());
    let bu_d = math_pow(10.0, tmd.decimals.to_float());

    let amt = pos.collateral_amount * bu_c;
    for i in 0..rin.len() {
        amt = cpmm_out(amt, rin[i], rout[i], fees[i]);
    }
    let out_debt = amt / bu_d;
    let flash_cost = pos.debt_amount * pos.flash_fee_bps.to_float() / 10000.0;
    let profit_d = out_debt - pos.debt_amount - flash_cost;
    if profit_d <= 0.0 { return no_opp("impact_zero"); }

    let profit_usd = profit_d * pos.debt_price_usd;
    if profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_d, confidence: 0.65,
        urgency: "immediate", reason: "underwater_takeover_equity_profit",
        detector_id: "L_LIQ", mev_id: "MEV-08-024",
        health_factor: hf, equity_usd_hint: equity_usd,
        profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "L_LIQ",
        mev_id: "MEV-08-024"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-08-024",
        detector_id: "L_LIQ"
    }
}
