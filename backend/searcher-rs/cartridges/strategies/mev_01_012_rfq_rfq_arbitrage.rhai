// MEV-01-012 — RFQ–RFQ arbitrage
// Detector family: R_ORDERBOOK (EXTERNAL_DATA_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave A: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Pi(q) = Proceeds_bid(q) - Cost_ask(q) - taker_fees(q) - settlement_cost(q)
//           - hedge_cost(q).  Prices must be VWAP/depth-aware, not top-of-book.
//   RFQ–RFQ: each leg carries a FIRM quote as `leg.rfq` =
//   #{ price: <token_out per token_in>, max_in: <max token_in units the quote
//   fills> }. Buy on one maker's firm ask, sell on the other's firm bid — the
//   depth cap of a firm quote IS its size (no top-of-book simplification).
//   The executable size bound is propagated EXACTLY backwards through the
//   chain (cap_in_i = min(max_in_i, cap_in_{i+1} / (price_i*gamma_i))), then
//   Pi(q) is maximised inside the bound via golden-section.
//
// Zero-Mocks / Fail-Honest: a leg without a firm quote =>
// is_opportunity:false with reason "rfq_quote_unavailable" (the RFQ feed is
// not yet wired to the route pipeline — the math is live the moment it is).
// NEVER fabricated.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Fee default 0.30% = 30 bps -> gamma=0.997;
// coarse gas precheck GAS_HINT_USD=5.0; authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "RFQ–RFQ arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "route_graph_engine",
        mev_id: "MEV-01-012",
        detector_id: "R_ORDERBOOK",
        execution_class: "EXTERNAL_DATA_REQUIRED",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [8, 10, 23, 11],
        secondary_operators: [13, 22, 16],
        triggers: ["new_block"],
        required_bindings: ["get_token_meta"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

fn evaluate_opportunity(pool_data) {
    let route = pool_data.route;
    if route == () { return no_opp("missing_route"); }
    let n = route.len();
    if n < 2 || n > 8 { return no_opp("route_shape_out_of_bounds"); }
    if pool_data.route_closed != true { return no_opp("route_not_closed"); }

    // -- Gather firm quotes (RFQ–RFQ: every leg must carry one) -----------------
    let prices = [];  // price_i: token_out per token_in
    let caps = [];    // max_in_i: firm fill cap in token_in units
    let fees = [];    // taker fee_bps per leg
    let token_in0 = "";
    let token_out_last = "";
    let dec0 = -1;
    for i in 0..n {
        let leg = route[i];
        let rfq = leg.rfq;
        if rfq == () { return no_opp("rfq_quote_unavailable"); }
        let pv = rfq.price;
        let cv = rfq.max_in;
        if pv == () || cv == () { return no_opp("rfq_quote_invalid"); }
        // *1.0 normalises INT/FLOAT Dynamics to FLOAT (Rhai does not coerce
        // INT args into float-registered host functions like math_min).
        let p = pv * 1.0;
        let c = cv * 1.0;
        if p <= 0.0 || c <= 0.0 {
            return no_opp("rfq_quote_invalid");
        }
        prices.push(p);
        caps.push(c);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if i == 0 { token_in0 = leg.token_in; }
        if i == n - 1 { token_out_last = leg.token_out; }
    }
    // A closed cycle must return to its start token.
    if token_out_last != token_in0 { return no_opp("route_not_closed"); }

    // Decimals of the input token for a sane sizing bracket (fail-honest).
    let tm = get_token_meta(token_in0);
    if tm == () { return no_opp("missing_token_meta"); }
    dec0 = tm.decimals;
    let base_unit = math_pow(10.0, dec0.to_float());

    // -- Marginal prefilter: prod_i[(1-fee_i)*price_i] > 1 ------------------------
    let log_sum = 0.0;
    for i in 0..n {
        let adj = (1.0 - fees[i].to_float() / 10000.0) * prices[i];
        if adj <= 0.0 { return no_opp("degenerate_rate"); }
        log_sum += -math_log(adj);
    }
    if log_sum >= 0.0 { return no_opp("prefilter_non_positive"); }

    // -- Executable bound: backward propagation of the firm caps -----------------
    // Flow is q -> q*p_0*gamma_0 -> ... -> q*prod. Leg i fills q_i only when
    // q_i <= max_in_i, so the input bound is
    //   cap_in_{n-1} = max_in_{n-1};  cap_in_i = min(max_in_i, cap_in_{i+1}/r_i)
    // with r_i = p_i*gamma_i. Exact — no approximation, no fabrication.
    let cap_in = [];
    for _i in 0..n { cap_in.push(0.0); }
    cap_in[n - 1] = caps[n - 1];
    let j = n - 2;
    for _k in 0..(n - 1) {
        let rate = prices[j] * (1.0 - fees[j].to_float() / 10000.0);
        cap_in[j] = math_min(caps[j], cap_in[j + 1] / rate);
        j = j - 1;
    }
    if cap_in[0] <= 0.0 { return no_opp("rfq_size_exceeded"); }

    // -- Compose Pi(q) and maximise via golden-section ---------------------------
    let x_lo = base_unit * 0.01;
    let x_hi = cap_in[0] * 0.999999;
    if x_hi <= x_lo { return no_opp("rfq_size_exceeded"); }

    let gr = 0.6180339887498949;  // golden ratio conjugate (phi-1)
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, prices, caps, fees);
    let fd = profit_at(d, prices, caps, fees);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = profit_at(d, prices, caps, fees); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = profit_at(c, prices, caps, fees); }
    }
    let x_star = (a + b) / 2.0;
    let profit_tok = profit_at(x_star, prices, caps, fees);

    if profit_tok <= -1.0e29 { return no_opp("rfq_size_exceeded"); }
    if profit_tok <= 0.0 { return no_opp("impact_zero"); }

    // Gross profit hint in USD for the net gate precheck (fail-honest on price).
    let px = get_token_price_usd(token_in0);
    let profit_usd = 0.0;
    if px != () && px > 0.0 {
        profit_usd = (profit_tok / base_unit) * px;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    // Optional operator evidence (confidence modulation only; never required,
    // never fabricated).
    let conf = 0.7;  // firm quotes present + profitable prefilter
    let ev = get_math_evidence("MEV-01-012");
    if ev != () && ev.confidence != () {
        conf = math_max(0.0, math_min(1.0, (conf + ev.confidence) / 2.0));
    }

    #{
        is_opportunity: true,
        estimated_profit: profit_tok / base_unit,   // gross, input token units
        confidence: conf,
        urgency: "immediate",
        reason: "rfq_rfq_firm_quote_profit",
        detector_id: "R_ORDERBOOK",
        mev_id: "MEV-01-012",
        optimal_amount_in: x_star / base_unit,
        legs: n,
        profit_usd_hint: profit_usd
    }
}

// Pi(q) in input-token units: chain of firm quotes, each fillable only up to
// its own max_in (beyond => -1e30 sentinel; the bracket already excludes it,
// the sentinel guards float drift at the boundary).
fn profit_at(x, prices, caps, fees) {
    let amt = x;
    for i in 0..prices.len() {
        if amt > caps[i] { return -1.0e30; }
        let gamma = (10000.0 - fees[i].to_float()) / 10000.0;
        amt = amt * prices[i] * gamma;
    }
    amt - x
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "R_ORDERBOOK",
        mev_id: "MEV-01-012"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-01-012",
        detector_id: "R_ORDERBOOK"
    }
}
