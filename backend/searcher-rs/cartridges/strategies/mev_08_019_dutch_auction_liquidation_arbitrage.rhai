// MEV-08-019 — Dutch-auction liquidation arbitrage
// Detector family: L_AUCTION (DETERMINISTIC_AUCTION)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave D (G08): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Π(q,t)=ConservativeCollateralValue(q)-AuctionCost(q,t)-UnwindCost(q)-Gas-capital risk; solve lot size and timing under exact auction rules.
// Primary operators (evidence only, math-engine): [19, 21, 23]
// Secondary operators (evidence only): [8, 11, 22]
//
//   pool_data.auction — liquidation-auction lot feed (no pipeline binding
//   populates it today => auction_feed_unavailable). Shape:
//   #{ kind ("liquidation"|"dutch"|"bad_debt"|"recap"),
//      lot_token, lot_qty (human), lot_price_usd (per unit),
//      start_px_usd, end_px_usd, start_ts, end_ts (linear decay curve),
//      haircut (conservative-value discount), fee_bps, max_qty, ts }
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Dutch-auction liquidation arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "credit_liquidation_engine",
        mev_id: "MEV-08-019",
        detector_id: "L_AUCTION",
        execution_class: "DETERMINISTIC_AUCTION",
        min_legs: 1,
        max_legs: 4,
        primary_operators: [19, 21, 23],
        secondary_operators: [8, 11, 22],
        triggers: ["new_block"],
        required_bindings: ["get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}



fn evaluate_opportunity(pool_data) {
    // -- Auction lot feed gate --------------------------------------------------
    let au = pool_data.auction;
    if au == () { return no_opp("auction_feed_unavailable"); }
    if au.kind != "dutch" { return no_opp("auction_kind_mismatch"); }
    if au.ts == () { return no_opp("auction_feed_invalid"); }
    if au.lot_qty == () || au.lot_qty <= 0.0 { return no_opp("auction_feed_invalid"); }
    if au.lot_price_usd == () || au.lot_price_usd <= 0.0 { return no_opp("auction_feed_invalid"); }
    if au.start_px_usd == () || au.end_px_usd == () { return no_opp("auction_feed_invalid"); }
    if au.start_ts == () || au.end_ts == () || au.end_ts <= au.start_ts { return no_opp("auction_feed_invalid"); }
    if au.start_px_usd <= au.end_px_usd { return no_opp("not_decaying"); }

    let now = get_timestamp();
    if now >= au.end_ts { return no_opp("auction_ended"); }

    // -- Pi(q,t) = ConservativeValue(q) - AuctionPrice(q,t) - UnwindCost(q) ----
    // Linear decay P(t) between start and end price; conservative value is the
    // documented per-unit oracle value net of the haircut; unwind rides the
    // fee. Honest q cap at the documented max_qty.
    let f = (now - au.start_ts).to_float() / (au.end_ts - au.start_ts).to_float();
    if f < 0.0 { f = 0.0; }
    let p_now = au.start_px_usd + (au.end_px_usd - au.start_px_usd) * f;
    let haircut = if au.haircut != () { au.haircut } else { 0.1 };
    let value = au.lot_price_usd * (1.0 - haircut);
    let fee_bps = if au.fee_bps != () { au.fee_bps.to_float() } else { 0.0 };

    let qty = au.lot_qty;
    if au.max_qty != () && au.max_qty > 0.0 { qty = math_min(qty, au.max_qty); }

    let profit_usd = (value - p_now) * qty - p_now * qty * fee_bps / 10000.0;
    if profit_usd <= 0.0 {
        // Honest timing answer: if the curve still decays below value before
        // the deadline the lot is early, not absent.
        if au.end_px_usd < value { return no_opp("decay_not_yet_profitable"); }
        return no_opp("auction_no_edge");
    }
    if profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_usd, confidence: 0.65,
        urgency: "immediate", reason: "auction_discount_profit",
        detector_id: "L_AUCTION", mev_id: "MEV-08-019",
        auction_px_now: p_now, conservative_value: value,
        qty: qty, profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "L_AUCTION",
        mev_id: "MEV-08-019"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-08-019",
        detector_id: "L_AUCTION"
    }
}
