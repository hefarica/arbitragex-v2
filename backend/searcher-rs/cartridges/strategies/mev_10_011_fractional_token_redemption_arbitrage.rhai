// MEV-10-011 — Fractional-token redemption arbitrage
// Detector family: N_REDEEM (DETERMINISTIC_IF_REDEEMABLE)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave E (G10): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Π=deterministic redeem/unbundle value-acquisition cost-component unwind costs; inverse path for mint/bundle-and-sell if contract permits.
// Primary operators (evidence only, math-engine): [19, 21, 13]
// Secondary operators (evidence only): [8, 11, 22]
//
//   pool_data.nft — NFT market feed (firm quotes, listings, redemptions;
//   no pipeline binding populates it today, so this cartridge waits
//   fail-honest with nft_floor_feed_unavailable). Shape when it lands:
//   #{ collection, token_id, asset_class,
//      denom_token (payment token address, e.g. WETH),
//      ask_venue, ask_px (denom per NFT, firm listing), buy_fee_bps,
//      bid_venue, bid_px (denom, firm bid), bid_depth (NFTs), sell_fee_bps,
//      royalty_bps, bid_venue_zr: #{ venue, bid_px, sell_fee_bps } (016),
//      floor_px_a / floor_px_b (venue floors — SIGNAL only, never profit),
//      trait_premium (003), basket: [#{collection, ask_px, bid_px}, ...] (004),
//      mint_px, mint_open (008),
//      amm: #{ pool, nft_side, fee_bps }, amm_b: #{ pool, nft_side, fee_bps } (006/007),
//      fraction_supply, fraction_bid_px (010), fraction_ask_px (011),
//      redeem_value (018), bundle: [#{bid_px}, ...] (017),
//      loan: #{ debt_px, health_factor } (012),
//      rental: #{ rate_daily, period_days } (013),
//      src_chain, dst_chain, bridge_fee_bps, risk_discount_bps (015),
//      ts (unix sec) }
//   Prices are in denom_token human units unless suffixed _usd.
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Fractional-token redemption arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "nft_engine",
        mev_id: "MEV-10-011",
        detector_id: "N_REDEEM",
        execution_class: "DETERMINISTIC_IF_REDEEMABLE",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [19, 21, 13],
        secondary_operators: [8, 11, 22],
        triggers: ["new_block"],
        required_bindings: ["get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}



fn evaluate_opportunity(pool_data) {
    // -- NFT feed gate (RULE 00: floor signals are never profit) ----------------
    let nft = pool_data.nft;
    if nft == () { return no_opp("nft_floor_feed_unavailable"); }
    if nft.ts == () { return no_opp("nft_feed_invalid"); }
    if get_timestamp() - nft.ts > 300 { return no_opp("nft_feed_stale"); }
    if nft.bid_px == () || nft.bid_px <= 0.0 { return no_opp("no_firm_bid"); }
    if nft.fraction_supply == () || nft.fraction_supply <= 0.0 || nft.fraction_ask_px == () || nft.fraction_ask_px <= 0.0 {
        return no_opp("fractionalization_unavailable");
    }

    let buy_fee = if nft.buy_fee_bps != () { nft.buy_fee_bps.to_float() } else { 0.0 };
    let sell_fee = if nft.sell_fee_bps != () { nft.sell_fee_bps.to_float() } else { 0.0 };
    let royalty = if nft.royalty_bps != () { nft.royalty_bps.to_float() } else { 0.0 };
    let ask_net = nft.ask_px * (1.0 + buy_fee / 10000.0);

    let profit_d = nft.bid_px * (1.0 - (sell_fee + royalty) / 10000.0) - nft.fraction_ask_px * nft.fraction_supply * (1.0 + buy_fee / 10000.0);
    if profit_d <= 0.0 { return no_opp("no_redemption_edge"); }
    // Denom USD hint for the net gate precheck (fail-honest on price miss).
    let tmd = get_token_meta(nft.denom_token);
    if tmd == () { return no_opp("missing_denom_meta"); }
    let px = get_token_price_usd(tmd.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 { profit_usd = profit_d * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_d, confidence: 0.6,
        urgency: "immediate", reason: "fractional_redemption_profit", detector_id: "N_REDEEM",
        mev_id: "MEV-10-011", profit_usd_hint: profit_usd }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "N_REDEEM",
        mev_id: "MEV-10-011"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-10-011",
        detector_id: "N_REDEEM"
    }
}
