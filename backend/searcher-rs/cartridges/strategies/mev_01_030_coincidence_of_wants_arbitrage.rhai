// MEV-01-030 — Coincidence-of-Wants arbitrage
// Detector family: R_COW (DETERMINISTIC_SETTLEMENT)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave A: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Maximize total executable trader surplus subject to limit prices, token
//   conservation and settlement constraints; compare internal matching vs
//   external liquidity.
//   Implementation: the intent batch arrives as `pool_data.orders` =
//   [#{ sell_token, buy_token, sell_amount, buy_amount }, ...] (limit orders,
//   amounts in base units). A complementary pair (o_i sells X buys Y,
//   o_j sells Y buys X) is INTERNALLY matchable when the limit prices cross:
//     p_i_min = buy_i/sell_i  (min Y per X o_i accepts)
//     p_j_max = sell_j/buy_j  (max Y per X o_j pays)
//     cross  <=> p_j_max >= p_i_min
//   Executable quantity q* = min(sell_i, sell_j / p_j_max) (fill o_j at its
//   own limit), total surplus S(q) = q * (p_j_max - p_i_min) in Y units,
//   maximised via golden-section on the executable interval. Token
//   conservation holds by construction (q X moves i->j, q*p Y moves j->i).
//
// Zero-Mocks / Fail-Honest: no intent batch wired => is_opportunity:false
// with reason "intent_batch_unavailable" (the intent feed is not yet bound to
// the route pipeline — the math is live the moment it is). NEVER fabricated.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0;
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Coincidence-of-Wants arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "route_graph_engine",
        mev_id: "MEV-01-030",
        detector_id: "R_COW",
        execution_class: "DETERMINISTIC_SETTLEMENT",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [19, 29, 24, 27],
        secondary_operators: [20, 22, 23],
        triggers: ["new_block"],
        required_bindings: ["get_token_meta"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// Normalise a numeric Dynamic (INT or FLOAT) to FLOAT. Cross-type promotion;
// a non-numeric amount fails loudly (contract violation), never fabricated.
fn as_f(v) { v * 1.0 }

fn evaluate_opportunity(pool_data) {
    // -- Intent batch gate (identity: no intents, no CoW) -------------------------
    let orders = pool_data.orders;
    if orders == () { return no_opp("intent_batch_unavailable"); }
    let n = orders.len();
    if n < 2 { return no_opp("intent_batch_insufficient"); }

    // -- Best internally-matchable complementary pair (limit-price crossing) -----
    // Tracks: best surplus RATE (Y per X), executable q_max, tokens X (sold by
    // the best bidder's counterparty) and Y, and the fill price p_j_max.
    let best_rate = 0.0;
    let best_q = 0.0;
    let best_p = 0.0;
    let best_x = "";
    let best_y = "";
    for i in 0..n {
        let oi = orders[i];
        if oi.sell_amount == () || oi.buy_amount == () { return no_opp("intent_limit_invalid"); }
        let si = as_f(oi.sell_amount);
        let bi = as_f(oi.buy_amount);
        if si <= 0.0 || bi <= 0.0 { return no_opp("intent_limit_invalid"); }
        let p_i_min = bi / si;   // min Y per X order i accepts
        for j in 0..n {
            if j != i {
                let oj = orders[j];
                if oj.sell_amount == () || oj.buy_amount == () { return no_opp("intent_limit_invalid"); }
                let sj = as_f(oj.sell_amount);
                let bj = as_f(oj.buy_amount);
                if sj <= 0.0 || bj <= 0.0 { return no_opp("intent_limit_invalid"); }
                // Complementary directions: i sells X buys Y; j sells Y buys X.
                if oi.sell_token == oj.buy_token && oi.buy_token == oj.sell_token {
                    let p_j_max = sj / bj;   // max Y per X order j pays
                    if p_j_max > p_i_min {
                        let rate = p_j_max - p_i_min;
                        let q_max = math_min(si, sj / p_j_max);
                        if rate > best_rate && q_max > 0.0 {
                            best_rate = rate;
                            best_q = q_max;
                            best_p = p_j_max;
                            best_x = oi.sell_token;
                            best_y = oi.buy_token;
                        }
                    }
                }
            }
        }
    }
    if best_rate <= 0.0 || best_q <= 0.0 { return no_opp("no_crossing_intents"); }

    // Decimals of the surplus token (Y) for the sizing bracket (fail-honest).
    let tm = get_token_meta(best_y);
    if tm == () { return no_opp("missing_token_meta"); }
    let dec_y = tm.decimals;
    let base_unit = math_pow(10.0, dec_y.to_float());

    // -- Maximise S(q) = q * (p_j_max - p_i_min) via golden-section --------------
    // Strictly increasing in q, so the maximum sits at the executable corner
    // q_max; golden-section converges to it from inside the interval.
    let x_lo = base_unit * 0.01;
    if best_q <= x_lo { return no_opp("intent_size_below_unit"); }
    let x_hi = best_q * 0.999999;

    let gr = 0.6180339887498949;  // golden ratio conjugate (phi-1)
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = surplus_at(c, best_rate);
    let fd = surplus_at(d, best_rate);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = surplus_at(d, best_rate); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = surplus_at(c, best_rate); }
    }
    let q_star = (a + b) / 2.0;
    let surplus_tok = surplus_at(q_star, best_rate);

    if surplus_tok <= 0.0 { return no_opp("impact_zero"); }

    // Gross surplus hint in USD for the net gate precheck (fail-honest on price).
    let px = get_token_price_usd(best_y);
    let surplus_usd = 0.0;
    if px != () && px > 0.0 {
        surplus_usd = (surplus_tok / base_unit) * px;
    }
    if surplus_usd > 0.0 && surplus_usd < 5.0 { return no_opp("below_gas_threshold"); }

    // Optional operator evidence (confidence modulation only; never required,
    // never fabricated).
    let conf = 0.7;  // executable crossing pair found in the live batch
    let ev = get_math_evidence("MEV-01-030");
    if ev != () && ev.confidence != () {
        conf = math_max(0.0, math_min(1.0, (conf + ev.confidence) / 2.0));
    }

    #{
        is_opportunity: true,
        estimated_profit: surplus_tok / base_unit,   // gross, surplus token units
        confidence: conf,
        urgency: "immediate",
        reason: "cow_crossing_pair_surplus",
        detector_id: "R_COW",
        mev_id: "MEV-01-030",
        optimal_amount_in: q_star / base_unit,       // X units matched
        matched_pair: #{ sell_token: best_x, buy_token: best_y, fill_price: best_p },
        orders: n,
        profit_usd_hint: surplus_usd
    }
}

// S(q) = q * (p_j_max - p_i_min) — total executable trader surplus for a
// q-sized internal match of the crossing pair, in Y (surplus token) units.
fn surplus_at(q, rate) { q * rate }

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "R_COW",
        mev_id: "MEV-01-030"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-01-030",
        detector_id: "R_COW"
    }
}
