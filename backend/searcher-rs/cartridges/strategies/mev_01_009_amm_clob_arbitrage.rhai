// MEV-01-009 — AMM–CLOB arbitrage
// Detector family: R_ORDERBOOK (EXTERNAL_DATA_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave A: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Pi(q) = Proceeds_bid(q) - Cost_ask(q) - taker_fees(q) - settlement_cost(q)
//           - hedge_cost(q).  Prices must be VWAP/depth-aware, not top-of-book.
//   Implementation on the data the pipeline exposes TODAY:
//   - AMM legs: exact constant-product quote from live reserves (get_reserves)
//     -> the executable Cost_ask side of the cycle.
//   - CLOB legs: depth-aware VWAP walk over the bid ladder attached to the leg
//     as `orderbook.bids` = [#{ price: <token_out per token_in>,
//     size: <token_in units> }, ...] (best first) -> Proceeds_bid(q), with the
//     leg's fee_bps as taker fee. Top-of-book is NEVER used.
//   Sizing: golden-section on Pi(q); depth insufficiency is a hard no-op.
//
// Zero-Mocks / Fail-Honest: no ladder on a CLOB leg => is_opportunity:false
// with reason "clob_depth_unavailable" (the CLOB feed is not yet wired to the
// route pipeline — the math is live the moment it is). NEVER fabricated.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Fee default 0.30% = 30 bps -> gamma=0.997;
// coarse gas precheck GAS_HINT_USD=5.0; authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "AMM–CLOB arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "route_graph_engine",
        mev_id: "MEV-01-009",
        detector_id: "R_ORDERBOOK",
        execution_class: "EXTERNAL_DATA_REQUIRED",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [8, 10, 23, 11],
        secondary_operators: [13, 22, 16],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one pool leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// Depth-aware VWAP Proceeds_bid for one CLOB leg: sell x token_in into the
// bid ladder (price = token_out per token_in, best first), taker fee on
// proceeds. Returns -1.0 when the ladder cannot fill x — the caller treats
// that as "not executable at this size" (RULE 00: no partial fabricated fill).
fn ob_out(x, orderbook, fee_bps) {
    let ladder = orderbook.bids;
    if ladder == () || ladder.len() == 0 { return -1.0; }
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let remaining = x;
    let proceeds = 0.0;
    for i in 0..ladder.len() {
        if remaining > 0.0 {
            let lvl = ladder[i];
            // Malformed level (missing price/size): stop walking — the walk
            // stays unfillable rather than valuing a fabricated level.
            if lvl.price != () && lvl.size != () {
                let take = math_min(remaining, lvl.size * 1.0);
                proceeds += take * (lvl.price * 1.0);
                remaining -= take;
            }
        }
    }
    if remaining > 0.0 { return -1.0; }
    proceeds * gamma
}

fn evaluate_opportunity(pool_data) {
    let route = pool_data.route;
    if route == () { return no_opp("missing_route"); }
    let n = route.len();
    if n < 2 || n > 8 { return no_opp("route_shape_out_of_bounds"); }
    if pool_data.route_closed != true { return no_opp("route_not_closed"); }

    // -- Gather per-leg state; classify venue kind (pool vs book) ---------------
    let rin = [];        // pool legs: reserve of token_in
    let rout = [];       // pool legs: reserve of token_out
    let fees = [];       // fee_bps per leg (both kinds)
    let is_book = [];    // true => leg i quotes via orderbook.bids
    let books = [];      // book legs: the orderbook map (unit for pool legs)
    let amm_legs = 0;
    let book_legs = 0;
    let token_in0 = "";
    let token_out_last = "";
    let dec0 = -1;
    for i in 0..n {
        let leg = route[i];
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if i == 0 { token_in0 = leg.token_in; }
        if i == n - 1 { token_out_last = leg.token_out; }

        let ob = leg.orderbook;
        if ob != () {
            // CLOB leg: needs a non-empty bid ladder (VWAP, depth-aware).
            if ob.bids == () || ob.bids.len() == 0 { return no_opp("clob_depth_unavailable"); }
            is_book.push(true);
            books.push(ob);
            rin.push(0.0);
            rout.push(0.0);
            book_legs += 1;
        } else {
            // AMM leg: exact reserves (fail-honest).
            let pool = leg.pool;
            if pool == () || pool == "" { return no_opp("missing_pool_address"); }
            let res = get_reserves(pool);
            if res == () { return no_opp("missing_reserves"); }
            let r0 = res.r0.to_float();
            let r1 = res.r1.to_float();
            if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
            let ri = r0;
            let ro = r1;
            if res.token0_addr != () && leg.token_in != () {
                let t0 = res.token0_addr;
                if leg.token_in != t0 { ri = r1; ro = r0; }
            }
            rin.push(ri);
            rout.push(ro);
            is_book.push(false);
            books.push(());
            amm_legs += 1;
        }
    }
    // Closed cycle + hybrid identity: at least one AMM leg AND one CLOB leg.
    if token_out_last != token_in0 { return no_opp("route_not_closed"); }
    if book_legs == 0 { return no_opp("clob_leg_missing"); }
    if amm_legs == 0 { return no_opp("amm_leg_missing"); }

    // Decimals of the input token for a sane sizing bracket (fail-honest).
    let tm = get_token_meta(token_in0);
    if tm == () { return no_opp("missing_token_meta"); }
    dec0 = tm.decimals;
    let base_unit = math_pow(10.0, dec0.to_float());

    // -- Marginal prefilter: sum_e[-ln((1-fee_e)*rate_e)] < 0 -------------------
    // rate_e: pool leg = rout/rin spot; book leg = best bid (token_out per
    // token_in). If the fee-adjusted product <= 1 the cycle cannot pay at any
    // size and the VWAP walk (strictly worse than the best level) cannot either.
    let log_sum = 0.0;
    for i in 0..n {
        let rate = 0.0;
        if is_book[i] {
            let p0 = books[i].bids[0].price;
            if p0 == () { return no_opp("clob_depth_unavailable"); }
            rate = p0 * 1.0;
        } else {
            rate = rout[i] / rin[i];
        }
        let adj = (1.0 - fees[i].to_float() / 10000.0) * rate;
        if adj <= 0.0 { return no_opp("degenerate_rate"); }
        log_sum += -math_log(adj);
    }
    if log_sum >= 0.0 { return no_opp("prefilter_non_positive"); }

    // -- Compose Pi(q) and maximise via golden-section ---------------------------
    // Bracket vs the AMM leg depth when leg 0 is a pool leg; otherwise vs the
    // first bid level size (book legs carry their own depth cap).
    let x_lo = base_unit * 0.01;
    let x_hi = 0.0;
    if !is_book[0] {
        x_hi = math_max(base_unit * 1.0, rin[0] * 0.05);
    } else {
        x_hi = math_max(base_unit * 1.0, books[0].bids[0].size * 0.5);
    }

    let gr = 0.6180339887498949;  // golden ratio conjugate (phi-1)
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, rin, rout, fees, is_book, books);
    let fd = profit_at(d, rin, rout, fees, is_book, books);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = profit_at(d, rin, rout, fees, is_book, books); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = profit_at(c, rin, rout, fees, is_book, books); }
    }
    let x_star = (a + b) / 2.0;
    let profit_tok = profit_at(x_star, rin, rout, fees, is_book, books);

    // Depth sentinel from a book leg: the optimal size did not fit the ladder.
    if profit_tok <= -1.0e29 { return no_opp("clob_depth_insufficient"); }
    if profit_tok <= 0.0 { return no_opp("impact_zero"); }

    // Gross profit hint in USD for the net gate precheck (fail-honest on price).
    let px = get_token_price_usd(token_in0);
    let profit_usd = 0.0;
    if px != () && px > 0.0 {
        profit_usd = (profit_tok / base_unit) * px;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    // Optional operator evidence (confidence modulation only; never required,
    // never fabricated).
    let conf = 0.7;  // full on-chain data present + profitable prefilter
    let ev = get_math_evidence("MEV-01-009");
    if ev != () && ev.confidence != () {
        conf = math_max(0.0, math_min(1.0, (conf + ev.confidence) / 2.0));
    }

    #{
        is_opportunity: true,
        estimated_profit: profit_tok / base_unit,   // gross, input token units
        confidence: conf,
        urgency: "immediate",
        reason: "amm_clob_vwap_profit",
        detector_id: "R_ORDERBOOK",
        mev_id: "MEV-01-009",
        optimal_amount_in: x_star / base_unit,
        legs: n,
        profit_usd_hint: profit_usd
    }
}

// Pi(q) in input-token units across pool legs (exact CPMM Cost_ask side) and
// book legs (VWAP Proceeds_bid side), taker fees folded per leg. An unfilled
// book leg yields the -1e30 sentinel so the search avoids infeasible sizes.
fn profit_at(x, rin, rout, fees, is_book, books) {
    let amt = x;
    for i in 0..is_book.len() {
        if is_book[i] {
            let q = ob_out(amt, books[i], fees[i]);
            if q < 0.0 { return -1.0e30; }
            amt = q;
        } else {
            amt = cpmm_out(amt, rin[i], rout[i], fees[i]);
        }
    }
    amt - x
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "R_ORDERBOOK",
        mev_id: "MEV-01-009"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-01-009",
        detector_id: "R_ORDERBOOK"
    }
}
