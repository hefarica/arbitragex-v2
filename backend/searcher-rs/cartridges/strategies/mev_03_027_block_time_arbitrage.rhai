// MEV-03-027 — Block-time arbitrage
// Detector family: E_LATENCY (LATENCY_SENSITIVE)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave B: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   E_LATENCY (block-cadence window): divergence held across a full block cadence must clear a wider band (1.2%) than the pure stale-price trigger — PoS missed slots make the next-block horizon uncertain. Same fast/slow trigger + executable round trip.
//   Trigger z=(p_fast-p_slow)/σ only identifies divergence; opportunity requires a firm executable quote/route and Π_net>0 before stale side updates.
// Primary operators (evidence only, math-engine): [08, 10, 23, 11]
// Secondary operators (evidence only): [13,22,16]
//
// Zero-Mocks / Fail-Honest: all state from CartridgeContextV3 route[] + host
// bindings. Missing reserves/decimals/prices => is_opportunity:false + reason.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below.

fn init_strategy() {
    #{
        name: "Block-time arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "state_event_engine",
        mev_id: "MEV-03-027",
        detector_id: "E_LATENCY",
        execution_class: "LATENCY_SENSITIVE",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [8, 10, 23, 11],
        secondary_operators: [13, 22, 16],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_token_price_usd"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

fn evaluate_opportunity(pool_data) {
    // -- Trigger gate: divergence between the fast executable state and the ---
    // slow reference price. The trigger only IDENTIFIES divergence; the
    // opportunity still requires a firm executable route with net profit
    // before the stale side updates (manifest equation).
    let route = pool_data.route;
    if route == () { return no_opp("missing_route"); }
    let n = route.len();
    if n < 2 || n > 8 { return no_opp("route_shape_out_of_bounds"); }
    if pool_data.route_closed != true { return no_opp("route_not_closed"); }

    // -- Gather exact per-leg state (fail-honest) ------------------------------
    let rin = [];   // reserve of token_in per leg (float, base units)
    let rout = [];  // reserve of token_out per leg
    let fees = [];  // fee_bps per leg
    let token_in0 = "";
    let token_out_last = "";
    let worst_lag = -1;
    let head = get_block_number();
    for i in 0..n {
        let leg = route[i];
        let pool = leg.pool;
        if pool == () || pool == "" { return no_opp("missing_pool_address"); }
        let res = get_reserves(pool);
        if res == () { return no_opp("missing_reserves"); }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
        // Orient reserves by token_in via the reserve's token0_addr.
        let ri = r0;
        let ro = r1;
        if res.token0_addr != () && leg.token_in != () {
            let t0 = res.token0_addr;
            if leg.token_in != t0 { ri = r1; ro = r0; }
        }
        rin.push(ri);
        rout.push(ro);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if i == 0 { token_in0 = leg.token_in; }
        if i == n - 1 { token_out_last = leg.token_out; }
        // Post-event state freshness: S'=T_e(S) must be the state we quote.
        if res.block == () { return no_opp("state_freshness_unverifiable"); }
        let lag = head - res.block;
        if lag < 0 { return no_opp("state_freshness_unverifiable"); }
        if lag > worst_lag { worst_lag = lag; }
    }
    if token_out_last != token_in0 { return no_opp("route_not_closed"); }

    // -- Fast/slow divergence on leg 0's pair ----------------------------------
    // fast = executable marginal on the live pool (sub-second state)
    // slow = the searcher's price-oracle reference (~30s cadence) for the pair
    let leg0 = route[0];
    let tmi = get_token_meta(leg0.token_in);
    let tmo = get_token_meta(leg0.token_out);
    if tmi == () || tmo == () { return no_opp("missing_token_meta"); }
    let px_in = get_token_price_usd(tmi.symbol);
    let px_out = get_token_price_usd(tmo.symbol);
    if px_in == () || px_out == () || px_in <= 0.0 || px_out <= 0.0 { return no_opp("no_slow_reference_price"); }
    let o = (px_in / px_out) * math_pow(10.0, tmo.decimals.to_float() - tmi.decimals.to_float());
    if o <= 0.0 { return no_opp("no_slow_reference_price"); }
    let m0 = (1.0 - fees[0].to_float() / 10000.0) * (rout[0] / rin[0]);
    let z = m0 / o - 1.0;
    if math_abs(z) < 0.012 { return no_opp("divergence_below_band"); }

    // Decimals of the input token for a sane sizing bracket (fail-honest).
    let tm = get_token_meta(token_in0);
    if tm == () { return no_opp("missing_token_meta"); }
    let dec0 = tm.decimals;
    let base_unit = math_pow(10.0, dec0.to_float());

    // -- Marginal prefilter: sum_e[-ln((1-fee_e)*rate_e)] < 0 ------------------
    // If the product of fee-adjusted marginal rates <= 1 the cycle cannot be
    // profitable at any size; skip the sizing work.
    let log_sum = 0.0;
    for i in 0..n {
        let rate = rout[i] / rin[i];
        let adj = (1.0 - fees[i].to_float() / 10000.0) * rate;
        if adj <= 0.0 { return no_opp("degenerate_rate"); }
        log_sum += -math_log(adj);
    }
    if log_sum >= 0.0 { return no_opp("prefilter_non_positive"); }

    // -- Compose Q_R(x) and maximise P_R(x) via golden-section -----------------
    let x_lo = base_unit * 0.01;
    let x_hi = math_max(base_unit * 1.0, rin[0] * 0.05);

    let gr = 0.6180339887498949;  // golden ratio conjugate (phi-1)
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, rin, rout, fees);
    let fd = profit_at(d, rin, rout, fees);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = profit_at(d, rin, rout, fees); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = profit_at(c, rin, rout, fees); }
    }
    let x_star = (a + b) / 2.0;
    let profit_tok = profit_at(x_star, rin, rout, fees);

    if profit_tok <= 0.0 { return no_opp("impact_zero"); }
    let divergence_hint = z;
    // Gross profit hint in USD for the net gate precheck (fail-honest on price;
    // the oracle hash is symbol-keyed, so resolve the symbol first).
    let px = get_token_price_usd(tm.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 {
        profit_usd = (profit_tok / base_unit) * px;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    // Optional operator evidence (confidence modulation only; never required,
    // never fabricated).
    let conf = 0.7;
    let ev = get_math_evidence("MEV-03-027");
    if ev != () && ev.confidence != () {
        conf = math_max(0.0, math_min(1.0, (conf + ev.confidence) / 2.0));
    }

    #{
        is_opportunity: true,
        estimated_profit: profit_tok / base_unit,   // gross, input token units
        confidence: conf,
        divergence: divergence_hint,
        urgency: "immediate",
        reason: "block_time_divergence_profit",
        detector_id: "E_LATENCY",
        mev_id: "MEV-03-027",
        optimal_amount_in: x_star / base_unit,
        legs: n,
        profit_usd_hint: profit_usd
    }

}

// P_R(x) in input-token units: Q_R(x) - x (gas handled by the USD precheck).
fn profit_at(x, rin, rout, fees) {
    let amt = x;
    for i in 0..rin.len() {
        amt = cpmm_out(amt, rin[i], rout[i], fees[i]);
    }
    amt - x
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "E_LATENCY",
        mev_id: "MEV-03-027"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-03-027",
        detector_id: "E_LATENCY"
    }
}
