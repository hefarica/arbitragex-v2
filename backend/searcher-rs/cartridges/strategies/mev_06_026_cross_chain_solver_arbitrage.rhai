// MEV-06-026 — Cross-chain solver arbitrage
// Detector family: X_BRIDGE (NONATOMIC_BRIDGE_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave C: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   E[Π]=DestinationValue-SourceCost-bridge_fee-gas-carry-CVaR(latency/finality/reorg). Must model non-atomic settlement and failure states.
// Primary operators (evidence only, math-engine): [6, 7, 23, 22]
// Secondary operators (evidence only): [11, 16, 13]
//
// Zero-Mocks / Fail-Honest: the external anchor rides the documented
// pool_data payload below + the runner host bindings (get_reserves,
// get_token_meta, get_token_price_usd, get_block_number, get_timestamp).
// Missing feed/reserves/decimals/prices => is_opportunity:false + reason.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below.
fn init_strategy() {
    #{
        name: "Cross-chain solver arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "cross_domain_engine",
        mev_id: "MEV-06-026",
        detector_id: "X_BRIDGE",
        execution_class: "NONATOMIC_BRIDGE_REQUIRED",
        min_legs: 2,
        max_legs: 16,
        primary_operators: [6, 7, 23, 22],
        secondary_operators: [11, 16, 13],
        triggers: ["new_block"],
        required_bindings: ["get_token_meta", "get_token_price_usd", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// exact-in inversion: x such that cpmm_out(x, ...) == y (closed form).
// Returns a negative sentinel when y >= r_out (unreachable target).
fn cpmm_in_for_out(y, r_in, r_out, fee_bps) {
    if y >= r_out { return -1.0; }
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    (y * r_in) / (gamma * (r_out - y))
}
fn evaluate_opportunity(pool_data) {
    // -- Cross-domain state gate: the bridge/settlement context this detector ---
    // prices against. Rides pool_data.bridge_state; no pipeline binding
    // populates it today, so the cartridge waits fail-honest (RULE 00 / R8).
    // Payload shape when it lands (reserves are decimal strings, exactly the
    // get_reserves format, because the remote domain cannot ride the local
    // Redis cache):
    //   #{ src_chain, dst_chain, src_kind / dst_kind (l1|l2|rollup|sidechain|
    //      appchain), src_vm / dst_vm, src_consensus / dst_consensus,
    //      src_token, src_quote_token, src_pool, src_r0, src_r1, src_token0,
    //      src_fee_bps, dst_token, dst_quote_token, dst_pool, dst_r0, dst_r1,
    //      dst_token0, dst_fee_bps, bridge_fee_bps, bridge_fee_fixed (dst base
    //      human), eta_sec, finality_sec, risk_discount (CVaR fraction),
    //      attested, canonical, ts, mid_legs: [{ pool, r0, r1, token0,
    //      fee_bps, token_in, token_out }] (multi-leg variants),
    //      intent: { bounty_usd, min_out }, liquidation: { size, reward_usd },
    //      inventory_qty, bridge_liquidity, rebalance_incentive_bps,
    //      canonical_fee_bps, fast_fee_bps, wrap_rate, sigma_per_sec,
    //      reorg_prob, reverse_fee_bps, reverse_rate, atomic, builder_slot,
    //      src_oracle_px, dst_oracle_px }
    let bs = pool_data.bridge_state;
    if bs == () { return no_opp("bridge_state_unavailable"); }
    let s_chain = bs.src_chain;
    let d_chain = bs.dst_chain;
    if s_chain == () || d_chain == () || s_chain == d_chain { return no_opp("bridge_state_invalid"); }
    let s_tok = bs.src_token;
    let d_tok = bs.dst_token;
    let s_qt = bs.src_quote_token;
    let d_qt = bs.dst_quote_token;
    if s_tok == () || s_tok == "" || d_tok == () || d_tok == "" { return no_opp("bridge_state_invalid"); }
    if s_qt == () || s_qt == "" || d_qt == () || d_qt == "" { return no_opp("bridge_state_invalid"); }
    if bs.src_r0 == () || bs.src_r1 == () || bs.dst_r0 == () || bs.dst_r1 == () {
        return no_opp("bridge_state_invalid");
    }
    let s_r0 = bs.src_r0.to_float();
    let s_r1 = bs.src_r1.to_float();
    let d_r0 = bs.dst_r0.to_float();
    let d_r1 = bs.dst_r1.to_float();
    if s_r0 <= 0.0 || s_r1 <= 0.0 || d_r0 <= 0.0 || d_r1 <= 0.0 { return no_opp("bridge_state_invalid"); }
    let s_fee = if bs.src_fee_bps != () { bs.src_fee_bps } else { 30 };
    let d_fee = if bs.dst_fee_bps != () { bs.dst_fee_bps } else { 30 };
    if s_fee < 0 || s_fee >= 10000 || d_fee < 0 || d_fee >= 10000 { return no_opp("bridge_state_invalid"); }
    let risk = if bs.risk_discount != () { bs.risk_discount } else { 0.0 };
    if risk < 0.0 || risk >= 0.5 { return no_opp("bridge_state_invalid"); }
    // Orientation: the composition BUYS src_token with src_quote on the src
    // pool (token_in = src_quote_token), then SELLS dst_token on the dst pool
    // (token_in = dst_token).
    let sri = s_r0;
    let sro = s_r1;
    if bs.src_token0 != () && s_qt != bs.src_token0 { sri = s_r1; sro = s_r0; }
    let dri = d_r0;
    let dro = d_r1;
    if bs.dst_token0 != () && d_tok != bs.dst_token0 { dri = d_r1; dro = d_r0; }

    let tms = get_token_meta(s_tok);
    let tmsq = get_token_meta(s_qt);
    let tmd = get_token_meta(d_tok);
    let tmdq = get_token_meta(d_qt);
    if tms == () || tmsq == () || tmd == () || tmdq == () { return no_opp("missing_token_meta"); }
    let px_sq = get_token_price_usd(tmsq.symbol);
    let px_dq = get_token_price_usd(tmdq.symbol);
    if px_sq == () || px_sq <= 0.0 || px_dq == () || px_dq <= 0.0 { return no_opp("fx_source_unavailable"); }
    let bu_st = math_pow(10.0, tms.decimals.to_float());
    let bu_dt = math_pow(10.0, tmd.decimals.to_float());
    let bu_sq = math_pow(10.0, tmsq.decimals.to_float());
    let bu_dq = math_pow(10.0, tmdq.decimals.to_float());

    let bridge_fee_bps = if bs.bridge_fee_bps != () { bs.bridge_fee_bps } else { 0.0 };
    let bridge_frac = bridge_fee_bps.to_float() / 10000.0;
    let fixed_d = if bs.bridge_fee_fixed != () { bs.bridge_fee_fixed } else { 0.0 };
    let fixed_du = fixed_d * bu_dt;
    let cost_mult = 1.0;
    let wrap_rate = 1.0;
    let risk_eff = risk;

    let has_mids = false;
    let mids = bs.mid_legs;
    if mids != () && mids.len() > 0 {
        has_mids = true;
        let m0 = mids[0];
        let ml = mids[mids.len() - 1];
        if m0.token_in != s_tok || ml.token_out != d_tok { return no_opp("mid_leg_chain_mismatch"); }
    }
    let intent = bs.intent;
    if intent == () { return no_opp("intent_state_unavailable"); }
    let bounty = intent.bounty_usd;
    let min_out = intent.min_out;
    if bounty == () || bounty <= 0.0 || min_out == () || min_out <= 0.0 { return no_opp("intent_state_unavailable"); }
    // Fill on the source domain: buy exactly the promised delivery size on the
    // src pool (exact-in inversion), then bridge it (fees must be pre-funded).
    let y_src = (min_out * bu_st + fixed_du) / (1.0 - bridge_frac);
    let x_need = cpmm_in_for_out(y_src, sri, sro, s_fee);
    if x_need <= 0.0 { return no_opp("intent_liquidity_insufficient"); }
    let cost_src = x_need / bu_sq * px_sq;
    let cost = cost_src;
    // Solver: the intent may be cheaper to fill from the destination side —
    // pick the cheaper executable fill.
    let y_dst = min_out * bu_dt;
    let x_dst = cpmm_in_for_out(y_dst, dri, dro, d_fee);
    if x_dst > 0.0 {
        let cost_dst = x_dst / bu_dq * px_dq;
        if cost_dst < cost_src { cost = cost_dst; x_need = x_dst; }
    }

    let net = bounty - cost;
    if net <= 0.0 { return no_opp("intent_bounty_insufficient"); }

    return #{
        is_opportunity: true,
        estimated_profit: net,
        confidence: 0.6,
        urgency: "high",
        reason: "cross_chain_solver_fill_profit",
        detector_id: "X_BRIDGE",
        mev_id: "MEV-06-026",
        optimal_amount_in: x_need / bu_sq,
        src_chain: s_chain,
        dst_chain: d_chain,
        intent_bounty_usd: bounty,
        profit_usd_hint: net
    }

}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "X_BRIDGE",
        mev_id: "MEV-06-026"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-06-026",
        detector_id: "X_BRIDGE"
    }
}
