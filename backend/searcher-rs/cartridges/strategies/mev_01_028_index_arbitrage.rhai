// MEV-01-028 — Index arbitrage
// Detector family: R_BASKET_NAV (DETERMINISTIC_IF_REDEEMABLE)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave A: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Index NAV: NAV = sum_i w_i * V_i (exact mint/redeemption outputs).
//   Pi  = ExecutableRedeemOrMintValue - BasketAcquisitionCost - all_costs.
//   Emit only if mint/redeem or firm unwind exists.
//   Implementation: the basket composition arrives as `pool_data.basket` =
//   #{ components: [#{ pool, weight }, ...], basket_pool: <addr>,
//   basket_token: <addr> }. For q basket units: acquire w_i*q of each
//   component on its pool with the EXACT inverse quote
//   cpmm_in(y) = y*r_in / (gamma*(r_out - y)), redeem q, sell via basket_pool
//   with the exact cpmm_out quote. Pi(q) is maximised via golden-section.
//
// Zero-Mocks / Fail-Honest: no composition wired => is_opportunity:false with
// reason "basket_state_unavailable" (the mint/redeem feed is not yet bound to
// the route pipeline — the math is live the moment it is). NEVER fabricated.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Fee default 0.30% = 30 bps -> gamma=0.997;
// coarse gas precheck GAS_HINT_USD=5.0; authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Index arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "route_graph_engine",
        mev_id: "MEV-01-028",
        detector_id: "R_BASKET_NAV",
        execution_class: "DETERMINISTIC_IF_REDEEMABLE",
        min_legs: 2,
        max_legs: 16,
        primary_operators: [13, 19, 21],
        secondary_operators: [8, 11, 16, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote (sell side): dy = r1*(gamma*dx) / (r0 + gamma*dx)
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// EXACT inverse quote (acquisition side): token_in needed to extract y
// token_out from the pool. Inverts cpmm_out analytically:
//   y = r_out*gamma*x / (r_in + gamma*x)  =>  x = y*r_in / (gamma*(r_out - y))
// Returns -1.0 when y >= r_out (pool cannot supply y — hard fail-honest).
fn cpmm_in(y, r_in, r_out, fee_bps) {
    if y >= r_out { return -1.0; }
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    (y * r_in) / (gamma * (r_out - y))
}

fn evaluate_opportunity(pool_data) {
    // -- Index composition gate (identity: mint/redeem or no index arb) ----------
    let basket = pool_data.index;
    if basket == () { return no_opp("index_composition_unavailable"); }
    let components = basket.components;
    if components == () || components.len() < 2 { return no_opp("index_state_invalid"); }
    let basket_pool = basket.basket_pool;
    let basket_token = basket.basket_token;
    if basket_pool == () || basket_pool == "" || basket_token == () || basket_token == "" {
        return no_opp("index_state_invalid");
    }
    let k = components.len();

    // -- Component acquisition state (exact reserves, fail-honest) ---------------
    let w = [];        // component weight
    let rin = [];      // pool reserve of the quote token being paid
    let rout = [];     // pool reserve of the component token being acquired
    let fees = [];     // fee_bps per component pool
    let w_sum = 0.0;
    for i in 0..k {
        let comp = components[i];
        let pool = comp.pool;
        let weight = comp.weight;
        if pool == () || pool == "" { return no_opp("component_pool_missing"); }
        if weight == () || weight <= 0.0 { return no_opp("index_state_invalid"); }
        let res = get_reserves(pool);
        if res == () { return no_opp("missing_reserves"); }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
        // Acquisition pays the quote side to extract the component side; the
        // pool's token0 is the component by convention of the basket registry
        // (component = token0, quote = token1). Orient accordingly.
        let ri = r1;
        let ro = r0;
        if res.token0_addr != () && comp.token != () {
            let t0 = res.token0_addr;
            if comp.token != t0 { ri = r0; ro = r1; }
        }
        w.push(weight);
        rin.push(ri);
        rout.push(ro);
        let f = if comp.fee_bps != () { comp.fee_bps } else { 30 };
        fees.push(f);
        w_sum += weight;
    }
    if w_sum <= 0.0 { return no_opp("index_state_invalid"); }

    // -- Redemption-sale state (sell q basket units via basket_pool) ------------
    let bres = get_reserves(basket_pool);
    if bres == () { return no_opp("missing_reserves"); }
    let br0 = bres.r0.to_float();
    let br1 = bres.r1.to_float();
    if br0 <= 0.0 || br1 <= 0.0 { return no_opp("missing_reserves"); }
    let b_ri = br0;
    let b_ro = br1;
    if bres.token0_addr != () && basket_token != bres.token0_addr {
        b_ri = br1;
        b_ro = br0;
    }
    let b_fee = if basket.fee_bps != () { basket.fee_bps } else { 30 };

    // Decimals of the basket token for a sane sizing bracket (fail-honest).
    let tm = get_token_meta(basket_token);
    if tm == () { return no_opp("missing_token_meta"); }
    let dec0 = tm.decimals;
    let base_unit = math_pow(10.0, dec0.to_float());

    // -- Marginal prefilter: redeem rate vs component NAV, fees both sides ------
    // Marginal redeem proceeds per basket unit: gamma_b * (b_ro/b_ri).
    // Marginal acquisition cost per basket unit: sum_i (w_i/w_sum)*(rate_i/gamma_i).
    // Impact only worsens both sides, so marginal <= 0 => no size can pay.
    let nav_spot = 0.0;
    for i in 0..k {
        let rate = rout[i] / rin[i];
        let gamma_i = 1.0 - fees[i].to_float() / 10000.0;
        nav_spot += (w[i] / w_sum) * (rate / gamma_i);
    }
    let redeem_rate = (1.0 - b_fee.to_float() / 10000.0) * (b_ro / b_ri);
    if redeem_rate <= nav_spot { return no_opp("prefilter_non_positive"); }

    // -- Executable bracket (component depth: y_i = (w_i/w_sum)*q <= 0.5*r_out_i)
    let q_hi = 0.5 * b_ri;
    for i in 0..k {
        let comp_cap = 0.5 * rout[i] / (w[i] / w_sum);
        q_hi = math_min(q_hi, comp_cap);
    }
    if q_hi <= 0.0 { return no_opp("component_depth_insufficient"); }
    let x_lo = base_unit * 0.01;
    if q_hi < x_lo { return no_opp("component_depth_insufficient"); }
    let x_hi = q_hi;

    // -- Compose Pi(q) and maximise via golden-section ---------------------------
    let gr = 0.6180339887498949;  // golden ratio conjugate (phi-1)
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, w, w_sum, rin, rout, fees, b_ri, b_ro, b_fee);
    let fd = profit_at(d, w, w_sum, rin, rout, fees, b_ri, b_ro, b_fee);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = profit_at(d, w, w_sum, rin, rout, fees, b_ri, b_ro, b_fee); }
        else        { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = profit_at(c, w, w_sum, rin, rout, fees, b_ri, b_ro, b_fee); }
    }
    let x_star = (a + b) / 2.0;
    let profit_tok = profit_at(x_star, w, w_sum, rin, rout, fees, b_ri, b_ro, b_fee);

    if profit_tok <= -1.0e29 { return no_opp("component_depth_insufficient"); }
    if profit_tok <= 0.0 { return no_opp("impact_zero"); }

    // Gross profit hint in USD for the net gate precheck (fail-honest on price).
    let px = get_token_price_usd(basket_token);
    let profit_usd = 0.0;
    if px != () && px > 0.0 {
        profit_usd = (profit_tok / base_unit) * px;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    // Optional operator evidence (confidence modulation only; never required,
    // never fabricated).
    let conf = 0.7;  // full component + redemption state present
    let ev = get_math_evidence("MEV-01-028");
    if ev != () && ev.confidence != () {
        conf = math_max(0.0, math_min(1.0, (conf + ev.confidence) / 2.0));
    }

    #{
        is_opportunity: true,
        estimated_profit: profit_tok / base_unit,   // gross, basket token units
        confidence: conf,
        urgency: "immediate",
        reason: "index_nav_mint_redeem_profit",
        detector_id: "R_BASKET_NAV",
        mev_id: "MEV-01-028",
        optimal_amount_in: x_star / base_unit,
        components: k,
        profit_usd_hint: profit_usd
    }
}

// Pi(q) in basket-token units: exact redemption sale (cpmm_out on basket_pool)
// minus the exact acquisition cost of w_i/w_sum*q of every component
// (analytic inverse quote cpmm_in). Depth exhaustion => -1e30 sentinel.
fn profit_at(q, w, w_sum, rin, rout, fees, b_ri, b_ro, b_fee) {
    let proceeds = cpmm_out(q, b_ri, b_ro, b_fee);
    let cost = 0.0;
    for i in 0..w.len() {
        let y = (w[i] / w_sum) * q;
        let c = cpmm_in(y, rin[i], rout[i], fees[i]);
        if c < 0.0 { return -1.0e30; }
        cost += c;
    }
    proceeds - cost
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "R_BASKET_NAV",
        mev_id: "MEV-01-028"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-01-028",
        detector_id: "R_BASKET_NAV"
    }
}
