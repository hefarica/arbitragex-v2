// MEV-05-002 — DEX–CEX spot arbitrage
// Detector family: C_CEXDEX (EXTERNAL_DATA_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave C: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Π(q)=CEX_bid_VWAP(q)-DEX_buy_exact(q)-CEX/DEX fees-transfer/hedge costs, or reverse direction. Require firm depth and settlement/inventory model.
// Primary operators (evidence only, math-engine): [8, 10, 23, 21]
// Secondary operators (evidence only): [11, 13, 16, 22]
//
// Zero-Mocks / Fail-Honest: the external anchor rides the documented
// pool_data payload below + the runner host bindings (get_reserves,
// get_token_meta, get_token_price_usd, get_block_number, get_timestamp).
// Missing feed/reserves/decimals/prices => is_opportunity:false + reason.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below.
fn init_strategy() {
    #{
        name: "DEX–CEX spot arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "cex_external_engine",
        mev_id: "MEV-05-002",
        detector_id: "C_CEXDEX",
        execution_class: "EXTERNAL_DATA_REQUIRED",
        min_legs: 2,
        max_legs: 8,
        primary_operators: [8, 10, 23, 21],
        secondary_operators: [11, 13, 16, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_token_price_usd", "get_block_number", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// Pi(x): buy x base on the CEX at the gross ask, sell on-chain (exact CPMM
// composition). x in base-token base units, Pi in quote-token base units.
fn profit_at(x, rin, rout, fees, ask_gross, bu_q, bu_b) {
    let amt = x;
    for i in 0..rin.len() {
        amt = cpmm_out(amt, rin[i], rout[i], fees[i]);
    }
    amt - (x / bu_b) * ask_gross * bu_q
}
fn evaluate_opportunity(pool_data) {
    // -- External anchor gate: the CEX/order-book feed this detector prices ----
    // against. Rides pool_data.cex; no pipeline binding populates it today, so
    // the cartridge waits fail-honest (RULE 00 / R8). Payload shape when it
    // lands:
    //   #{ venue, base_token, quote_token, bid_px, bid_depth (base human),
    //      ask_px, ask_depth (base human), fee_bps (taker, default 10),
    //      ts (unix sec), mark_px / expiry_ts / carry_rate_annual (futures),
    //      funding_rate / funding_interval_sec / horizon_sec (perp),
    //      bid_levels: [[px, qty], ...] (order-book VWAP variant) }
    // Multi-venue variants read pool_data.cex_venues (array of the same maps).
    let cx = pool_data.cex;
    if cx == () { return no_opp("cex_feed_unavailable"); }
    if cx.ts == () { return no_opp("cex_feed_invalid"); }
    let base = cx.base_token;
    let quote = cx.quote_token;
    if base == () || base == "" || quote == () || quote == "" { return no_opp("cex_feed_invalid"); }
    let bid = cx.bid_px;
    let depth = cx.bid_depth;
    if bid == () || bid <= 0.0 || depth == () || depth <= 0.0 { return no_opp("cex_feed_invalid"); }
    let cex_fee_bps = if cx.fee_bps != () { cx.fee_bps } else { 10 };
    if get_timestamp() - cx.ts > 30 { return no_opp("cex_feed_stale"); }
    let ask = cx.ask_px;
    let ask_depth = cx.ask_depth;
    if ask == () || ask <= 0.0 || ask_depth == () || ask_depth <= 0.0 { return no_opp("cex_feed_invalid"); }

    // -- On-chain executable leg(s), live reserves (fail-honest R8) -------------
    let route = pool_data.route;
    if route == () { return no_opp("missing_route"); }
    let n = route.len();
    if n < 1 || n > 2 { return no_opp("route_shape_out_of_bounds"); }

    let rin = [];
    let rout = [];
    let fees = [];
    let head = get_block_number();
    for i in 0..n {
        let leg = route[i];
        let pool = leg.pool;
        if pool == () || pool == "" { return no_opp("missing_pool_address"); }
        let res = get_reserves(pool);
        if res == () { return no_opp("missing_reserves"); }
        let r0 = res.r0.to_float();
        let r1 = res.r1.to_float();
        if r0 <= 0.0 || r1 <= 0.0 { return no_opp("missing_reserves"); }
        let ri = r0;
        let ro = r1;
        if res.token0_addr != () && leg.token_in != () {
            if leg.token_in != res.token0_addr { ri = r1; ro = r0; }
        }
        rin.push(ri);
        rout.push(ro);
        let f = if leg.fee_bps != () { leg.fee_bps } else { 30 };
        fees.push(f);
        if res.block == () { return no_opp("dex_state_stale"); }
        let lag = head - res.block;
        if lag < 0 || lag > 2 { return no_opp("dex_state_stale"); }
    }
    let token_in0 = route[0].token_in;
    let token_out_last = route[n - 1].token_out;
    if token_in0 != base || token_out_last != quote { return no_opp("route_venue_mismatch"); }

    let tmq = get_token_meta(quote);
    let tmb = get_token_meta(base);
    if tmq == () || tmb == () { return no_opp("missing_token_meta"); }
    let bu_q = math_pow(10.0, tmq.decimals.to_float());
    let bu_b = math_pow(10.0, tmb.decimals.to_float());

    // Fee-adjusted marginal executable price: quote human per base human.
    let m_prod = 1.0;
    for i in 0..n {
        m_prod *= (1.0 - fees[i].to_float() / 10000.0) * (rout[i] / rin[i]);
    }
    // m_prod * bu_q / bu_b = route-out human per route-in human. On a buy
    // route (in=quote, out=base) that is base-per-quote, so the pool BUY
    // price of the base (quote per base) is its inverse; on a sell route
    // (in=base, out=quote) it already is quote-per-base.
    let p_pool = m_prod * bu_q / bu_b;
    if token_in0 == quote {
        p_pool = 1.0 / (m_prod * bu_q / bu_b);
    }
    let ask_gross = ask * (1.0 + cex_fee_bps.to_float() / 10000.0);
    if p_pool <= ask_gross { return no_opp("no_cex_edge"); }

    // Size by golden section: Pi(x) = Q_sell(x) - CEX ask cost, x in base units.
    let x_lo = bu_b * 0.01;
    let x_cap = math_max(bu_b * 1.0, rin[0] * 0.05);
    let x_hi = math_min(x_cap, ask_depth * bu_b);
    if x_hi <= x_lo { return no_opp("cex_liquidity_insufficient"); }
    let gr = 0.6180339887498949;
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = profit_at(c, rin, rout, fees, ask_gross, bu_q, bu_b);
    let fd = profit_at(d, rin, rout, fees, ask_gross, bu_q, bu_b);
    for _it in 0..40 {
        if fc < fd {
            a = c; c = d; fc = fd;
            d = a + gr * (b - a);
            fd = profit_at(d, rin, rout, fees, ask_gross, bu_q, bu_b);
        } else {
            b = d; d = c; fd = fc;
            c = b - gr * (b - a);
            fc = profit_at(c, rin, rout, fees, ask_gross, bu_q, bu_b);
        }
    }
    let x_star = (a + b) / 2.0;
    let profit_q = profit_at(x_star, rin, rout, fees, ask_gross, bu_q, bu_b);
    if profit_q <= 0.0 { return no_opp("impact_zero"); }

    let px_q = get_token_price_usd(tmq.symbol);
    let profit_usd = 0.0;
    if px_q != () && px_q > 0.0 {
        profit_usd = (profit_q / bu_q) * px_q;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    return #{
        is_opportunity: true,
        estimated_profit: profit_q / bu_q,
        confidence: 0.65,
        urgency: "immediate",
        reason: "dex_cex_spot_spread_profit",
        detector_id: "C_CEXDEX",
        mev_id: "MEV-05-002",
        optimal_amount_in: x_star / bu_b,
        cex_anchor_px: ask,
        dex_marginal_px: p_pool,
        profit_usd_hint: profit_usd
    }

}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "C_CEXDEX",
        mev_id: "MEV-05-002"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-05-002",
        detector_id: "C_CEXDEX"
    }
}
