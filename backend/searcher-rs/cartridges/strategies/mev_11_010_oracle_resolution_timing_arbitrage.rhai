        mev_id: "MEV-11-010",
        detector_id: "OBSERVE",
        execution_class: "OBSERVE_ONLY",
        min_legs: 2,
        max_legs: 12,
        primary_operators: [10, 11],
        secondary_operators: [22],
        triggers: ["new_block"],
        required_bindings: [],
