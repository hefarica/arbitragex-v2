}



fn evaluate_opportunity(pool_data) {
    // Manifest law (OBSERVE family): "No is_opportunity=true. Emit structured
    // evidence only until a lawful, deterministic, executable settlement path
    // and required public/authorized data are present."
    // Resolution timing requires finalized oracle rounds; timing edge is not deterministically settleable by this searcher, evidence only.
    let n = 0;
    let platform = "";
    let resolution = "";
    if pool_data.prediction != () {
        if pool_data.prediction.outcomes != () { n = pool_data.prediction.outcomes.len(); }
        platform = pool_data.prediction.platform;
        resolution = pool_data.prediction.resolution_source;
    }
    #{ is_opportunity: false, estimated_profit: 0.0, confidence: 0.0,
        urgency: "monitor", reason: "observe_only_structured_evidence",
        detector_id: "OBSERVE", mev_id: "MEV-11-010",
        evidence_outcomes: n, evidence_platform: platform,
        evidence_resolution_source: resolution }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "OBSERVE",
        mev_id: "MEV-11-010"
    }
}

fn build_payload(opportunity) {
