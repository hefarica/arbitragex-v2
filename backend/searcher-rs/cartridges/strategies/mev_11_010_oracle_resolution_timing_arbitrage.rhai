fn init_strategy() {
    #{
        name: "Oracle-resolution timing arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Oracle freshness/round semantics are required; oracle delta alone is not an opportunity. Observe-only unless resolution source is public, finalized and the payout claim is settleable.",
