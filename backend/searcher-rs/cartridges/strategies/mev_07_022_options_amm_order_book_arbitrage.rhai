// MEV-07-022 — Options AMM–order-book arbitrage
// Detector family: D_OPTIONS_SURFACE (DERIVATIVE_DATA_REQUIRED)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave C: real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Enforce strike monotonicity/convexity and calendar consistency on executable bid/asks; e.g. equally spaced K: C(K1)-2C(K2)+C(K3)>=0. Trade violating butterfly/calendar only if all legs executable.
// Primary operators (evidence only, math-engine): [13, 8, 19]
// Secondary operators (evidence only): [11, 14, 22]
//
// Zero-Mocks / Fail-Honest: the external anchor rides the documented
// pool_data payload below + the runner host bindings (get_reserves,
// get_token_meta, get_token_price_usd, get_block_number, get_timestamp).
// Missing feed/reserves/decimals/prices => is_opportunity:false + reason.
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below.
fn init_strategy() {
    #{
        name: "Options AMM–order-book arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "derivatives_engine",
        mev_id: "MEV-07-022",
        detector_id: "D_OPTIONS_SURFACE",
        execution_class: "DERIVATIVE_DATA_REQUIRED",
        min_legs: 2,
        max_legs: 6,
        primary_operators: [13, 8, 19],
        secondary_operators: [11, 14, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_token_price_usd", "get_block_number", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// Pi(x): buy the option on the vAMM (exact CPMM, token_in = quote), sell at
// the net order-book bid. x and Pi in quote-token base units.
fn profit_at(x, vwi, vwo, vfee, unit, bu_q, bu_b) {
    let amt = cpmm_out(x, vwi, vwo, vfee);
    (amt / bu_b) * unit * bu_q - x
}
fn evaluate_opportunity(pool_data) {
    // -- Derivatives feed gate: the mark/funding/options book this detector ----
    // prices against. Rides pool_data.derivatives; no pipeline binding
    // populates it today, so the cartridge waits fail-honest (RULE 00 / R8).
    // Payload shape when it lands:
    //   #{ kind: "perpetual"|"future"|"option", venue, base_token,
    //      quote_token, mark_px, index_px (optional), funding_rate (signed,
    //      per interval), funding_interval_sec (default 28800), horizon_sec,
    //      expiry_ts, carry_rate_annual, rate_annual (discounting), fee_bps
    //      (taker, default 10), size (default position bracket, base human),
    //      ts, vamm_pool + vamm_fee_bps (on-chain vAMM variants),
    //      liquidation: { size, reward_usd }, nav_px, target_leverage,
    //      current_leverage, settle_px,
    //      peer: { ...same shape... } (cross-venue/cross-maturity variants),
    //      options: { strike, expiry_ts, call_bid, call_ask, put_bid,
    //      put_ask, delta, model_px, strikes: [K1,...], call_bids: [...],
    //      call_asks: [...], box_strike, box_call_bid, box_call_ask,
    //      box_put_bid, box_put_ask } }
    let d = pool_data.derivatives;
    if d == () { return no_opp("funding_feed_unavailable"); }
    let base = d.base_token;
    let quote = d.quote_token;
    if base == () || base == "" || quote == () || quote == "" { return no_opp("derivative_state_invalid"); }
    let opt = d.options;
    if opt == () { return no_opp("derivative_state_invalid"); }
    let k = opt.strike;
    if k == () || k <= 0.0 { return no_opp("derivative_state_invalid"); }
    let c_bid = opt.call_bid;
    let c_ask = opt.call_ask;
    let p_bid = opt.put_bid;
    let p_ask = opt.put_ask;
    if c_bid == () || c_ask == () || p_bid == () || p_ask == () { return no_opp("derivative_state_invalid"); }
    if c_bid <= 0.0 || c_ask <= 0.0 || p_bid <= 0.0 || p_ask <= 0.0 { return no_opp("derivative_state_invalid"); }
    let oexp = opt.expiry_ts;
    if oexp == () { return no_opp("derivative_state_invalid"); }
    if get_timestamp() >= oexp { return no_opp("contract_expired"); }
    let tau_y = (oexp - get_timestamp()).to_float() / (365.0 * 86400.0);
    let rate = if d.rate_annual != () { d.rate_annual } else { 0.0 };
    let pvk = k * math_exp(-rate.to_float() * tau_y);

    // Options AMM leg (live on-chain pool) vs the order-book bid.
    let vpool = d.vamm_pool;
    if vpool == () || vpool == "" { return no_opp("derivative_state_invalid"); }
    let vres = get_reserves(vpool);
    if vres == () { return no_opp("missing_reserves"); }
    let vr0 = vres.r0.to_float();
    let vr1 = vres.r1.to_float();
    if vr0 <= 0.0 || vr1 <= 0.0 { return no_opp("missing_reserves"); }
    let tmq = get_token_meta(quote);
    let tmb = get_token_meta(base);
    if tmq == () || tmb == () { return no_opp("missing_token_meta"); }
    let bu_q = math_pow(10.0, tmq.decimals.to_float());
    let bu_b = math_pow(10.0, tmb.decimals.to_float());
    // Buy side of the vAMM: token_in = quote (token1 side by default).
    let vwi = vr1;
    let vwo = vr0;
    if vres.token0_addr != () && quote == vres.token0_addr { vwi = vr0; vwo = vr1; }
    let vfee = if d.vamm_fee_bps != () { d.vamm_fee_bps } else { 30 };
    let tkr_fee = if d.fee_bps != () { d.fee_bps } else { 10 };

    // (vwo/vwi)*bu_q/bu_b is option-human per quote-human; the option price in
    // quote terms is its inverse.
    let p_vamm = 1.0 / ((1.0 - vfee.to_float() / 10000.0) * (vwo / vwi) * bu_q / bu_b);
    let ob_bid_net = c_bid * (1.0 - tkr_fee.to_float() / 10000.0);
    if ob_bid_net <= p_vamm { return no_opp("amm_ob_no_edge"); }

    // Buy the option on the vAMM with x quote units, sell at the net book bid.
    let x_lo = bu_q * 0.01;
    let x_hi = math_max(bu_q * 1.0, vwi * 0.05);
    if x_hi <= x_lo { return no_opp("deriv_liquidity_insufficient"); }
    let gr = 0.6180339887498949;
    let a = x_lo;
    let b = x_hi;
    let c = b - gr * (b - a);
    let dd = a + gr * (b - a);
    let fc = profit_at(c, vwi, vwo, vfee, ob_bid_net, bu_q, bu_b);
    let fd = profit_at(dd, vwi, vwo, vfee, ob_bid_net, bu_q, bu_b);
    for _it in 0..40 {
        if fc < fd {
            a = c; c = dd; fc = fd;
            dd = a + gr * (b - a);
            fd = profit_at(dd, vwi, vwo, vfee, ob_bid_net, bu_q, bu_b);
        } else {
            b = dd; dd = c; fd = fc;
            c = b - gr * (b - a);
            fc = profit_at(c, vwi, vwo, vfee, ob_bid_net, bu_q, bu_b);
        }
    }
    let x_star = (a + b) / 2.0;
    let profit_q = profit_at(x_star, vwi, vwo, vfee, ob_bid_net, bu_q, bu_b);
    if profit_q <= 0.0 { return no_opp("impact_zero"); }
    let px_q = get_token_price_usd(tmq.symbol);
    let profit_usd = 0.0;
    if px_q != () && px_q > 0.0 {
        profit_usd = (profit_q / bu_q) * px_q;
    }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    return #{
        is_opportunity: true,
        estimated_profit: profit_q / bu_q,
        confidence: 0.6,
        urgency: "high",
        reason: "options_amm_order_book_profit",
        detector_id: "D_OPTIONS_SURFACE",
        mev_id: "MEV-07-022",
        optimal_amount_in: x_star / bu_q,
        amm_marginal_px: p_vamm,
        order_book_bid: c_bid,
        profit_usd_hint: profit_usd
    }

}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "D_OPTIONS_SURFACE",
        mev_id: "MEV-07-022"
    }
}

fn build_payload(opportunity) {
    // Payload assembly is the executor's concern downstream; the cartridge
    // declares its intent only. No signer, no broadcast (S32/S33 read-only).
    #{
        target_contract: "0x0000000000000000000000000000000000000000",
        calldata: "0x",
        value_wei: "0",
        gas_limit: 350000,
        max_priority_fee_gwei: 0.0,
        deadline_ts: 0,
        mev_id: "MEV-07-022",
        detector_id: "D_OPTIONS_SURFACE"
    }
}
