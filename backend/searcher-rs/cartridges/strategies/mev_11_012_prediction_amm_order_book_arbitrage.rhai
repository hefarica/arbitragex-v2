// MEV-11-012 — Prediction AMMâ€“order-book arbitrage
// Detector family: M_AMM (DETERMINISTIC_IF_MATCHED_CLAIM)
// Generated by scripts/generate_cartridges_v3.py from the canonical Excel
// (02_CARTRIDGE_MATH_MAP). Universal Cartridge Contract v3.
// RU-5 wave E (G11): real hunting math (fail-honest, RULE 00 / R8).
//
// Detector (economic, per manifest 02_CARTRIDGE_MATH_MAP):
//   Quote conditional-token AMM exactly and compare with firm outcome order-book quotes for identical payout claim; net of split/merge, fees and settlement.
// Primary operators (evidence only, math-engine): [21, 8, 19]
// Secondary operators (evidence only): [11, 22]
//
//   pool_data.prediction — prediction-market book feed (complete-set
//   mechanics, logical relations, prediction AMM; no pipeline binding
//   populates it today, so this cartridge waits fail-honest with
//   prediction_market_feed_unavailable). Shape when it lands:
//   #{ platform, event_ref, resolution_source, collateral_token,
//      fee_bps (taker), split_available, merge_available,
//      outcomes: [#{ id, bid_px, ask_px, depth }]   (collateral per share),
//      peer: #{ platform, event_ref, resolution_source, outcomes: [...] } (003),
//      mutually_exclusive, exhaustive (004),
//      conditions: [#{ id, outcomes: [#{id, bid_px, ask_px, depth}] }] (006),
//      parent: #{ id, bid_px, ask_px }, children: [#{id, bid_px, ask_px}] (007),
//      implies: [#{i, j}] (008),
//      amm: #{ pool, collateral_side (0|1), fee_bps, outcome_idx } (012),
//      ts (unix sec) }
//   All prices are in collateral-token human units per share (sum of a
//   complete set redeems for exactly 1 collateral unit).
//
// Zero-Mocks / Fail-Honest: every number below is computed from the documented
// payload + the runner host bindings (get_reserves / get_token_meta /
// get_token_price_usd / get_block_number / get_timestamp / get_math_evidence).
// Missing feed/reserves/decimals/prices => is_opportunity:false + the exact
// machine-readable reason, never a fabricated number (RULE 00 / R8).
//
// NOTE: the runner invokes evaluate_opportunity with an EMPTY scope, so Rhai
// global `const`s are NOT visible inside functions. All config is inlined as
// literals in each function below. (Coarse gas precheck GAS_HINT_USD=5.0; the
// authoritative net gate is downstream.)

fn init_strategy() {
    #{
        name: "Prediction AMMâ€“order-book arbitrage",
        version: "3.0.0",
        author: "arbx-cartridge-generator-v3",
        description: "Use family detector exactly; strategy identity constrains route shape, venue/protocol mix, trigger and dependencies from the Excel row.",
        category: "prediction_engine",
        mev_id: "MEV-11-012",
        detector_id: "M_AMM",
        execution_class: "DETERMINISTIC_IF_MATCHED_CLAIM",
        min_legs: 2,
        max_legs: 12,
        primary_operators: [21, 8, 19],
        secondary_operators: [11, 22],
        triggers: ["new_block"],
        required_bindings: ["get_reserves", "get_token_meta", "get_timestamp"],
        target_chains: [],
        min_eval_interval_ms: 250,
        config_schema: #{
            enabled: #{ "type": "bool", "default": true, "editable": true },
            min_profit_usd: #{ "type": "number", "default": 0.0, "editable": true },
            max_slippage_pct: #{ "type": "number", "default": 1.0, "editable": true },
            max_price_impact_pct: #{ "type": "number", "default": 5.0, "editable": true },
            max_gas_usd: #{ "type": "number", "default": 50.0, "editable": true }
        }
    }
}

// exact-in CPMM quote for one leg: dy = r1*(gamma*dx) / (r0 + gamma*dx)
// r0 = reserve of token_in, r1 = reserve of token_out (same decimal base units).
fn cpmm_out(x, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    let dxg = gamma * x;
    (r_out * dxg) / (r_in + dxg)
}

// exact-out inversion for one leg: the exact-in amount x required to receive
// y out: x = (r_in*y) / (gamma*(r_out - y))  (undefined if y >= r_out).
fn cpmm_in_for_out(y, r_in, r_out, fee_bps) {
    let gamma = (10000.0 - fee_bps.to_float()) / 10000.0;
    if y >= r_out { return -1.0; }
    (r_in * y) / (gamma * (r_out - y))
}

// Pi(q) in collateral human units: best of (buy AMM / sell book bid) and
// (buy book ask / sell into AMM) for q shares of the same payout claim.
fn amm_book_pi(q, r_coll, r_shares, fee, bu, bid_px, ask_px, book_fee) {
    let cost_a = cpmm_in_for_out(q, r_coll, r_shares, fee);
    let pi_a = -1000000.0;
    if cost_a >= 0.0 { pi_a = bid_px * q * (1.0 - book_fee / 10000.0) - cost_a / bu; }
    let out_b = cpmm_out(q, r_shares, r_coll, fee);
    let pi_b = out_b / bu - ask_px * q * (1.0 + book_fee / 10000.0);
    math_max(pi_a, pi_b)
}

fn evaluate_opportunity(pool_data) {
    // -- Prediction feed gate (RULE 00: no book, no trade) ----------------------
    let pm = pool_data.prediction;
    if pm == () { return no_opp("prediction_market_feed_unavailable"); }
    if pm.ts == () { return no_opp("prediction_feed_invalid"); }
    if get_timestamp() - pm.ts > 60 { return no_opp("prediction_feed_stale"); }
    let am = pm.amm;
    if am == () || am.pool == () || am.pool == "" { return no_opp("prediction_amm_unavailable"); }
    let outs = pm.outcomes;
    if outs == () || outs.len() < 1 { return no_opp("no_outcome_book"); }
    let oidx = if am.outcome_idx != () { am.outcome_idx } else { 0 };
    if oidx < 0 || oidx >= outs.len() { return no_opp("prediction_amm_unavailable"); }
    let o = outs[oidx];
    if o.bid_px == () || o.bid_px <= 0.0 || o.ask_px == () || o.ask_px <= 0.0 {
        return no_opp("amm_claim_book_unavailable");
    }

    let res = get_reserves(am.pool);
    if res == () { return no_opp("prediction_amm_unavailable"); }
    let fee = if am.fee_bps != () { am.fee_bps } else { 30 };
    let r_coll = res.r0.to_float();
    let r_shares = res.r1.to_float();
    if am.collateral_side == 1 { r_coll = res.r1.to_float(); r_shares = res.r0.to_float(); }
    if r_coll <= 0.0 || r_shares <= 0.0 { return no_opp("prediction_amm_unavailable"); }
    let tmc = get_token_meta(pm.collateral_token);
    if tmc == () { return no_opp("missing_collateral_meta"); }
    let bu = math_pow(10.0, tmc.decimals.to_float());
    let book_fee = if pm.fee_bps != () { pm.fee_bps.to_float() } else { 0.0 };

    // Size q (shares) by golden section over BOTH directions:
    //   A) buy q on the AMM curve, sell at the firm book bid;
    //   B) buy q at the firm book ask, sell into the AMM curve.
    let depth = 1.0;
    if o.depth != () && o.depth > 0.0 { depth = o.depth; }
    let q_hi = math_min(depth * bu, r_shares * 0.2);

    let bid_px = o.bid_px;
    let ask_px = o.ask_px;
    let gr = 0.6180339887498949;
    let a = bu * 0.001;
    let b = q_hi;
    let c = b - gr * (b - a);
    let d = a + gr * (b - a);
    let fc = amm_book_pi(c, r_coll, r_shares, fee, bu, bid_px, ask_px, book_fee);
    let fd = amm_book_pi(d, r_coll, r_shares, fee, bu, bid_px, ask_px, book_fee);
    for _it in 0..40 {
        if fc < fd { a = c; c = d; fc = fd; d = a + gr * (b - a); fd = amm_book_pi(d, r_coll, r_shares, fee, bu, bid_px, ask_px, book_fee); }
        else { b = d; d = c; fd = fc; c = b - gr * (b - a); fc = amm_book_pi(c, r_coll, r_shares, fee, bu, bid_px, ask_px, book_fee); }
    }
    let q_star = (a + b) / 2.0;
    let profit_c = amm_book_pi(q_star, r_coll, r_shares, fee, bu, bid_px, ask_px, book_fee);
    if profit_c <= 0.0 { return no_opp("amm_book_no_edge"); }
    // Collateral USD hint for the net gate precheck (fail-honest on miss).
    let tmc = get_token_meta(pm.collateral_token);
    if tmc == () { return no_opp("missing_collateral_meta"); }
    let px = get_token_price_usd(tmc.symbol);
    let profit_usd = 0.0;
    if px != () && px > 0.0 { profit_usd = profit_c * px; }
    if profit_usd > 0.0 && profit_usd < 5.0 { return no_opp("below_gas_threshold"); }

    #{ is_opportunity: true, estimated_profit: profit_c, confidence: 0.6,
        urgency: "immediate", reason: "prediction_amm_vs_book_profit", detector_id: "M_AMM",
        mev_id: "MEV-11-012", profit_usd_hint: profit_usd, shares: q_star / bu }
}

fn no_opp(reason) {
    #{
        is_opportunity: false,
        estimated_profit: 0.0,
        confidence: 0.0,
        urgency: "monitor",
        reason: reason,
        detector_id: "M_AMM",
        mev_id: "MEV-11-012"
    }
}

