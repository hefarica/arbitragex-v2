{
  "name": "@arbx/api-server",
  "version": "0.1.0",
  "private": true,
  "description": "ArbitrageX v2 — api-server/gateway. Admin endpoints (killswitch, config) + upstream status aggregator.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/services',{recursive:true});for(const f of ['uniswap-tokenlist.json','coingecko-coinslist.json']){fs.copyFileSync('src/services/'+f,'dist/services/'+f)}\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'lint placeholder'"
  },
  "dependencies": {
    "@arbx/shared": "*",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.3.2",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
