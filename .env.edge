# ============================================================
# OMEGA EDGE ENVIRONMENT — GO-LIVE CONFIGURATION
# ArbitrageX-V2 Multi-Chain Arbitrage Protocol
# ============================================================
# Ghost Protocol: Capital expuesto controlado > 0
# WARNING: NUNCA commitear este archivo. Esta en .gitignore
# Generado: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
# ============================================================

# ============================================================
# ALCHEMY API KEY (shared across all Alchemy-backed chains)
# ============================================================
ALCHEMY_KEY=your_alchemy_key_here

# ============================================================
# SECTION: CHAIN — Ethereum Mainnet (1)
# ============================================================
CHAIN_ID_1=1
RPC_HTTP_1=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
RPC_WS_1=wss://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
EXPLORER_1=https://etherscan.io
VERIFIER_1=etherscan
CHAIN_NAME_1=ethereum
GAS_PRICE_GWEI_1=auto
EIP1559_1=true
PRIORITY_FEE_GWEI_1=0.5

# ============================================================
# SECTION: CHAIN — Arbitrum One (42161)
# ============================================================
CHAIN_ID_42161=42161
RPC_HTTP_42161=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
RPC_WS_42161=wss://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
EXPLORER_42161=https://arbiscan.io
VERIFIER_42161=arbiscan
CHAIN_NAME_42161=arbitrum
GAS_PRICE_GWEI_42161=auto
EIP1559_42161=true
PRIORITY_FEE_GWEI_42161=0.1

# ============================================================
# SECTION: CHAIN — Optimism (10)
# ============================================================
CHAIN_ID_10=10
RPC_HTTP_10=https://opt-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
RPC_WS_10=wss://opt-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
EXPLORER_10=https://optimistic.etherscan.io
VERIFIER_10=optimisticEtherscan
CHAIN_NAME_10=optimism
GAS_PRICE_GWEI_10=auto
EIP1559_10=true
PRIORITY_FEE_GWEI_10=0.001

# ============================================================
# SECTION: CHAIN — Base (8453)
# ============================================================
CHAIN_ID_8453=8453
RPC_HTTP_8453=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
RPC_WS_8453=wss://base-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
EXPLORER_8453=https://basescan.org
VERIFIER_8453=basescan
CHAIN_NAME_8453=base
GAS_PRICE_GWEI_8453=auto
EIP1559_8453=true
PRIORITY_FEE_GWEI_8453=0.001

# ============================================================
# SECTION: CHAIN — Polygon PoS (137)
# ============================================================
CHAIN_ID_137=137
RPC_HTTP_137=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
RPC_WS_137=wss://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
EXPLORER_137=https://polygonscan.com
VERIFIER_137=polygonscan
CHAIN_NAME_137=polygon
GAS_PRICE_GWEI_137=auto
EIP1559_137=true
PRIORITY_FEE_GWEI_137=30
MIN_NATIVE_BALANCE_137=20

# ============================================================
# SECTION: CHAIN — BNB Smart Chain (56)
# ============================================================
CHAIN_ID_56=56
RPC_HTTP_56=https://bsc-dataseed.binance.org/
RPC_HTTP_56_FALLBACK=https://bsc-dataseed1.defibit.io/
RPC_HTTP_56_FALLBACK2=https://bsc-dataseed1.ninicoin.io/
RPC_WS_56=wss://bsc-ws-node.nariox.org:443
EXPLORER_56=https://bscscan.com
VERIFIER_56=bscscan
CHAIN_NAME_56=bsc
GAS_PRICE_GWEI_56=5
EIP1559_56=false
MIN_NATIVE_BALANCE_56=0.1

# ============================================================
# SECTION: WALLET TOPOLOGY
# ⚠️  NUNCA commitear private keys. Rellenar en deploy.
# ============================================================

# --- GasSponsor ---
# Fondear con ETH nativo de cada chain para gas de deploys y txs
# Balance recomendado: 0.5 ETH (ETH), 0.1 ETH (L2s), 50 MATIC, 0.5 BNB
GAS_SPONSOR_PRIVATE_KEY=0x...              # <--- RELLENAR EN DEPLOY
GAS_SPONSOR_ADDRESS=0x...                   # <--- RELLENAR EN DEPLOY
GAS_SPONSOR_HD_PATH="m/44'/60'/0'/0/0"      # Ledger path opcional

# --- ExecutionSigner ---
# Balance = 0 SIEMPRE. Solo firma transacciones (meta-txs / flashbots)
# El gas es pagado por el relayer o el contrato via callWithSyncFee
EXECUTION_SIGNER_PRIVATE_KEY=0x...          # <--- RELLENAR EN DEPLOY
EXECUTION_SIGNER_ADDRESS=0x...              # <--- RELLENAR EN DEPLOY
EXECUTION_SIGNER_HD_PATH="m/44'/60'/0'/0/1" # Ledger path opcional

# --- ColdTreasury ---
# Wallet aislada, receptora del yield. NUNCA firma txs on-chain.
# Solo recibe transferencias desde el ExecutionEngine.
COLD_TREASURY_ADDRESS=0x...                 # <--- RELLENAR EN DEPLOY
COLD_TREASURY_HD_PATH="m/44'/60'/0'/0/2"    # Ledger path opcional

# ============================================================
# SECTION: ETHERSCAN / BLOCKSCOUT API KEYS (verificacion)
# ============================================================
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
OPTIMISTIC_ETHERSCAN_KEY=your_optimistic_etherscan_key
BASESCAN_API_KEY=your_basescan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# ============================================================
# SECTION: GHOST PROTOCOL — Risk Controls
# ============================================================
PAPER_MODE=false
KILL_SWITCH_ENABLED=true

# Capital maximo expuesto en operaciones (USD)
INITIAL_CAPITAL_CAP_USD=1000
MAX_CAPITAL_CAP_USD=10000

# Slippage maximo por operacion (basis points)
MAX_SLIPPAGE_BPS=50

# Circuit breakers
CIRCUIT_BREAKER_VOLATILITY_BPS=200
CIRCUIT_BREAKER_GAS_SPIKE_GWEI=500
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3

# Kill switch
AUTO_KILL_ON_ANOMALY=true
MAX_LOSS_BPS=50
EMERGENCY_WITHDRAWAL_ENABLED=true

# ============================================================
# SECTION: MEV RELAYS — Submit transactions
# ============================================================
FLASHBOTS_AUTH_KEY=your_flashbots_auth_key
FLASHBOTS_ENDPOINT=https://relay.flashbots.net
FLASHBOTS_ENDPOINT_GOERLI=https://relay-goerli.flashbots.net

BLOXROUTE_AUTH_KEY=your_bloxroute_auth_key
BLOXROUTE_ENDPOINT=https://api.blxrbdn.com
BLOXROUTE_WS=wss://api.blxrbdn.com/ws

TITAN_AUTH_KEY=your_titan_auth_key
TITAN_ENDPOINT=https://rpc.titanbuilder.xyz
TITAN_WS=wss://rpc.titanbuilder.xyz/ws

# ============================================================
# SECTION: PAGERDUTY / ALERTS / MONITORING
# ============================================================
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key
PAGERDUTY_SERVICE_KEY=your_pagerduty_service_key

OPERATOR_PHONE=+573000000000
OPERATOR_EMAIL=operator@arbitragex.local
OPERATOR_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPERATOR_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Webhook para alertas criticas (Discord/Slack)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ============================================================
# SECTION: DEPLOYMENT FLAGS
# ============================================================
FORGE_OPTIMIZER_RUNS=200
FORGE_VIA_IR=true
FORGE_SOLC_VERSION=0.8.23
FORGE_EXTRA_OUTPUT=abi,abi,devdoc,metadata,storageLayout,evm.bytecode,evm.bytecode.sourceMap

# Gas reporting
FORGE_GAS_REPORT=true
FORGE_GAS_PRICE=auto

