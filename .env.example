# ArbitrageX v2 — Environment variables (EXAMPLE ONLY)
# ---------------------------------------------------
# 1. Copy to `.env` for local dev: `cp .env.example .env`
# 2. NEVER commit `.env`. It is listed in .gitignore.
# 3. In staging/prod, inject via docker secret + envFile (see configs/secrets.policy.md).
# 4. Rotation policy: see configs/secrets.policy.md.
#
# Every value below is a placeholder. Service boot will FAIL FAST with a clear error
# if a required var is missing (validated via shared-rs / shared-ts loaders).

# ------------------ Runtime ------------------
ENV=development
RUST_LOG=info
NODE_ENV=development

# ------------------ Ports ------------------
SELECTOR_PORT=3002
SIM_PORT=3003
RECON_PORT=3004
RELAYS_PORT=3005
API_PORT=8080
EDGE_PORT=8787
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# ------------------ Databases ------------------
# Migrator role (superuser-ish for DDL). Used ONLY by automation/scripts/migrate.sh.
DATABASE_MIGRATOR_URL=postgres://arbx_migrator:REPLACE_ME@postgres:5432/arbitragex
# Read-write role used by services at runtime.
DATABASE_URL=postgres://arbx_rw:REPLACE_ME@postgres:5432/arbitragex
# Read-only role for recon/reporting.
DATABASE_READONLY_URL=postgres://arbx_ro:REPLACE_ME@postgres:5432/arbitragex
# Role passwords — used by migrate.sh (migration 001b) to set Postgres role passwords.
# In dev compose, defaults are injected automatically. In prod, these MUST be set.
ARBX_MIGRATOR_PASSWORD=REPLACE_ME
ARBX_RW_PASSWORD=REPLACE_ME
ARBX_RO_PASSWORD=REPLACE_ME

REDIS_URL=redis://redis:6379
REDIS_DB_DEFAULT=0
REDIS_DB_ADMIN=1

# ------------------ Chain / RPC (placeholders; required in S2+) ------------------
# Never expose publicly. Edge MUST NOT be able to reach these directly.
INTERNAL_GETH_HTTP=http://geth:8545
INTERNAL_GETH_WS=ws://geth:8546
#
# RPC failover discipline (G-RPC-1 / arbx-rpc-failover-discipline):
#   At least TWO providers per chain are recommended; a single provider
#   makes failover impossible and emits a warn log on boot.
#
# Format: comma-separated list of `name=url` tokens, e.g.
#   RPC_HTTP_1=alchemy=https://eth-mainnet.g.alchemy.com/v2/<KEY>,infura=https://mainnet.infura.io/v3/<KEY>,ankr=https://rpc.ankr.com/eth/<KEY>
#
# A bare URL is also accepted (named "primary" automatically) — back-compat
# with single-vendor onboarding fase 5; emits a single-vendor warn at boot.
#
# WS pool follows the same shape:
#   RPC_WS_1=alchemy=wss://eth-mainnet.g.alchemy.com/v2/<KEY>,infura=wss://mainnet.infura.io/ws/v3/<KEY>
RPC_HTTP_1=
RPC_WS_1=
RPC_HTTP_137=
RPC_WS_137=

# ------------------ Simulation (required in S4) ------------------
ANVIL_FORK_URL=
TENDERLY_PROJECT=
TENDERLY_API_KEY=

# ------------------ Flashbots / Relays (required in S5) ------------------
# Private key WITH NO FUNDS at S1. Used only to sign bundles.
FLASHBOTS_SIGNER_KEY=
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
BLOXROUTE_AUTH=
EDEN_AUTH=

# ------------------ Auth / Admin tokens ------------------
# Internal, service-to-service. Rotate on every deploy.
ARBX_EDGE_TOKEN=REPLACE_ME_256_BITS_RANDOM
# Admin endpoints: killswitch, config. Keep separate from edge token.
ARBX_ADMIN_TOKEN=REPLACE_ME_256_BITS_RANDOM
# JWT for frontend → edge authentication.
JWT_SECRET=REPLACE_ME_WITH_64_BYTE_BASE64
JWT_ISSUER=arbitragex-v2
JWT_AUDIENCE=arbitragex-frontend

# ------------------ External safety APIs (S3) ------------------
GOPLUS_API_KEY=
HONEYPOT_IS_API_KEY=

# ------------------ Observability ------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_LOCAL_DEV_ONLY
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090
