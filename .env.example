# ArbitrageX v2 — Environment variables (EXAMPLE ONLY)
# ---------------------------------------------------
# 1. Copy to `.env` for local dev: `cp .env.example .env`
# 2. NEVER commit `.env`. It is listed in .gitignore.
# 3. In staging/prod, inject via docker secret + envFile (see configs/secrets.policy.md).
# 4. Rotation policy: see configs/secrets.policy.md.
#
# Every value below is a placeholder. Service boot will FAIL FAST with a clear error
# if a required var is missing (validated via shared-rs / shared-ts loaders).

# ------------------ Runtime ------------------
ENV=development
RUST_LOG=info
NODE_ENV=development

# ------------------ Ports ------------------
SELECTOR_PORT=3002
SIM_PORT=3003
RECON_PORT=3004
RELAYS_PORT=3005
API_PORT=8080
EDGE_PORT=8787
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# ------------------ Databases ------------------
# Migrator role (superuser-ish for DDL). Used ONLY by automation/scripts/migrate.sh.
DATABASE_MIGRATOR_URL=postgres://arbx_migrator:REPLACE_ME@postgres:5432/arbitragex
# Read-write role used by services at runtime.
DATABASE_URL=postgres://arbx_rw:REPLACE_ME@postgres:5432/arbitragex
# Read-only role for recon/reporting.
DATABASE_READONLY_URL=postgres://arbx_ro:REPLACE_ME@postgres:5432/arbitragex
# OMEGA-8/M3 P1-2: sqlx pool timeouts. Override per service if needed.
# DATABASE_POOL_MAX defaults differ per binary (searcher-rs=8, others=2..5).
DATABASE_POOL_MAX=8
DATABASE_POOL_MIN=1
DATABASE_ACQUIRE_TIMEOUT_SECS=5
DATABASE_IDLE_TIMEOUT_SECS=600
DATABASE_MAX_LIFETIME_SECS=1800
# Role passwords — used by migrate.sh (migration 001b) to set Postgres role passwords.
# In dev compose, defaults are injected automatically. In prod, these MUST be set.
ARBX_MIGRATOR_PASSWORD=REPLACE_ME
ARBX_RW_PASSWORD=REPLACE_ME
ARBX_RO_PASSWORD=REPLACE_ME

REDIS_URL=redis://redis:6379
REDIS_DB_DEFAULT=0
REDIS_DB_ADMIN=1

# ------------------ Chain / RPC (placeholders; required in S2+) ------------------
# Never expose publicly. Edge MUST NOT be able to reach these directly.
INTERNAL_GETH_HTTP=http://geth:8545
INTERNAL_GETH_WS=ws://geth:8546
#
# RPC failover discipline (G-RPC-1 / arbx-rpc-failover-discipline):
#   At least TWO providers per chain are recommended; a single provider
#   makes failover impossible and emits a warn log on boot.
#
# Format: comma-separated list of `name=url` tokens, e.g.
#   RPC_HTTP_1=alchemy=https://eth-mainnet.g.alchemy.com/v2/<KEY>,infura=https://mainnet.infura.io/v3/<KEY>,ankr=https://rpc.ankr.com/eth/<KEY>
#
# A bare URL is also accepted (named "primary" automatically) — back-compat
# with single-vendor onboarding fase 5; emits a single-vendor warn at boot.
#
# WS pool follows the same shape:
#   RPC_WS_1=alchemy=wss://eth-mainnet.g.alchemy.com/v2/<KEY>,infura=wss://mainnet.infura.io/ws/v3/<KEY>
RPC_HTTP_1=
RPC_WS_1=
RPC_HTTP_137=
RPC_WS_137=

# ------------------ DexScreener price oracle (token-enricher) ------------------
# Fills the `no_price_oracle` rejection for LONG-TAIL tokens (anything the
# Chainlink/Alchemy/CoinGecko price_worker doesn't cover). The enricher reads
# its own PG `tokens` table (is_active), queries DexScreener in batches, and
# upserts the best-liquidity USD price into `arbx:token_prices:<chain>` (the
# SAME hash the scanner reads, keyed by the canonical uppercase symbol) — so it
# needs ZERO scanner changes.
#
# Read-only / shadow: NO signer, NO private key, NO broadcast, NO live trading.
# DEFAULT-OFF — the oracle does nothing unless this is exactly `active`.
ARBX_DEXSCREENER_ORACLE=off
# Minimum DexScreener pair liquidity (USD) to trust a price (default 50000).
ARBX_MIN_PRICE_LIQUIDITY_USD=50000
# Poll interval in milliseconds (default 15000; floored at 1000).
DEXSCREENER_PRICE_INTERVAL_MS=15000

# ------------------ GeckoTerminal price + icon tier (token-enricher) ------------------
# Peer of the DexScreener tier. One GeckoTerminal `tokens/multi` call returns BOTH
# price_usd and image_url, so this tier (a) writes prices to the same
# arbx:token_prices:<chain> hash (by symbol) AND (b) produces token icons via
# SETEX arbx:token-icons:{chain}:{addr} — the exact contract the api-server
# token-icon route reads. Reuses ARBX_MIN_PRICE_LIQUIDITY_USD above (compared
# against GeckoTerminal's total_reserve_in_usd).
#
# Read-only / shadow: NO signer, NO key, NO broadcast. DEFAULT-OFF unless `active`.
# To prefer GeckoTerminal over DexScreener for overlapping symbols, run this and
# leave ARBX_DEXSCREENER_ORACLE=off (they are independent peer writers).
ARBX_GECKOTERMINAL_ORACLE=off
# Poll interval ms (default 60000; floored 2000 — free tier is ~30 req/min).
GECKOTERMINAL_PRICE_INTERVAL_MS=60000
# Icon SETEX TTL seconds (default 3600; floored 60).
ARBX_GECKOTERMINAL_ICON_TTL_SECS=3600

# ------------------ Block 2: Pool Enumeration Worker (searcher-rs) ------------------
# Proactive top-TVL pool discovery: pulls ranked pools from The Graph, confirms the
# factory ON-CHAIN, runs a token-safety screen, and persists via the existing
# on-chain hydration path. Widens the DFS/route-discovery search surface beyond
# seeds + reactive discovery — WITHOUT trusting the subgraph blindly.
#
# Read-only / shadow: HTTP GraphQL + eth_call staticcall + DB/Redis/impact_index.
# NO signer, NO capital, NO broadcast, NO executor. DEFAULT-OFF: the worker only
# spawns when set to "shadow" (do NOT use "live"/"on"). A token-unsafe pool is
# skipped; an unrated one is persisted is_active=false (a future tick reactivates
# it once token_enricher rates it); a factory not in the seeded `factories` table
# is skipped (never seeded blindly).
# Pool enumeration worker (proactive reserves cache population). MUST be
# "shadow" in production — without it the searcher can't compute arbitrages
# (reserves_cache_miss on every swap). Shadow = discover pools + fetch reserves
# without emitting. Default OFF only for cold-start dev environments.
ARBX_POOL_ENUM_MODE=shadow

# Cartridge runtime mode. "active" = evaluate + emit opportunities (264
# strategies). "shadow" = evaluate only (no emit). "off" = dormant.
# MUST be "active" or "shadow" in production.
ARBX_CARTRIDGE_MODE=active
POOL_ENUM_INTERVAL_MS=3600000
ARBX_POOL_ENUM_TOP_N=500
ARBX_POOL_ENUM_MIN_TVL_USD=50000
ARBX_POOL_ENUM_MAX_NEW_PER_TICK=50
# Min token_safety_cache score (0..100) for a token to count as safe (default 70).
TOKEN_SAFETY_FLOOR=70
# Top-TVL ranking subgraph endpoint per chain (V3 entity; V2 best-effort same URL).
# ARBX_SUBGRAPH_URL_1=https://gateway.thegraph.com/api/<KEY>/subgraphs/id/<V3_SUBGRAPH_ID>
# Multi-source candidates (CSV; default = all three). Each source has its own
# circuit breaker: N consecutive failures -> quarantine for the cooldown.
ARBX_POOL_ENUM_SOURCES=thegraph,defillama,geckoterminal
ARBX_POOL_ENUM_SOURCE_TIMEOUT_MS=15000
ARBX_POOL_ENUM_CIRCUIT_FAILURES=3
ARBX_POOL_ENUM_CIRCUIT_COOLDOWN_MS=900000
# DeFiLlama yields-pools + GeckoTerminal pools base URLs (override for testing).
DEFILLAMA_BASE_URL=https://yields.llama.fi
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# ------------------ Confidence scoring (bayesian + kelly, observe-only) ------------------
# Wires bayesian_filter + kelly_sizing into the per-opportunity scanner path: it
# produces + logs a ConfidenceScore (scoring.confidence_attached) on every paper
# opportunity. OBSERVE-ONLY — it does NOT gate emission and NEVER moves capital
# (recommended size is an advisory paper figure; no signer/broadcast).
ARBX_BAYESIAN_PRIOR_ALPHA=2
ARBX_BAYESIAN_PRIOR_BETA=2
ARBX_BAYESIAN_MIN_POSTERIOR=0.55
ARBX_BAYESIAN_MAX_STD=0.25
ARBX_KELLY_FRACTION=0.05
ARBX_SCORING_GAIN_ON_WIN=2.0
ARBX_SCORING_LOSS_ON_LOSS=1.0
ARBX_PAPER_BANKROLL_WEI=1000000000000000000

# ------------------ Gate C scoring pipeline + persistence (paper telemetry) ------------------
# Wires the Bayesian + Kelly primitives into the REAL paper opportunity emission
# path (OpportunityEmitter::emit_accepted): produces a ConfidenceScore per opp and
# XADDs it to arbx:scoring:scored (non-fatal, NEVER blocks emission). A passive
# api-server archiver persists it into scored_opportunities (migration 097), and
# GET /api/v1/scoring/status derives the dashboard blocker states from that evidence.
# Shadow/paper/read-only: NO signer, NO broadcast, NO capital. recommended_usd is a
# HYPOTHETICAL paper figure (ARBX_KELLY_MAX_CAPITAL_USD), never real money.
#
# The Bayesian/Kelly tuning knobs (ARBX_BAYESIAN_MIN_POSTERIOR, ARBX_BAYESIAN_MAX_STD,
# ARBX_KELLY_FRACTION, ARBX_SCORING_GAIN_ON_WIN, ARBX_SCORING_LOSS_ON_LOSS) are defined
# in the Confidence scoring block above and shared by the Gate-C pipeline (its code
# defaults when those are unset are 0.50 / 1.00 / 0.25 / 2.0 / 1.0).
ARBX_SCORING_ENABLED=true
# HARD_GATE off by default: flat priors must NOT block emission (no dashboard starvation).
ARBX_SCORING_HARD_GATE=false
# Hypothetical PAPER bankroll for recommended_usd sizing (NOT real capital).
ARBX_KELLY_MAX_CAPITAL_USD=5000
# api-server scored_opportunities archiver: dormant unless 'on' (mirrors ARBX_PAPER_ARCHIVER_MODE).
ARBX_SCORING_ARCHIVER_MODE=off
# A.5 paper-shadow calibration thresholds (dashboard state machine).
ARBX_PAPER_SHADOW_MIN_DAYS=7
ARBX_CALIBRATION_MIN_SCORED=100
ARBX_CALIBRATION_MIN_OBSERVATIONS=30

# ------------------ Simulation (required in S4) ------------------
ANVIL_FORK_URL=
TENDERLY_PROJECT=
TENDERLY_API_KEY=

# ------------------ Flashbots / Relays (required in S5) ------------------
# Private key WITH NO FUNDS at S1. Used only to sign bundles.
FLASHBOTS_SIGNER_KEY=
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
BLOXROUTE_AUTH=
EDEN_AUTH=

# ------------------ Auth / Admin tokens ------------------
# SECURE_BOOT validator (audit C1, 2026-05-10) refuses to start the
# api-server if these are empty, listed placeholders, or shorter than
# 32 bytes. Generate fresh values with:
#   openssl rand -base64 48
# DO NOT use REPLACE_ME or any literal hint — those are explicitly blocked.
#
# Internal, service-to-service. Rotate on every deploy.
ARBX_EDGE_TOKEN=<run: openssl rand -base64 48>
# Admin endpoints: killswitch, config. Keep separate from edge token.
ARBX_ADMIN_TOKEN=<run: openssl rand -base64 48>
# OMEGA-8/M3 P0-1: inter-service POSTs (searcher-rs, recon, relays-client →
# api-server). Used by POST /api/system/runtime-ack. Keep DISTINCT from admin
# and edge tokens; rotating it does not impact operators or the edge worker.
ARBX_SERVICE_TOKEN=<run: openssl rand -base64 48>
# OMEGA-8/M3 P0-1: per-IP rate limits on /api/system/runtime-ack
# Defaults: POST 120/min, GET 30/min. Override per environment.
RUNTIME_ACK_POST_RATE_WINDOW_MS=60000
RUNTIME_ACK_POST_RATE_MAX=120
RUNTIME_ACK_GET_RATE_WINDOW_MS=60000
RUNTIME_ACK_GET_RATE_MAX=30
# JWT for frontend → edge authentication.
JWT_SECRET=<run: openssl rand -base64 64>
JWT_ISSUER=arbitragex-v2
JWT_AUDIENCE=arbitragex-frontend

# ------------------ External safety APIs (S3) ------------------
GOPLUS_API_KEY=
HONEYPOT_IS_API_KEY=

# ------------------ Observability ------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_LOCAL_DEV_ONLY
# Public Grafana URL (used for OAuth redirects, share links). Set to the
# external https URL in production; falls back to localhost for local dev.
GRAFANA_ROOT_URL=http://localhost:3000
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090

# ------------------ Service control plane (start/stop containers) ------------------
# Frontend ServiceControlPanel buttons dispatch start/stop to managed services.
# Wired via a least-privilege socket-proxy sidecar (api-server NEVER mounts the
# raw docker socket). Admin-gated + allowlisted + audit-logged.
#
# OFF by default — shadow/paper systems stay safe until the operator opts in.
# While off, the endpoint returns 501 (fail-honest); the panel surfaces a toast.
ARBX_SERVICE_CONTROL=off
# Comma-separated allowlist of controllable compose service names. Anything not
# listed is rejected with 400 (service_not_controllable).
ARBX_SERVICE_CONTROL_ALLOWLIST=searcher-rs,sim-ctl,relays-client,recon,token-enricher
# Internal URL of the socket-proxy sidecar (arbx-net only, no host port).
DOCKER_PROXY_URL=http://socket-proxy:2375
# Host docker group gid — required so the nonroot socket-proxy can read the
# socket. Run on the VPS: getent group docker | cut -d: -f3
DOCKER_GID=998

# ------------------ Stage 2a: drift-tracker (Y-oracle, §IV motor enabler) -----
# Resolves paper_trade_runs.actual_* by re-executing paper opportunities via
# sim-ctl at the settled block (sim_block_number+1). Produces the realized-Y
# labels Stage 2b calibration needs. OFF by default — enable only once sim-ctl +
# the settled-block fork are confirmed working.
ARBX_DRIFT_TRACKER_MODE=off
ARBX_DRIFT_TRACKER_INTERVAL_SECS=30
ARBX_DRIFT_TRACKER_BATCH=20
ARBX_DRIFT_TRACKER_SETTLE_LEAD_SECS=15
SIMCTL_URL=http://sim-ctl:3003
