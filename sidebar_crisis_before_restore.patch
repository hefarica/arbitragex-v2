+
+/* ============ MOCKUP EXACT CLASSES ============ */
+
+/* Aurora backdrop animation */
+@keyframes drift {
+  0%   { transform: translate3d(0%,0%,0) scale(1); }
+  25%  { transform: translate3d(6%,-4%,0) scale(1.09); }
+  50%  { transform: translate3d(-5%,5%,0) scale(1.13); }
+  75%  { transform: translate3d(5%,3%,0) scale(1.07); }
+  100% { transform: translate3d(0%,0%,0) scale(1); }
+}
+
+/* Film grain overlay */
+.grain {
+  position: fixed; inset: 0; z-index: 50; pointer-events: none;
+  opacity: var(--grain-opacity); mix-blend-mode: overlay;
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.45'/></svg>");
+  transition: opacity 320ms var(--ease-expo);
+}
+
+/* Ticker animation */
+@keyframes tick {
+  from { transform: translateX(0); }
+  to { transform: translateX(-50%); }
+}
+
+/* Shimmer effect */
+@keyframes shine {
+  0%, 80% { transform: translateX(-120%); }
+  100% { transform: translateX(120%); }
+}
+
+/* Character reveal animation */
+@keyframes charIn {
+  from {
+    opacity: 0;
+    transform: translateY(110%) rotateX(-90deg);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0) rotateX(0);
+  }
+}
+
+/* Latency pulse */
+@keyframes latpulse {
+  0%, 100% { opacity: 1; transform: scale(1); }
+  50% { opacity: .5; transform: scale(.82); }
+}
+
+/* Sphere aura */
+.sphere-aura {
+  position: absolute; right: -120px; top: -80px; width: 540px; height: 540px;
+  pointer-events: none; z-index: 0;
+  background: radial-gradient(circle at 60% 40%, color-mix(in oklab, var(--primary) 22%, transparent), transparent 65%);
+  filter: blur(20px);
+}
+
+/* Character animation class */
+.char {
+  display: inline-block;
+  opacity: 0;
+  transform: translateY(110%) rotateX(-90deg);
+  animation: charIn 520ms var(--ease-sharp) forwards;
+}
+
+/* Shimmer overlay */
+.shimmer {
+  position: absolute; inset: 0; pointer-events: none;
+  background: linear-gradient(115deg, transparent 30%, color-mix(in oklab, var(--fg) 14%, transparent) 50%, transparent 70%);
+  transform: translateX(-120%);
+  animation: shine 3.4s var(--ease-sharp) 1.2s infinite;
+}
+
+/* Stat card styling */
+.stat-card {
+  padding: 22px 24px;
+  background: var(--card);
+  backdrop-filter: blur(14px) saturate(1.4);
+  -webkit-backdrop-filter: blur(14px) saturate(1.4);
+  border: 1px solid transparent;
+  border-radius: 10px;
+  box-shadow: var(--hairline), var(--shadow);
+  position: relative;
+  overflow: hidden;
+  transition: background 320ms var(--ease-expo);
+}
+
+/* X-ray panel for cards */
+.xray-panel {
+  position: absolute; left: 0; right: 0; bottom: 0;
+  padding: 18px 22px 20px;
+  background: linear-gradient(180deg, transparent, var(--xray-bg));
+  backdrop-filter: blur(6px);
+  clip-path: inset(100% 0 0 0);
+  transition: clip-path 320ms var(--ease-sharp);
+}
+
+/* Opportunity card hover - show x-ray panel */
+.opp-card:hover .xray-panel {
+  clip-path: inset(0 0 0 0);
+}
+
+.opp-card:hover > div:first-child {
+  opacity: 0.35;
+}
+
+/* Data label - Space Mono uppercase */
+.data-label {
+  font-family: var(--font-mono);
+  font-size: 10.5px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+/* Typography classes from template - Unified modern sans-serif (Inter/SF Pro style) */
+
+/* Base font stack for the entire DAPP */
+body {
+  font-family: var(--font-sans);
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
