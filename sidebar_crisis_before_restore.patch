+
+/* Small text - Captions, hints */
+.font-small {
+  font-family: var(--font-sans);
+  font-size: 12px;
+  font-weight: 400;
+  line-height: 1.4;
+}
+
+/* Button text */
+.font-button {
+  font-family: var(--font-sans);
+  font-size: 13px;
+  font-weight: 600;
+  letter-spacing: 0.01em;
+}
+
+/* Card title */
+.font-card-title {
+  font-family: var(--font-sans);
+  font-size: 15px;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+/* Data value - Numbers, addresses */
+.font-data {
+  font-family: var(--font-mono);
+  font-size: 13px;
+  font-weight: 400;
+  letter-spacing: 0;
+}
+
+/* Liquid Glass Design System */
+
+/* Base glass effect */
+.liquid-glass {
+  background: linear-gradient(
+    135deg,
+    color-mix(in oklab, var(--card) 60%, transparent),
+    color-mix(in oklab, var(--card) 30%, transparent)
+  );
+  backdrop-filter: blur(20px) saturate(1.5);
+  -webkit-backdrop-filter: blur(20px) saturate(1.5);
+  border: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
+  box-shadow:
+    0 8px 32px color-mix(in oklab, var(--fg) 5%, transparent),
+    inset 0 1px 0 color-mix(in oklab, var(--fg) 8%, transparent);
+}
+
+/* Premium glass with stronger blur */
+.liquid-glass-premium {
+  background: linear-gradient(
+    180deg,
+    color-mix(in oklab, var(--card) 70%, transparent),
+    color-mix(in oklab, var(--card) 40%, transparent)
+  );
+  backdrop-filter: blur(24px) saturate(1.8);
+  -webkit-backdrop-filter: blur(24px) saturate(1.8);
+  border: 1px solid color-mix(in oklab, var(--primary) 15%, transparent);
+  box-shadow:
+    0 12px 40px color-mix(in oklab, var(--primary) 8%, transparent),
+    inset 0 1px 0 color-mix(in oklab, var(--fg) 10%, transparent);
+}
+
+/* Glass panel for cards */
+.liquid-glass-panel {
+  background: color-mix(in oklab, var(--card) 50%, transparent);
+  backdrop-filter: blur(16px) saturate(1.4);
+  -webkit-backdrop-filter: blur(16px) saturate(1.4);
+  border: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
+  border-radius: 12px;
+  box-shadow:
+    0 4px 24px color-mix(in oklab, var(--fg) 4%, transparent),
+    inset 0 1px 0 color-mix(in oklab, var(--fg) 6%, transparent);
+  transition: all 0.3s var(--ease-expo);
+}
+
+.liquid-glass-panel:hover {
+  background: color-mix(in oklab, var(--card) 65%, transparent);
+  border-color: color-mix(in oklab, var(--primary) 25%, transparent);
+  box-shadow:
+    0 8px 32px color-mix(in oklab, var(--primary) 12%, transparent),
+    inset 0 1px 0 color-mix(in oklab, var(--fg) 8%, transparent);
+  transform: translateY(-2px);
+}
+
+/* Sidebar liquid glass */
+.liquid-glass-sidebar {
+  background: linear-gradient(
+    180deg,
+    color-mix(in oklab, var(--sidebar) 80%, transparent),
+    color-mix(in oklab, var(--sidebar) 50%, transparent)
+  );
+  backdrop-filter: blur(20px) saturate(1.6);
+  -webkit-backdrop-filter: blur(20px) saturate(1.6);
+  border-right: 1px solid color-mix(in oklab, var(--border) 30%, transparent);
+}
+
+/* Header liquid glass */
+.liquid-glass-header {
+  background: linear-gradient(
+    180deg,
+    color-mix(in oklab, var(--header-bg) 90%, transparent),
+    color-mix(in oklab, var(--header-bg) 60%, transparent)
+  );
+  backdrop-filter: blur(16px) saturate(1.4);
+  -webkit-backdrop-filter: blur(16px) saturate(1.4);
+  border-bottom: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
+}
+
+/* Reflection effect */
+.liquid-glass-reflection {
+  position: relative;
+  overflow: hidden;
+}
+
+.liquid-glass-reflection::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 1px;
+  background: linear-gradient(
+    90deg,
+    transparent,
+    color-mix(in oklab, var(--fg) 20%, transparent),
+    transparent
+  );
+}
+
+/* Active state with glow */
+.liquid-glass-active {
+  background: linear-gradient(
+    135deg,
+    color-mix(in oklab, var(--primary) 15%, transparent),
+    color-mix(in oklab, var(--card) 50%, transparent)
+  );
+  border-color: color-mix(in oklab, var(--primary) 30%, transparent);
+  box-shadow:
+    0 0 20px color-mix(in oklab, var(--primary) 15%, transparent),
+    inset 0 1px 0 color-mix(in oklab, var(--primary) 20%, transparent);
+}
+
+/* Morphing accordion effect */
+.accordion-morph {
+  transition: all 0.4s var(--ease-expo);
+}
+
+.accordion-morph:hover {
+  background: color-mix(in oklab, var(--sidebar-accent) 60%, transparent);
+}
+
+/* Microinteractions */
+.micro-glow {
+  transition: all 0.2s var(--ease-sharp);
+}
+
+.micro-glow:hover {
+  box-shadow: 0 0 12px color-mix(in oklab, var(--primary) 25%, transparent);
+}
+
+.micro-lift {
+  transition: transform 0.2s var(--ease-expo);
+}
+
+.micro-lift:hover {
+  transform: translateY(-1px);
+}
+
+/* Premium blue accent */
+.premium-blue {
+  color: oklch(0.65 0.18 250);
+}
+
+.premium-blue-glow {
+  text-shadow: 0 0 20px oklch(0.65 0.18 250 / 0.5);
+}
+
+/* Ticker styling */
+.ticker {
+  position: fixed; bottom: 0; left: 0; right: 0; z-index: 40;
+  border-top: 1px solid var(--border);
+  background: var(--ticker-bg);
+  backdrop-filter: blur(12px) saturate(1.4);
+  -webkit-backdrop-filter: blur(12px) saturate(1.4);
+  overflow: hidden;
+}
+.ticker-track {
+  display: inline-flex; align-items: center; gap: 2.5rem;
+  padding: 16px 0; white-space: nowrap;
+  animation: tick 60s linear infinite;
+}
+.ticker:hover .ticker-track {
+  animation-play-state: paused;
+}
+
+/* Header bar styling */
+.header-bar {
+  position: sticky; top: 0; z-index: 39;
+  display: flex; align-items: center; gap: 1.5rem;
+  padding: 18px 40px;
+  background: var(--header-bg);
+  backdrop-filter: blur(14px) saturate(1.3);
+  -webkit-backdrop-filter: blur(14px) saturate(1.3);
+  border-bottom: 1px solid var(--border);
+}
+
+/* Hero section */
+.hero {
+  margin-bottom: 56px;
+  max-width: 980px;
+}
+.hero h1 {
+  font-weight: 600;
+  font-size: clamp(2.4rem, 4.6vw, 4rem);
+  line-height: 1.03;
+  letter-spacing: -0.04em;
+  margin-bottom: 1.5rem;
+}
+.hero h1 .lex {
+  color: var(--primary-2);
+}
+
+/* Opportunity cards grid */
+.opps-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 18px;
+}
+@media (max-width: 1100px) {
+  .opps-grid { grid-template-columns: repeat(2, 1fr); }
+}
+@media (max-width: 768px) {
+  .opps-grid { grid-template-columns: 1fr; }
+}
