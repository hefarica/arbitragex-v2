{
  "ci": {
    "collect": {
      "url": [
        "${LHCI_BASE_URL:-http://localhost:3000}/",
        "${LHCI_BASE_URL:-http://localhost:3000}/status",
        "${LHCI_BASE_URL:-http://localhost:3000}/opportunities",
        "${LHCI_BASE_URL:-http://localhost:3000}/risk"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless",
        "emulatedFormFactor": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.75 }],
        "categories:seo": ["warn", { "minScore": 0.70 }],
        "interactive": ["error", { "maxNumericValue": 8000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
