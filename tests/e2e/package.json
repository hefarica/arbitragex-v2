{
  "name": "@arbx/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "ArbitrageX v2 end-to-end tests (Playwright against the docker compose stack).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test smoke.spec.ts",
    "test:hotpath": "playwright test hot-path-pipeline.spec.ts",
    "test:hotpath:headed": "playwright test hot-path-pipeline.spec.ts --headed",
    "test:live": "playwright test --config=playwright.live.config.ts functional-live admin-gate-live honest-state-live",
    "test:live:all": "playwright test --config=playwright.live.config.ts",
    "test:live:functional": "playwright test --config=playwright.live.config.ts functional-live",
    "test:live:mutating": "playwright test --config=playwright.live.config.ts admin-mutating-live",
    "install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.4.5",
    "@types/pg": "^8.20.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "pg": "^8.11.5"
  }
}
