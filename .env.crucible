# ============================================================
# OMEGA CRUCIBLE — TESTNET CONFIGURATION
# Fase: Validacion antes de Mainnet
# Redes: Holesky | Arbitrum Sepolia | Polygon Amoy
# ============================================================
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.crucible .env
#   2. Rellenar las claves privadas y direcciones
#   3. NUNCA commitear .env al repositorio (ya esta en .gitignore)
#   4. Source antes de ejecutar: source .env
# ============================================================

# --- CHAIN: Ethereum Holesky (17000) ---
CHAIN_ID_17000=17000
RPC_HTTP_17000=https://ethereum-holesky.publicnode.com
RPC_WS_17000=wss://ethereum-holesky.publicnode.com
EXPLORER_17000=https://holesky.etherscan.io

# --- CHAIN: Arbitrum Sepolia (421614) ---
CHAIN_ID_421614=421614
RPC_HTTP_421614=https://sepolia-rollup.arbitrum.io/rpc
RPC_WS_421614=wss://sepolia-rollup.arbitrum.io/rpc
EXPLORER_421614=https://sepolia.arbiscan.io

# --- CHAIN: Polygon Amoy (80002) ---
CHAIN_ID_80002=80002
RPC_HTTP_80002=https://rpc-amoy.polygon.technology
RPC_WS_80002=wss://rpc-amoy.polygon.technology
EXPLORER_80002=https://amoy.polygonscan.com

# --- RPC ALTERNATIVOS (fallback si los principales fallan) ---
# Holesky alternativo: https://1rpc.io/holesky
# Arbitrum Sepolia alt: https://arbitrum-sepolia.blockpi.network/v1/rpc/public
# Polygon Amoy alt: https://polygon-amoy-bor-rpc.publicnode.com

# --- FAUCETS ---
# Holesky ETH    : https://holesky-faucet.pk910.de/ (mining faucet)
#                : https://www.holeskyfaucet.io/
#                : https://cloud.google.com/application/web3/faucet/ethereum/holesky
# Arbitrum Sepolia: https://faucet.quicknode.com/arbitrum/sepolia
#                : https://www.l2faucet.com/arbitrum
#                : https://bridge.arbitrum.io/?destinationChain=arbitrum-sepolia&sourceChain=sepolia
# Polygon Amoy MATIC: https://faucet.polygon.technology/
#                  : https://faucet.circle.com/
#                  : https://www.alchemy.com/faucets/polygon-amoy

# --- WALLETS (testnet only — low security) ---
# Generar wallets: cast wallet new --number 3
# O usar: cast wallet vanity --starts-with 0xC0

# GAS_SPONSOR: Paga gas para todos los deploys y transacciones
# Requiere: ~0.5 ETH/MATIC por testnet para deploy completo
# Fundar via faucet ANTES de ejecutar cualquier deploy
GAS_SPONSOR_PRIVATE_KEY=0xCHANGE_ME        # <--- REEMPLAZAR: clave privada del gas sponsor
GAS_SPONSOR_ADDRESS=0xCHANGE_ME            # <--- REEMPLAZAR: direccion del gas sponsor

# EXECUTION_SIGNER: Firma transacciones de ejecucion (NUNCA debe tener fondos)
# Balance esperado: 0 siempre. Es una clave de firma pura.
EXECUTION_SIGNER_PRIVATE_KEY=0xCHANGE_ME   # <--- REEMPLAZAR
EXECUTION_SIGNER_ADDRESS=0xCHANGE_ME       # <--- REEMPLAZAR

# COLD_TREASURY: Recibe yield y ganancias (multisig o hardware wallet)
# En testnet puede ser la misma que GAS_SPONSOR o una wallet separada
COLD_TREASURY_ADDRESS=0xCHANGE_ME          # <--- REEMPLAZAR

# --- EXPLORER API KEYS (para verificacion de contratos) ---
# Obtener API keys gratis en:
#   ETHERSCAN:  https://etherscan.io/apis
#   ARBISCAN:   https://arbiscan.io/apis
#   POLYGONSCAN: https://polygonscan.com/apis
ETHERSCAN_API_KEY=CHANGE_ME       # holesky.etherscan.io
ARBISCAN_API_KEY=CHANGE_ME        # sepolia.arbiscan.io
POLYGONSCAN_API_KEY=CHANGE_ME     # amoy.polygonscan.com

# --- ADAPTER ADDRESSES (testnet routers/vaults) ---
# Estas direcciones son necesarias para desplegar los adapters.
# Se obtienen de la documentacion oficial de cada protocolo.

# Uniswap V2 Routers (testnet)
HOLESKY_V2_ROUTER=0x0000000000000000000000000000000000000000      # No hay Uniswap V2 oficial en Holesky
ARBITRUM_SEPOLIA_V2_ROUTER=0x1b02dA8Cb0d097eB8D57A175b88c7D8b47997506  # SushiSwap V2 on Arbitrum Sepolia
AMOY_V2_ROUTER=0x0000000000000000000000000000000000000000      # No hay V2 oficial en Amoy

# Uniswap V3 Routers (testnet)
HOLESKY_V3_ROUTER=0x0000000000000000000000000000000000000000      # No hay Uniswap V3 oficial en Holesky
ARBITRUM_SEPOLIA_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564  # Uniswap V3 on Arbitrum Sepolia
AMOY_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564      # Uniswap V3 on Amoy

# Balancer Vaults (testnet)
HOLESKY_BALANCER_VAULT=0x0000000000000000000000000000000000000000     # No Balancer en Holesky
ARBITRUM_SEPOLIA_BALANCER_VAULT=0x0000000000000000000000000000000000000000  # No Balancer en Arbitrum Sepolia
AMOY_BALANCER_VAULT=0x0000000000000000000000000000000000000000     # No Balancer en Amoy

# --- GAS CONFIGURATION ---
# Testnets tienen gas barato, podemos usar defaults
# Para Arbitrum Sepolia: el gas se paga en ETH de Sepolia (bridge requerido)
# Para Polygon Amoy: el gas se paga en MATIC de testnet

# --- FORGE CONFIG ---
# Estas variables son leidas automaticamente por foundry.toml
HOLESKY_RPC_URL=https://ethereum-holesky.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
