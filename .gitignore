# ArbitrageX v2 — .gitignore
# Never commit secrets, local data, or build artifacts.

# Secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.jks
*.p12
*.pfx
signer.txt

# Rust
target/
**/*.rs.bk
Cargo.lock
# Workspace root lockfile — REQUIRED to be tracked because the searcher-rs
# Dockerfile builds with `--locked --frozen` (offline mode). Untracking it
# regresses the build — see commit 621776a context. Per audit 2026-05-10
# M5, this is the ONLY Cargo.lock exception — non-workspace crates do not
# have standalone tracked locks.
!/backend/Cargo.lock

# Node / TS
node_modules/
dist/
build/
.next/
.turbo/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cloudflare
.wrangler/
.dev.vars
wrangler.toml.local

# Python (tools)
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/
!.vscode/settings.json.example
*.swp

# Local data
data/
logs/
tmp/
*.sqlite
*.db

# Playwright
tests/e2e/node_modules/
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/.playwright-cache/

# Docker
docker-compose.override.yml
