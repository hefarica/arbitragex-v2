{
  "mode": "READ_ONLY",
  "repository_existing_path_modified": false,
  "vps_mutations_allowed": false,
  "database_mutations_allowed": false,
  "docker_mutations_allowed": false,
  "secrets_read": false,
  "remote_command_allowlist": [
    "cat /etc/os-release",
    "uname",
    "uptime",
    "df",
    "free",
    "git rev-parse",
    "git branch --show-current",
    "git status --porcelain",
    "docker version",
    "docker compose version",
    "docker ps -a",
    "docker network ls",
    "docker volume ls",
    "docker inspect --format",
    "docker image inspect --format",
    "sha256sum"
  ],
  "remote_command_deny_tokens": [
    " rm ",
    " mv ",
    " cp ",
    " chmod ",
    " chown ",
    " docker stop",
    " docker restart",
    " docker rm",
    " docker compose up",
    " docker compose down",
    " git pull",
    " git checkout",
    " git reset",
    " git clean",
    " git merge",
    " systemctl restart",
    " systemctl stop",
    " apt ",
    " yum ",
    " dnf ",
    " sed -i",
    " psql -c",
    " redis-cli set",
    " redis-cli del"
  ],
  "cloned_to_isolated_workspace": false
}
