+    // --- SSOT v4 (t9 alpha2): 01_SSOT invariants --------------------------------
+    #[test]
+    fn ssot_v4_detector_table_matches_ssot() {
+        assert_eq!(SSOT_V4_DETECTOR_POLICIES.len(), 60);
+        let total: u32 = SSOT_V4_DETECTOR_POLICIES
+            .iter()
+            .map(|p| p.strategy_count as u32)
+            .sum();
+        assert_eq!(total, 264, "SSOT strategies must sum 264");
+        let d: Vec<&SsotDetectorPolicy> = SSOT_V4_DETECTOR_POLICIES
+            .iter()
+            .filter(|p| p.family == "D_")
+            .collect();
+        assert_eq!(d.len(), 5, "D_ family has 5 detectors");
+        assert!(
+            d.iter().all(|p| p.strategy_count == 6),
+            "each D_ detector carries 6 strategies"
+        );
+    }
+
+    #[test]
+    fn dfac_fix_is_materialized() {
+        assert_eq!(dfac("D_"), 0.80, "FIX: DFAC[D_]=0.80 (workbook LEEME/F04)");
+        assert_eq!(dfac("R_"), 1.0);
+        assert_eq!(dfac("CF_"), 1.0);
+        assert_eq!(dfac("OBSERVE"), 1.0);
+        assert_eq!(dfac("unknown_family"), 1.0, "neutral for unknown families");
+        assert_eq!(DFAC_D_UNDERSCORE, 0.8);
+    }
