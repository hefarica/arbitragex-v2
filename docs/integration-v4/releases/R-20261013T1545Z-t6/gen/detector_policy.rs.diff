+/// DFAC - Detector-Family Admission Coefficient (SSOT v4).
+///
+/// Materializes the generator fix recorded in the v4 workbook: sheet LEEME
+/// "FIX: DFAC[D_]=0.80 -> DERIVATIVES con positivos" and sheet F04 row D_
+/// ("D_ Derivados (fix DFAC D_=0.80) 5 30", BASE 1982 -> IMP 3560). Before
+/// the fix the derivatives family emitted zero positives; after it the
+/// workbook INVARIANTES sheet reports DERIV_POS>0 == 1982 (OK).
+pub const DFAC_D_UNDERSCORE: f64 = 0.80;
+
+/// DFAC by family (SSOT v4): 0.80 for `D_` (derivatives fix), 1.0 (neutral)
+/// for every other family and for unknown families - the coefficient never
+/// silently zeroes a family it does not know.
+pub fn dfac(family: &str) -> f64 {
+    if family == "D_" {
+        DFAC_D_UNDERSCORE
+    } else {
+        1.0
+    }
+}
