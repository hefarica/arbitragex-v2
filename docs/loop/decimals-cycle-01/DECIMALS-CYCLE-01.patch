+            Some(d) => {
+                map.insert(lc, *d);
+            }
+            None => {
+                if !unresolved.contains(&lc) {
+                    unresolved.push(lc);
+                }
+            }
+        }
+    }
+    CycleDecimals {
+        map: shared_rs::candidates::DecimalsMap { map },
+        unresolved,
