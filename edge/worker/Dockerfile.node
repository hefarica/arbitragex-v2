# WO-13 (2026-09-06): CANONICAL production edge entrypoint (compose.prod.yml
# `edge` service). Builds the Hono worker (@arbx/edge-worker — byte-identical
# to the Cloudflare deploy) and serves it under Node via @hono/node-server
# (CMD dist/node-server.js). NOT "dev-local": the Express DEV-ONLY shim lives
# at edge/dev-local/Dockerfile and is wired only in compose.dev.yml.
FROM node:20-bookworm-slim AS builder
WORKDIR /build
COPY package.json ./
COPY shared-ts ./shared-ts
COPY edge/worker ./edge/worker
RUN npm install --workspaces --include-workspace-root --silent
RUN npm run -w @arbx/shared build \
 && npm run -w @arbx/edge-worker build

FROM node:20-bookworm-slim AS runtime
WORKDIR /app
RUN sed -i "s|http://deb.debian.org|http://ftp.de.debian.org|g" /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list 2>/dev/null; for i in 1 2 3 4 5; do apt-get update && break || sleep 8; done && apt-get install -y --no-install-recommends tini ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r arbx && useradd -r -g arbx arbx
COPY --from=builder /build/node_modules /app/node_modules
COPY --from=builder /build/shared-ts/dist /app/shared-ts/dist
COPY --from=builder /build/shared-ts/package.json /app/shared-ts/package.json
COPY --from=builder /build/edge/worker/dist /app/edge/worker/dist
COPY --from=builder /build/edge/worker/package.json /app/edge/worker/package.json
COPY configs /app/configs
USER arbx
ENV ARBX_CONFIG_PATH=/app/configs/app.toml
EXPOSE 8787
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","/app/edge/worker/dist/node-server.js"]
